<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-slate-50 text-slate-900">
    <.main_header step={:login} />
    <main class="pt-[80px] md:pt-[100px] pb-12">
      <div class="mx-auto max-w-7xl px-6">
        <div class="flex flex-col items-center justify-start min-h-[calc(100vh-140px)] py-8">
          <div class="w-full max-w-lg">
            <div class="text-center mb-8">
              <div class="w-16 h-16 bg-gradient-to-br from-[#FF4C00] to-[#FF8C00] rounded-2xl flex items-center justify-center text-white text-3xl font-black mx-auto mb-5 shadow-xl shadow-orange-500/10 animate-fade-in-up">
                <span class="material-symbols-outlined !text-3xl">person_add</span>
              </div>

              <h1 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tighter">
                Elevate Your Journey
              </h1>

              <p class="text-xs font-bold text-slate-400 mt-1 tracking-wide">
                Create your Komiuta account in seconds.
              </p>
            </div>

            <div class="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100">
              <a
                href="/auth/google"
                class="flex items-center justify-center gap-3 w-full bg-white border-2 border-slate-100 py-3.5 rounded-xl font-black text-slate-700 hover:bg-slate-50 transition-all shadow-sm group active:scale-95"
              >
                <img
                  src="https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png"
                  class="w-5 h-5"
                  alt="Google"
                  width="20"
                  height="20"
                  decoding="async"
                />
                <span class="text-sm tracking-tight">Sign up with Gmail</span>
              </a>

              <div class="relative my-6">
                <div class="absolute inset-0 flex items-center">
                  <div class="w-full border-t border-slate-100"></div>
                </div>
                <div class="relative flex justify-center text-[9px] uppercase font-black tracking-widest">
                  <span class="bg-white px-4 text-slate-400">or continue with</span>
                </div>
              </div>

              <form action={~p"/user/register"} method="post" class="space-y-5">
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  <div class="md:col-span-2">
                    <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Full Name</label>
                    <input
                      type="text"
                      name="user[name]"
                      placeholder="Enter your full name"
                      class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-[#FF4C00] transition outline-none"
                      required
                    />
                  </div>

                  <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Phone Number</label>
                    <input
                      type="tel"
                      name="user[phone]"
                      placeholder="07XX XXX XXX"
                      class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-[#FF4C00] transition outline-none"
                      required
                    />
                  </div>

                  <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Email Address</label>
                    <input
                      type="email"
                      name="user[email]"
                      placeholder="you@example.com"
                      class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-[#FF4C00] transition outline-none"
                      required
                    />
                  </div>

                  <div class="md:col-span-2">
                    <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Referral Code (Optional)</label>
                    <div class="relative">
                      <input
                        type="text"
                        name="user[referral_code]"
                        placeholder="Got a friend's code?"
                        class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-[#FF4C00] transition outline-none uppercase tracking-widest"
                      />
                      <span class="absolute right-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-orange-500 !text-xl">redeem</span>
                    </div>
                  </div>
                </div>

                <div class="pt-2">
                  <button
                    type="submit"
                    class="w-full bg-[#FF4C00] text-white py-4 rounded-xl font-black text-sm uppercase tracking-widest hover:bg-[#E64400] transition shadow-lg shadow-orange-200 transform active:scale-95"
                  >
                    Create Account
                  </button>
                </div>
              </form>
            </div>

            <p class="text-center mt-6 text-sm font-bold text-slate-400">
              Already have an account?
              <a href={~p"/user/login"} class="text-[#FF4C00] hover:underline">Log in here</a>
            </p>

            <div class="mt-8 text-center">
              <p class="text-[9px] font-black text-slate-300 tracking-[0.3em]">
                Secure industrial encryption enabled
              </p>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layouts.app>
