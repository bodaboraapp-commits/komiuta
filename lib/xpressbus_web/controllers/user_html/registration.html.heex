<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-slate-50 text-slate-900">
    <.main_header step={:login} />
    <main class="pt-[80px] md:pt-[100px] pb-12">
      <div class="mx-auto max-w-7xl px-6">
        <div class="flex flex-col items-center justify-start min-h-[calc(100vh-140px)] py-8">
          <div class="w-full max-w-lg">
            <div class="text-center mb-8">
              <div class="w-16 h-16 bg-gradient-to-br from-[#FF4C00] to-[#FF8C00] rounded-2xl flex items-center justify-center text-white text-3xl font-black mx-auto mb-5 shadow-xl shadow-orange-500/10 animate-fade-in-up">
                <span class="material-symbols-outlined !text-3xl">person_add</span>
              </div>

              <h1 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tighter">
                Elevate Your Journey
              </h1>

              <p class="text-xs font-bold text-slate-400 mt-1 tracking-wide">
                Create your Komiuta account in seconds.
              </p>
            </div>

            <div class="bg-white rounded-[2rem] p-8 shadow-sm border border-slate-100">
              <a
                href="/auth/google"
                class="flex items-center justify-center gap-3 w-full bg-white border-2 border-slate-100 py-3.5 rounded-xl font-black text-slate-700 hover:bg-slate-50 transition-all shadow-sm group active:scale-95"
              >
                <img
                  src="https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png"
                  class="w-5 h-5"
                  alt="Google"
                  width="20"
                  height="20"
                  decoding="async"
                />
                <span class="text-sm tracking-tight">Sign up with Gmail</span>
              </a>

              <%= if @firebase_config do %>
                <div class="relative my-6">
                  <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-slate-100"></div>
                  </div>
                  <div class="relative flex justify-center text-[9px] uppercase font-black tracking-widest">
                    <span class="bg-white px-4 text-slate-400">or sign up with SMS</span>
                  </div>
                </div>

                <div
                  id="firebase-sms-auth"
                  data-api-key={@firebase_config.api_key}
                  data-auth-domain={@firebase_config.auth_domain}
                  data-project-id={@firebase_config.project_id}
                  data-storage-bucket={@firebase_config.storage_bucket}
                  data-messaging-sender-id={@firebase_config.messaging_sender_id}
                  data-app-id={@firebase_config.app_id}
                  data-verify-url="/user/firebase/verify-signup"
                  data-redirect="/user/signup"
                >
                  <%!-- This panel verifies the phone; the verified number is then carried into the form below. --%>
                  <form id="firebase-sms-form" class="space-y-4" novalidate>
                    <div id="firebase-phone-step">
                      <input
                        id="firebase-phone"
                        type="tel"
                        inputmode="tel"
                        autocomplete="tel"
                        placeholder="07XX XXX XXX"
                        class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-[#FF4C00] transition outline-none"
                        required
                      />
                      <div id="firebase-recaptcha"></div>
                    </div>

                    <button
                      id="firebase-send-code"
                      type="submit"
                      class="w-full bg-slate-900 text-white py-3.5 rounded-xl font-black text-xs uppercase tracking-widest hover:bg-black transition active:scale-95"
                    >
                      Verify Phone with SMS
                    </button>

                    <div id="firebase-code-step" class="hidden space-y-3">
                      <input
                        id="firebase-code"
                        type="text"
                        inputmode="numeric"
                        autocomplete="one-time-code"
                        pattern="[0-9]{6}"
                        maxlength="6"
                        placeholder="000000"
                        class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-xl font-black text-center tracking-[0.4em] focus:bg-white focus:border-[#FF4C00] transition outline-none"
                      />
                      <button
                        id="firebase-verify-code"
                        type="submit"
                        class="w-full bg-[#FF4C00] text-white py-3.5 rounded-xl font-black text-xs uppercase tracking-widest hover:bg-[#E64400] transition active:scale-95"
                      >
                        Verify &amp; Continue
                      </button>
                      <button
                        id="firebase-change-number"
                        type="button"
                        class="w-full text-[10px] font-black uppercase tracking-widest text-slate-400 hover:text-[#FF4C00]"
                      >
                        Use a different number
                      </button>
                    </div>

                    <p
                      id="firebase-status"
                      class="min-h-[16px] text-[11px] font-bold text-slate-500"
                      role="status"
                      aria-live="polite"
                    >
                    </p>
                  </form>

                  <script
                    defer
                    phx-track-static
                    type="text/javascript"
                    src={~p"/assets/js/firebase_phone_auth.js"}
                  >
                  </script>
                </div>
              <% end %>

              <%= if @verified_phone do %>
                <div class="mt-5 rounded-xl border border-emerald-100 bg-emerald-50 px-4 py-3 text-[11px] font-bold text-emerald-700">
                  Phone <span class="font-black">{@verified_phone}</span>
                  is verified. Finish your name and email below.
                </div>
              <% end %>

              <div class="relative my-6">
                <div class="absolute inset-0 flex items-center">
                  <div class="w-full border-t border-slate-100"></div>
                </div>
                <div class="relative flex justify-center text-[9px] uppercase font-black tracking-widest">
                  <span class="bg-white px-4 text-slate-400">or continue with</span>
                </div>
              </div>

              <form action={~p"/user/register"} method="post" class="space-y-5">
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  <div class="md:col-span-2">
                    <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Full Name</label>
                    <input
                      type="text"
                      name="user[name]"
                      placeholder="Enter your full name"
                      class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-[#FF4C00] transition outline-none"
                      required
                    />
                  </div>

                  <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Phone Number</label>
                    <input
                      type="tel"
                      name="user[phone]"
                      value={@phone}
                      readonly={@verified_phone}
                      placeholder="07XX XXX XXX"
                      class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-[#FF4C00] transition outline-none read-only:text-slate-500"
                      required
                    />
                  </div>

                  <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Email Address</label>
                    <input
                      type="email"
                      name="user[email]"
                      placeholder="you@example.com"
                      class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-[#FF4C00] transition outline-none"
                      required
                    />
                  </div>

                  <div class="md:col-span-2">
                    <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Referral Code (Optional)</label>
                    <div class="relative">
                      <input
                        type="text"
                        name="user[referral_code]"
                        placeholder="Got a friend's code?"
                        class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-[#FF4C00] transition outline-none uppercase tracking-widest"
                      />
                      <span class="absolute right-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-orange-500 !text-xl">redeem</span>
                    </div>
                  </div>
                </div>

                <div class="pt-2">
                  <button
                    type="submit"
                    class="w-full bg-[#FF4C00] text-white py-4 rounded-xl font-black text-sm uppercase tracking-widest hover:bg-[#E64400] transition shadow-lg shadow-orange-200 transform active:scale-95"
                  >
                    Create Account
                  </button>
                </div>
              </form>
            </div>

            <p class="text-center mt-6 text-sm font-bold text-slate-400">
              Already have an account?
              <a href={~p"/user/login"} class="text-[#FF4C00] hover:underline">Log in here</a>
            </p>

            <div class="mt-8 text-center">
              <p class="text-[9px] font-black text-slate-300 tracking-[0.3em]">
                Secure industrial encryption enabled
              </p>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layouts.app>
