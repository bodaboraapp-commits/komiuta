<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-[#f8fafc] font-sans text-slate-900">
    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="/agent" class="flex items-center gap-3">
          <img
            src="/images/logo_brand.png"
            alt="KOMIUTA"
            width="146"
            height="40"
            class="h-9 w-auto"
          /> <span class="hidden h-8 w-px bg-slate-200 sm:block"></span>
          <span class="hidden text-[10px] font-black uppercase tracking-[0.3em] text-[#FF4C00] sm:block">
            Agent App
          </span>
        </a>

        <a
          href="/agent/logout"
          class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-500 transition hover:border-slate-300"
        >
          Log out
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-md px-5 py-12 md:py-20">
      <div class="rounded-[2rem] border border-slate-100 bg-white p-6 shadow-xl shadow-slate-900/5 md:p-8">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-50 text-[#FF4C00]">
          <span class="material-symbols-outlined !text-2xl">mail</span>
        </div>

        <p class="mt-5 text-[10px] font-black uppercase tracking-[0.3em] text-[#FF4C00]">
          One last step
        </p>

        <h1 class="mt-1.5 text-2xl font-black tracking-tight">Verify your email</h1>

        <p class="mt-2 text-xs font-bold leading-relaxed text-slate-400">
          Confirm the email address on your KOMIUTA Agent account. We use it for booking updates,
          payout receipts and important account notices.
        </p>

        <form action="/agent/verify-email/send" method="post" class="mt-6 space-y-4">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

          <div>
            <label
              for="agent-verify-email"
              class="mb-1.5 block text-[10px] font-black uppercase tracking-widest text-slate-500"
            >
              Email address
            </label>
            <input
              id="agent-verify-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              value={@pending_email}
              placeholder="you@example.com"
              required
              class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-sm font-bold outline-none transition focus:border-[#FF4C00] focus:bg-white"
            />
            <p class="mt-2 text-[10px] font-bold leading-relaxed text-slate-400">
              You can correct the address here if it is wrong — we will send the verification code
              to the address you enter.
            </p>
          </div>

          <button
            type="submit"
            class="w-full rounded-xl bg-[#FF4C00] px-6 py-4 text-xs font-black uppercase tracking-[0.2em] text-white shadow-xl shadow-orange-200 transition hover:bg-[#E64400] active:scale-[0.99]"
          >
            Send verification code
          </button>
        </form>

        <%= if @code_sent do %>
          <div class="mt-6 rounded-2xl border border-slate-100 bg-slate-50 p-4">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-500">
              Enter the 6-digit code
            </p>

            <form action="/agent/verify-email/confirm" method="post" class="mt-3 space-y-3">
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

              <input
                name="code"
                type="text"
                inputmode="numeric"
                autocomplete="one-time-code"
                pattern="[0-9]{6}"
                maxlength="6"
                placeholder="123456"
                required
                class="w-full rounded-xl border border-slate-200 bg-white p-3.5 text-center text-2xl font-black tracking-[0.4em] text-slate-900 outline-none transition focus:border-[#FF4C00]"
              />

              <button
                type="submit"
                class="w-full rounded-xl bg-slate-900 px-6 py-3.5 text-[10px] font-black uppercase tracking-[0.2em] text-white transition hover:bg-black active:scale-[0.99]"
              >
                Verify email &amp; continue
              </button>
            </form>

            <form action="/agent/verify-email/send" method="post" class="mt-3 text-center">
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <input type="hidden" name="email" value={@pending_email} />

              <button
                type="submit"
                class="text-[10px] font-black uppercase tracking-widest text-slate-400 transition hover:text-[#FF4C00]"
              >
                Resend code
              </button>
            </form>
          </div>
        <% end %>
      </div>

      <p class="mt-5 text-center text-[11px] font-bold text-slate-400">
        Signed in as <strong>{@agent.phone}</strong>.
      </p>
    </main>

    <footer class="px-5 py-8 text-center text-[10px] font-black uppercase tracking-widest text-slate-400">
      © {DateTime.utc_now().year} KOMIUTA Agent
    </footer>
  </div>
</Layouts.app>
