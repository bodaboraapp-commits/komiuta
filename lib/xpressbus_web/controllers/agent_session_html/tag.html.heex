<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-[#f8fafc] font-sans text-slate-900">
    <header class="no-print sticky top-0 z-40 border-b border-slate-200/70 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-5 py-4">
        <a href="/agent/account" class="flex items-center gap-3">
          <img
            src="/images/logo_brand.png"
            alt="Komiuta"
            width="146"
            height="40"
            class="h-9 w-auto"
          />
          <span class="hidden h-8 w-px bg-slate-200 sm:block"></span>
          <span class="hidden text-[10px] font-black uppercase tracking-[0.3em] text-[#FF4C00] sm:block">
            Agent App
          </span>
        </a>

        <a
          href="/agent/account"
          class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-600 transition hover:border-slate-300"
        >
          Back to account
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-5 py-10 md:py-14">
      <div class="no-print flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-[10px] font-black uppercase tracking-[0.3em] text-[#FF4C00]">
            Verified agent ID
          </p>
          <h1 class="mt-1.5 text-3xl font-black tracking-tight text-slate-900">
            Your printable lanyard tag
          </h1>
          <p class="mt-2 max-w-xl text-xs font-bold leading-relaxed text-slate-500">
            Print this at 100% on cardstock, cut along the border, and clip a lanyard through the
            slot at the top. The QR code proves you are an approved Komiuta agent.
          </p>
        </div>

        <button
          type="button"
          onclick="window.print()"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#FF4C00] px-5 py-3.5 text-[10px] font-black uppercase tracking-widest text-white shadow-lg shadow-orange-200 transition hover:bg-[#E64400] active:scale-[0.99]"
        >
          <span class="material-symbols-outlined !text-base">print</span> Print ID tag
        </button>
      </div>

      <div class="mt-10 flex justify-center print:mt-0">
        <section id="agent-id-tag" class="agent-tag" aria-label="Komiuta verified agent ID tag">
          <div class="agent-tag__slot" aria-hidden="true"></div>
          <p class="agent-tag__slot-label">LANYARD CLIP</p>

          <div class="agent-tag__brand">
            <img src="/images/logo_brand.png" alt="Komiuta" class="agent-tag__logo" />
          </div>

          <div class="agent-tag__verified">
            <span class="agent-tag__check material-symbols-outlined">verified</span>
            <span>VERIFIED AGENT</span>
          </div>

          <div class="agent-tag__avatar" aria-hidden="true">{@initials}</div>

          <h2 class="agent-tag__name">{@agent.full_name}</h2>
          <p class="agent-tag__business">{@agent.business_name}</p>

          <div class="agent-tag__meta">
            <div>
              <span class="agent-tag__meta-label">Agent ref</span>
              <span class="agent-tag__meta-value">{@agent.reference}</span>
            </div>
            <div>
              <span class="agent-tag__meta-label">Base</span>
              <span class="agent-tag__meta-value">{@agent.city}</span>
            </div>
            <div>
              <span class="agent-tag__meta-label">Issued</span>
              <span class="agent-tag__meta-value">
                {Calendar.strftime(@issued_on, "%d %b %Y")}
              </span>
            </div>
          </div>

          <div class="agent-tag__qr">
            {@tag_qr}
            <p>Scan to verify agent</p>
          </div>

          <p class="agent-tag__footer">
            Property of Komiuta · Verify at komiuta.com
          </p>
        </section>
      </div>

      <div class="no-print mt-10 rounded-2xl border border-slate-100 bg-white p-5">
        <h2 class="text-[10px] font-black uppercase tracking-[0.25em] text-slate-400">
          Printing checklist
        </h2>
        <ul class="mt-3 space-y-2 text-xs font-bold leading-relaxed text-slate-500">
          <li class="flex gap-2">
            <span class="text-[#FF4C00]">1.</span> Print at 100% scale on 300gsm cardstock.
          </li>
          <li class="flex gap-2">
            <span class="text-[#FF4C00]">2.</span>
            Cut around the outer border, then punch or cut the lanyard slot at the top.
          </li>
          <li class="flex gap-2">
            <span class="text-[#FF4C00]">3.</span> Laminate the card before attaching the lanyard.
          </li>
          <li class="flex gap-2">
            <span class="text-[#FF4C00]">4.</span>
            Keep the QR code clear — anyone can scan it to confirm your agent status.
          </li>
        </ul>
      </div>
    </main>
  </div>
</Layouts.app>
