<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-[#f8fafc] font-sans text-slate-900">
    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="/agent" class="flex items-center gap-3">
          <img
            src="/images/logo_brand.png"
            alt="Komiuta"
            width="146"
            height="40"
            class="h-9 w-auto"
          /> <span class="hidden h-8 w-px bg-slate-200 sm:block"></span>
          <span class="hidden text-[10px] font-black uppercase tracking-[0.3em] text-[#FF4C00] sm:block">
            Agent App
          </span>
        </a>

        <%= if @agent.status == "approved" do %>
          <a
            href="/agent/dashboard"
            aria-current="page"
            class="inline-flex items-center gap-2 rounded-xl bg-[#FF4C00] px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-white shadow-lg shadow-orange-200 transition hover:bg-[#E64400]"
          >
            <span class="material-symbols-outlined !text-base">dashboard</span>
            Dashboard
          </a>
        <% end %>
      </div>
    </header>

    <main class="mx-auto max-w-2xl px-5 py-12 md:py-16">
      <p class="text-[10px] font-black uppercase tracking-[0.3em] text-[#FF4C00]">
        Agent account
      </p>

      <h1 class="mt-2 text-3xl font-black tracking-tight md:text-4xl">
        Welcome back, {@agent.full_name |> String.split() |> List.first()}
      </h1>

      <p class="mt-3 text-sm font-bold leading-relaxed text-slate-500">
        You are signed in to the KOMIUTA Agent app. Keep this page installed for updates on your
        application and agent account.
      </p>

      <div class="mt-7 rounded-[2rem] border border-slate-100 bg-white p-6 shadow-xl shadow-slate-900/5 md:p-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.25em] text-slate-400">
              Application status
            </p>

            <p class="mt-1 text-lg font-black">{@agent.business_name}</p>
          </div>

          <span class={[
            "rounded-full px-4 py-2 text-[10px] font-black uppercase tracking-widest",
            @agent.status == "approved" && "bg-emerald-50 text-emerald-700",
            @agent.status == "rejected" && "bg-red-50 text-red-600",
            @agent.status == "pending" && "bg-amber-50 text-amber-700"
          ]}>
            {@agent.status}
          </span>
        </div>

        <div class="mt-6 rounded-2xl border border-slate-100 bg-slate-50 p-5">
          <p class="text-[9px] font-black uppercase tracking-[0.25em] text-slate-400">
            Agent reference
          </p>

          <p class="mt-2 text-2xl font-black tracking-wide text-slate-900">{@agent.reference}</p>
        </div>

        <%= cond do %>
          <% @agent.status == "approved" -> %>
            <p class="mt-5 rounded-2xl bg-emerald-50 px-5 py-4 text-xs font-bold leading-relaxed text-emerald-800">
              Your agent account is approved. Our partnerships team will be in touch about
              activation and selling on Komiuta.
            </p>
          <% @agent.status == "rejected" -> %>
            <p class="mt-5 rounded-2xl bg-red-50 px-5 py-4 text-xs font-bold leading-relaxed text-red-700">
              This application was not approved. Contact support if you believe this is a mistake.
            </p>
          <% true -> %>
            <p class="mt-5 rounded-2xl bg-amber-50 px-5 py-4 text-xs font-bold leading-relaxed text-amber-800">
              Your application is under review. We will contact you once verification is complete.
            </p>
        <% end %>

        <%= if @agent.admin_notes do %>
          <p class="mt-3 rounded-2xl border border-amber-100 bg-amber-50 px-5 py-4 text-xs font-bold leading-relaxed text-amber-900">
            <strong>Reason / admin note:</strong> {@agent.admin_notes}
          </p>
        <% end %>

        <dl class="mt-6 grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">Email</dt>

            <dd class="mt-1 text-sm font-bold break-all">{@agent.email}</dd>
          </div>

          <div>
            <dt class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">Phone</dt>

            <dd class="mt-1 text-sm font-bold">{@agent.phone}</dd>
          </div>

          <div>
            <dt class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">
              Town / county
            </dt>

            <dd class="mt-1 text-sm font-bold">{@agent.city}</dd>
          </div>

          <div>
            <dt class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">
              Payout
            </dt>

            <dd class="mt-1 text-sm font-bold uppercase">{@agent.payout_method}</dd>
          </div>

          <%= if @agent.bus_operator do %>
            <div class="sm:col-span-2">
              <dt class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">
                Bus operator / partner
              </dt>

              <dd class="mt-1 inline-flex items-center gap-2 text-sm font-bold">
                <span class="material-symbols-outlined !text-base text-[#FF4C00]">directions_bus</span>
                {@agent.bus_operator.name}
              </dd>
            </div>
          <% end %>

          <%= if @agent.routes do %>
            <div class="sm:col-span-2">
              <dt class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">
                Routes
              </dt>

              <dd class="mt-1 text-sm font-bold">{@agent.routes}</dd>
            </div>
          <% end %>
        </dl>
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <%= if @agent.status == "approved" do %>
          <a
            href="/agent/dashboard"
            class="rounded-xl bg-[#FF4C00] px-5 py-3 text-center text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-[#E64400]"
          >
            Open dashboard
          </a>
        <% end %>

        <a
          href="/agent"
          class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-center text-[10px] font-black uppercase tracking-widest text-slate-600 transition hover:border-slate-300"
        >
          Agent home
        </a>

        <a
          href="/agent/logout"
          class="rounded-xl bg-slate-900 px-5 py-3 text-center text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-black"
        >
          Log out
        </a>
      </div>
    </main>

    <footer class="px-5 py-8 text-center text-[10px] font-black uppercase tracking-widest text-slate-400">
      © {DateTime.utc_now().year} Komiuta Agent
    </footer>
  </div>
</Layouts.app>
