<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-[#f8fafc] font-sans text-slate-900">
    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="/agent" class="flex items-center gap-3">
          <img
            src="/images/logo_brand.png"
            alt="Komiuta"
            width="146"
            height="40"
            class="h-9 w-auto"
          /> <span class="hidden h-8 w-px bg-slate-200 sm:block"></span>
          <span class="hidden text-[10px] font-black uppercase tracking-[0.3em] text-[#FF4C00] sm:block">
            Agent App
          </span>
        </a>

        <%= if @agent.status == "approved" do %>
          <a
            href="/agent/dashboard"
            aria-current="page"
            class="inline-flex items-center gap-2 rounded-xl bg-[#FF4C00] px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-white shadow-lg shadow-orange-200 transition hover:bg-[#E64400]"
          >
            <span class="material-symbols-outlined !text-base">dashboard</span> Dashboard
          </a>
        <% end %>
      </div>
    </header>

    <main class="mx-auto max-w-2xl px-5 py-12 md:py-16">
      <p class="text-[10px] font-black uppercase tracking-[0.3em] text-[#FF4C00]">
        Agent account
      </p>

      <h1 class="mt-2 text-3xl font-black tracking-tight md:text-4xl">
        {@salutation}, {@agent.full_name |> String.split() |> List.first()}
      </h1>

      <p class="mt-3 text-sm font-bold leading-relaxed text-slate-500">
        You are signed in to the KOMIUTA Agent app. Keep this page installed for updates on your
        application and agent account.
      </p>
      <%!-- Agent wallet: value of confirmed partner ticket sales --%>
      <%= if @agent.status == "approved" && @dashboard do %>
        <div class="mt-7 overflow-hidden rounded-[2rem] bg-gradient-to-br from-slate-900 via-slate-900 to-slate-800 p-6 text-white shadow-xl shadow-slate-900/20 md:p-8">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-white/10 text-white">
                <span class="material-symbols-outlined !text-2xl">account_balance_wallet</span>
              </div>

              <div>
                <p class="text-[10px] font-black uppercase tracking-[0.3em] text-white/50">
                  Your wallet
                </p>

                <p class="mt-1 text-lg font-black">Partner ticket sales</p>
              </div>
            </div>

            <span class="rounded-full bg-white/10 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-white/80">
              Payout · {String.capitalize(to_string(@agent.payout_method))}
            </span>
          </div>

          <p class="mt-6 text-3xl font-black tracking-tight md:text-4xl">
            {Xpressbus.AgentDashboard.money(@dashboard.kpis.sales_total)}
          </p>

          <p class="mt-1 text-xs font-bold text-white/60">
            <%= if @dashboard.operator do %>
              Confirmed bookings for {@dashboard.operator.name}
            <% else %>
              No partner linked yet — sales appear once an admin attaches your bus partner.
            <% end %>
          </p>

          <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
            <div class="rounded-2xl bg-white/5 px-4 py-3">
              <p class="text-[9px] font-black uppercase tracking-[0.2em] text-white/40">
                Bookings
              </p>

              <p class="mt-1 text-xl font-black">{@dashboard.kpis.confirmed}</p>
            </div>

            <div class="rounded-2xl bg-white/5 px-4 py-3">
              <p class="text-[9px] font-black uppercase tracking-[0.2em] text-white/40">
                Upcoming
              </p>

              <p class="mt-1 text-xl font-black">{@dashboard.kpis.upcoming}</p>
            </div>

            <div class="col-span-2 rounded-2xl bg-white/5 px-4 py-3 sm:col-span-1">
              <p class="text-[9px] font-black uppercase tracking-[0.2em] text-white/40">
                Routes sold
              </p>

              <p class="mt-1 text-xl font-black">{@dashboard.kpis.routes}</p>
            </div>
          </div>

          <div class="mt-5 flex flex-col gap-3 border-t border-white/10 pt-5 sm:flex-row sm:items-center sm:justify-between">
            <p class="max-w-md text-[10px] font-bold leading-relaxed text-white/50">
              This is the value of confirmed tickets sold for your partner. The Komiuta partnerships
              team settles payouts to your {String.capitalize(to_string(@agent.payout_method))} account.
            </p>

            <a
              href="/agent/dashboard"
              class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-xl bg-[#FF4C00] px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-[#E64400]"
            >
              Open dashboard
              <span class="material-symbols-outlined !text-[15px]">chevron_right</span>
            </a>
          </div>
        </div>
      <% end %>
      <%!-- Agent monthly KPI scorecard, synthesised from the partnership KPI model --%>
      <%= if @agent.status == "approved" do %>
        <section
          id="agent-kpi-scorecard"
          class="mt-6 overflow-hidden rounded-[1.75rem] border border-slate-100 bg-white shadow-xl shadow-slate-900/5"
        >
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-5 py-4">
            <div>
              <p class="text-[9px] font-black uppercase tracking-[0.25em] text-[#FF4C00]">
                Agent KPI scorecard
              </p>
              <h2 class="mt-0.5 text-base font-black tracking-tight text-slate-900">
                Monthly performance targets
              </h2>
            </div>
            <span class="rounded-full bg-slate-100 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-slate-500">
              100% weighted
            </span>
          </div>

          <div class="grid gap-3 p-4 sm:grid-cols-2">
            <article class="rounded-2xl border border-slate-100 bg-slate-50/70 p-3.5">
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-[11px] font-black leading-snug text-slate-800">
                  New operator onboarding (B2B)
                </h3>
                <span class="shrink-0 rounded-full bg-[#FF4C00] px-2 py-0.5 text-[8px] font-black text-white">
                  30%
                </span>
              </div>

              <div class="mt-2.5 grid grid-cols-2 gap-1.5">
                <div class="rounded-lg bg-white px-2.5 py-1.5">
                  <p class="text-[7px] font-black uppercase tracking-widest text-slate-400">
                    Target
                  </p>
                  <p class="mt-0.5 text-[10px] font-black text-slate-800">2–3 operators</p>
                </div>
                <div class="rounded-lg bg-emerald-50 px-2.5 py-1.5">
                  <p class="text-[7px] font-black uppercase tracking-widest text-emerald-600">
                    Achieved
                  </p>
                  <p class="mt-0.5 text-[10px] font-black text-emerald-700">—</p>
                </div>
              </div>

              <p class="mt-2 line-clamp-3 text-[9px] font-bold leading-snug text-slate-500">
                <span class="uppercase tracking-widest text-slate-400">KPI:</span>
                Help onboard new long-distance bus operators or Matatu Saccos each month.
              </p>
            </article>

            <article class="rounded-2xl border border-slate-100 bg-slate-50/70 p-3.5">
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-[11px] font-black leading-snug text-slate-800">
                  Agent network expansion
                </h3>
                <span class="shrink-0 rounded-full bg-[#FF4C00] px-2 py-0.5 text-[8px] font-black text-white">
                  25%
                </span>
              </div>

              <div class="mt-2.5 grid grid-cols-2 gap-1.5">
                <div class="rounded-lg bg-white px-2.5 py-1.5">
                  <p class="text-[7px] font-black uppercase tracking-widest text-slate-400">
                    Target
                  </p>
                  <p class="mt-0.5 text-[10px] font-black text-slate-800">15 active agents</p>
                </div>
                <div class="rounded-lg bg-emerald-50 px-2.5 py-1.5">
                  <p class="text-[7px] font-black uppercase tracking-widest text-emerald-600">
                    Achieved
                  </p>
                  <p class="mt-0.5 text-[10px] font-black text-emerald-700">—</p>
                </div>
              </div>

              <p class="mt-2 line-clamp-3 text-[9px] font-bold leading-snug text-slate-500">
                <span class="uppercase tracking-widest text-slate-400">KPI:</span>
                Recruit new active physical ticketing agents processing trips through the Agent App.
              </p>
            </article>

            <article class="rounded-2xl border border-slate-100 bg-slate-50/70 p-3.5">
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-[11px] font-black leading-snug text-slate-800">
                  Ticket booking volume
                </h3>
                <span class="shrink-0 rounded-full bg-[#FF4C00] px-2 py-0.5 text-[8px] font-black text-white">
                  20%
                </span>
              </div>

              <div class="mt-2.5 grid grid-cols-2 gap-1.5">
                <div class="rounded-lg bg-white px-2.5 py-1.5">
                  <p class="text-[7px] font-black uppercase tracking-widest text-slate-400">
                    Target
                  </p>
                  <p class="mt-0.5 text-[10px] font-black text-slate-800">MoM revenue growth</p>
                </div>
                <div class="rounded-lg bg-emerald-50 px-2.5 py-1.5">
                  <p class="text-[7px] font-black uppercase tracking-widest text-emerald-600">
                    Achieved
                  </p>
                  <p class="mt-0.5 text-[10px] font-black text-emerald-700">
                    {@dashboard.kpis.confirmed} confirmed
                  </p>
                </div>
              </div>

              <p class="mt-2 line-clamp-3 text-[9px] font-bold leading-snug text-slate-500">
                <span class="uppercase tracking-widest text-slate-400">KPI:</span>
                Deliver consistent month-on-month revenue growth across assigned route corridors.
              </p>
            </article>

            <article class="rounded-2xl border border-slate-100 bg-slate-50/70 p-3.5">
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-[11px] font-black leading-snug text-slate-800">
                  App downloads &amp; consumer growth
                </h3>
                <span class="shrink-0 rounded-full bg-[#FF4C00] px-2 py-0.5 text-[8px] font-black text-white">
                  15%
                </span>
              </div>

              <div class="mt-2.5 grid grid-cols-2 gap-1.5">
                <div class="rounded-lg bg-white px-2.5 py-1.5">
                  <p class="text-[7px] font-black uppercase tracking-widest text-slate-400">
                    Target
                  </p>
                  <p class="mt-0.5 text-[10px] font-black text-slate-800">200 sign-ups</p>
                </div>
                <div class="rounded-lg bg-emerald-50 px-2.5 py-1.5">
                  <p class="text-[7px] font-black uppercase tracking-widest text-emerald-600">
                    Achieved
                  </p>
                  <p class="mt-0.5 text-[10px] font-black text-emerald-700">—</p>
                </div>
              </div>

              <p class="mt-2 line-clamp-3 text-[9px] font-bold leading-snug text-slate-500">
                <span class="uppercase tracking-widest text-slate-400">KPI:</span>
                Secure new passenger sign-ups and first-time bookings with your agent tracking code.
              </p>
            </article>

            <article class="rounded-2xl border border-slate-100 bg-slate-50/70 p-3.5 sm:col-span-2">
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-[11px] font-black leading-snug text-slate-800">
                  Operator retention &amp; platform adoption
                </h3>
                <span class="shrink-0 rounded-full bg-[#FF4C00] px-2 py-0.5 text-[8px] font-black text-white">
                  10%
                </span>
              </div>

              <div class="mt-2.5 grid grid-cols-2 gap-1.5 sm:max-w-[calc(50%-0.25rem)]">
                <div class="rounded-lg bg-white px-2.5 py-1.5">
                  <p class="text-[7px] font-black uppercase tracking-widest text-slate-400">
                    Target
                  </p>
                  <p class="mt-0.5 text-[10px] font-black text-slate-800">0 operator churn</p>
                </div>
                <div class="rounded-lg bg-emerald-50 px-2.5 py-1.5">
                  <p class="text-[7px] font-black uppercase tracking-widest text-emerald-600">
                    Achieved
                  </p>
                  <p class="mt-0.5 text-[10px] font-black text-emerald-700">
                    {if @dashboard.operator, do: "Active partner", else: "—"}
                  </p>
                </div>
              </div>

              <p class="mt-2 line-clamp-3 text-[9px] font-bold leading-snug text-slate-500">
                <span class="uppercase tracking-widest text-slate-400">KPI:</span>
                Maintain zero churn among onboarded operators and continuous automated booking usage.
              </p>
            </article>
          </div>

          <div class="border-t border-slate-100 bg-slate-50/60 px-5 py-3">
            <p class="text-[9px] font-bold leading-relaxed text-slate-400">
              Reviewed monthly with your Komiuta partnerships manager. Achieved values are confirmed by your manager.
            </p>
          </div>
        </section>
      <% end %>

      <div class="mt-6 rounded-[2rem] border border-slate-100 bg-white p-6 shadow-xl shadow-slate-900/5 md:p-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.25em] text-slate-400">
              Application status
            </p>

            <p class="mt-1 text-lg font-black">{@agent.business_name}</p>
          </div>

          <span class={[
            "rounded-full px-4 py-2 text-[10px] font-black uppercase tracking-widest",
            @agent.status == "approved" && "bg-emerald-50 text-emerald-700",
            @agent.status == "rejected" && "bg-red-50 text-red-600",
            @agent.status == "pending" && "bg-amber-50 text-amber-700"
          ]}>
            {@agent.status}
          </span>
        </div>

        <div class="mt-6 rounded-2xl border border-slate-100 bg-slate-50 p-5">
          <p class="text-[9px] font-black uppercase tracking-[0.25em] text-slate-400">
            Agent reference
          </p>

          <p class="mt-2 text-2xl font-black tracking-wide text-slate-900">{@agent.reference}</p>
        </div>

        <%= cond do %>
          <% @agent.status == "approved" -> %>
            <p class="mt-5 rounded-2xl bg-emerald-50 px-5 py-4 text-xs font-bold leading-relaxed text-emerald-800">
              Your agent account is approved. Our partnerships team will be in touch about
              activation and selling on Komiuta.
            </p>
          <% @agent.status == "rejected" -> %>
            <p class="mt-5 rounded-2xl bg-red-50 px-5 py-4 text-xs font-bold leading-relaxed text-red-700">
              This application was not approved. Contact support if you believe this is a mistake.
            </p>
          <% true -> %>
            <p class="mt-5 rounded-2xl bg-amber-50 px-5 py-4 text-xs font-bold leading-relaxed text-amber-800">
              Your application is under review. We will contact you once verification is complete.
            </p>
        <% end %>

        <%= if @agent.status == "approved" do %>
          <div class="mt-4 flex flex-col gap-4 rounded-2xl border border-orange-100 bg-orange-50/60 p-5 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined !text-2xl text-[#FF4C00]">badge</span>
              <div>
                <p class="text-xs font-black text-slate-900">Your verified agent ID is ready</p>

                <p class="mt-1 text-[11px] font-bold leading-relaxed text-slate-500">
                  Print your official lanyard tag with a scannable verification QR code.
                </p>
              </div>
            </div>

            <a
              href="/agent/tag"
              class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-3 text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-black"
            >
              <span class="material-symbols-outlined !text-base">print</span> Print ID tag
            </a>
          </div>
        <% end %>

        <%= if @agent.admin_notes do %>
          <p class="mt-3 rounded-2xl border border-amber-100 bg-amber-50 px-5 py-4 text-xs font-bold leading-relaxed text-amber-900">
            <strong>Reason / admin note:</strong> {@agent.admin_notes}
          </p>
        <% end %>

        <dl class="mt-6 grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">Email</dt>

            <dd class="mt-1 text-sm font-bold break-all">{@agent.email}</dd>
          </div>

          <div>
            <dt class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">Phone</dt>

            <dd class="mt-1 text-sm font-bold">{@agent.phone}</dd>
          </div>

          <div>
            <dt class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">
              Town / county
            </dt>

            <dd class="mt-1 text-sm font-bold">{@agent.city}</dd>
          </div>

          <div>
            <dt class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">
              Payout
            </dt>

            <dd class="mt-1 text-sm font-bold uppercase">{@agent.payout_method}</dd>
          </div>

          <%= if @agent.bus_operator do %>
            <div class="sm:col-span-2">
              <dt class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">
                Bus operator / partner
              </dt>

              <dd class="mt-1 inline-flex items-center gap-2 text-sm font-bold">
                <span class="material-symbols-outlined !text-base text-[#FF4C00]">directions_bus</span> {@agent.bus_operator.name}
              </dd>
            </div>
          <% end %>

          <%= if @agent.routes do %>
            <div class="sm:col-span-2">
              <dt class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">
                Routes
              </dt>

              <dd class="mt-1 text-sm font-bold">{@agent.routes}</dd>
            </div>
          <% end %>
        </dl>
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <%= if @agent.status == "approved" do %>
          <a
            href="/agent/dashboard"
            class="rounded-xl bg-[#FF4C00] px-5 py-3 text-center text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-[#E64400]"
          >
            Open dashboard
          </a>

          <a
            href="/agent/tag"
            class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-center text-[10px] font-black uppercase tracking-widest text-slate-600 transition hover:border-slate-300"
          >
            Agent ID tag
          </a>
        <% end %>

        <a
          href="/agent"
          class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-center text-[10px] font-black uppercase tracking-widest text-slate-600 transition hover:border-slate-300"
        >
          Agent home
        </a>

        <a
          href="/agent/logout"
          class="rounded-xl bg-slate-900 px-5 py-3 text-center text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-black"
        >
          Log out
        </a>
      </div>
    </main>

    <footer class="px-5 py-8 text-center text-[10px] font-black uppercase tracking-widest text-slate-400">
      © {DateTime.utc_now().year} Komiuta Agent
    </footer>
  </div>
</Layouts.app>
