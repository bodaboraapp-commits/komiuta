<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-[#f8fafc] font-sans text-slate-900">
    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-5 py-4">
        <a href="/agent" class="flex items-center gap-3">
          <img
            src="/images/logo_brand.png"
            alt="KOMIUTA"
            width="146"
            height="40"
            class="h-9 w-auto"
          />
          <span class="hidden h-8 w-px bg-slate-200 sm:block"></span>
          <span class="hidden text-[10px] font-black uppercase tracking-[0.3em] text-[#FF4C00] sm:block">
            Agent App
          </span>
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-lg px-5 py-12 md:py-20">
      <%= if @agent do %>
        <div class="rounded-[2rem] border border-emerald-100 bg-white p-7 text-center shadow-xl shadow-emerald-900/5 md:p-9">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600">
            <span class="material-symbols-outlined !text-4xl">verified</span>
          </div>

          <p class="mt-5 text-[10px] font-black uppercase tracking-[0.3em] text-emerald-600">
            Verified KOMIUTA agent
          </p>

          <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-900">
            {@agent.full_name}
          </h1>
          <p class="mt-1 text-sm font-bold text-slate-500">{@agent.business_name}</p>

          <div class="mt-6 grid gap-3 rounded-2xl bg-slate-50 p-5 text-left sm:grid-cols-2">
            <div>
              <p class="text-[9px] font-black uppercase tracking-[0.25em] text-slate-400">
                Agent ref
              </p>
              <p class="mt-1 font-mono text-sm font-black text-slate-800">{@agent.reference}</p>
            </div>
            <div>
              <p class="text-[9px] font-black uppercase tracking-[0.25em] text-slate-400">Base</p>
              <p class="mt-1 text-sm font-black text-slate-800">{@agent.city}</p>
            </div>
            <div class="sm:col-span-2">
              <p class="text-[9px] font-black uppercase tracking-[0.25em] text-slate-400">
                Status
              </p>
              <p class="mt-1 inline-flex items-center gap-1.5 text-sm font-black text-emerald-700">
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span> Approved &amp; active
              </p>
            </div>
          </div>

          <p class="mt-6 text-[11px] font-bold leading-relaxed text-slate-400">
            This ID tag was scanned from a physical KOMIUTA agent card. The status above is checked
            live against our records.
          </p>
        </div>
      <% else %>
        <div class="rounded-[2rem] border border-red-100 bg-white p-7 text-center shadow-xl shadow-red-900/5 md:p-9">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-red-50 text-red-500">
            <span class="material-symbols-outlined !text-4xl">gpp_bad</span>
          </div>

          <h1 class="mt-5 text-2xl font-black tracking-tight text-slate-900">Tag not valid</h1>
          <p class="mt-2 text-xs font-bold leading-relaxed text-slate-500">
            This agent tag is not recognised, has expired, or the agent is no longer approved.
            Please confirm the card with KOMIUTA support before accepting it.
          </p>

          <a
            href="/agent"
            class="mt-7 inline-flex rounded-xl bg-slate-900 px-5 py-3 text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-black"
          >
            KOMIUTA Agent
          </a>
        </div>
      <% end %>
    </main>

    <footer class="px-5 py-8 text-center text-[10px] font-black uppercase tracking-widest text-slate-400">
      © {DateTime.utc_now().year} KOMIUTA Agent
    </footer>
  </div>
</Layouts.app>
