<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-[#f8fafc] font-sans text-slate-900">
    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="/agent" class="flex items-center gap-3">
          <img
            src="/images/logo_brand.png"
            alt="Komiuta"
            width="146"
            height="40"
            class="h-9 w-auto"
          />
          <span class="hidden h-8 w-px bg-slate-200 sm:block"></span>
          <span class="hidden text-[10px] font-black uppercase tracking-[0.3em] text-[#FF4C00] sm:block">
            Agent App
          </span>
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-md px-5 py-12 md:py-20">
      <div class="rounded-[2rem] border border-slate-100 bg-white p-6 shadow-xl shadow-slate-900/5 md:p-8">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-50 text-[#FF4C00]">
          <span class="material-symbols-outlined !text-2xl">login</span>
        </div>

        <h1 class="mt-5 text-2xl font-black tracking-tight">Agent sign in</h1>
        <p class="mt-2 text-xs font-bold leading-relaxed text-slate-400">
          Sign in with Gmail for email, or receive a login code by SMS on the phone number on
          your agent application.
        </p>

        <%= if @google_enabled do %>
          <a
            href={@google_start_url}
            class="mt-7 flex w-full items-center justify-center gap-3 rounded-xl border-2 border-slate-100 bg-white px-6 py-4 text-xs font-black tracking-tight text-slate-700 shadow-sm transition hover:bg-slate-50 active:scale-[0.99]"
          >
            <img
              src="https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png"
              class="h-5 w-5"
              alt="Google"
              width="20"
              height="20"
              decoding="async"
            /> Sign in with Gmail
          </a>
        <% end %>

        <%= if @firebase_config do %>
          <div class="relative my-7">
            <div class="absolute inset-0 flex items-center">
              <div class="w-full border-t border-slate-100"></div>
            </div>
            <div class="relative flex justify-center text-[9px] font-black uppercase tracking-widest">
              <span class="bg-white px-4 text-slate-400">or use SMS</span>
            </div>
          </div>

          <div
            id="firebase-sms-auth"
            data-api-key={@firebase_config.api_key}
            data-auth-domain={@firebase_config.auth_domain}
            data-project-id={@firebase_config.project_id}
            data-storage-bucket={@firebase_config.storage_bucket}
            data-messaging-sender-id={@firebase_config.messaging_sender_id}
            data-app-id={@firebase_config.app_id}
            data-verify-url="/agent/firebase/verify"
            data-redirect="/agent/account"
          >
            <form id="firebase-sms-form" class="space-y-4" novalidate>
              <div id="firebase-phone-step">
                <label
                  for="firebase-phone"
                  class="mb-1.5 block text-[10px] font-black uppercase tracking-widest text-slate-500"
                >
                  Phone Number
                </label>
                <input
                  id="firebase-phone"
                  type="tel"
                  inputmode="tel"
                  autocomplete="tel"
                  placeholder="07XX XXX XXX"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-sm font-bold outline-none transition focus:border-[#FF4C00] focus:bg-white"
                  required
                />
                <p
                  id="firebase-phone-hint"
                  class="mt-2 text-[10px] font-bold leading-relaxed text-slate-400"
                >
                  Enter the phone number on your agent application. Firebase will send a 6-digit
                  code by SMS.
                </p>
              </div>

              <div id="firebase-recaptcha"></div>

              <button
                id="firebase-send-code"
                type="submit"
                class="w-full rounded-xl bg-[#FF4C00] px-6 py-4 text-xs font-black uppercase tracking-[0.2em] text-white shadow-xl shadow-orange-200 transition hover:bg-[#E64400] active:scale-[0.99]"
              >
                Send Login Code
              </button>

              <div id="firebase-code-step" class="hidden space-y-3">
                <div>
                  <label
                    for="firebase-code"
                    class="mb-1.5 block text-[10px] font-black uppercase tracking-widest text-slate-500"
                  >
                    SMS Code
                  </label>
                  <input
                    id="firebase-code"
                    type="text"
                    inputmode="numeric"
                    autocomplete="one-time-code"
                    pattern="[0-9]{6}"
                    maxlength="6"
                    placeholder="000000"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-center text-xl font-black tracking-[0.4em] outline-none transition focus:border-[#FF4C00] focus:bg-white"
                  />
                </div>

                <button
                  id="firebase-verify-code"
                  type="submit"
                  class="w-full rounded-xl bg-slate-900 px-6 py-4 text-xs font-black uppercase tracking-[0.2em] text-white shadow-xl transition hover:bg-black active:scale-[0.99]"
                >
                  Verify &amp; Sign In
                </button>

                <button
                  id="firebase-change-number"
                  type="button"
                  class="w-full text-[10px] font-black uppercase tracking-widest text-slate-400 transition hover:text-[#FF4C00]"
                >
                  Use a different number
                </button>
              </div>

              <p
                id="firebase-status"
                class="min-h-[16px] text-[11px] font-bold text-slate-500"
                role="status"
                aria-live="polite"
              >
              </p>
            </form>

            <script
              defer
              phx-track-static
              type="text/javascript"
              src={~p"/assets/js/firebase_phone_auth.js"}
            >
            </script>
          </div>
        <% else %>
          <div class="mt-7 rounded-2xl border border-amber-100 bg-amber-50 p-5 text-xs font-bold leading-relaxed text-amber-800">
            SMS sign-in is not configured yet. Use Gmail above or contact support on 0800 211 211.
          </div>
        <% end %>

        <p class="mt-6 text-center text-[11px] font-bold text-slate-400">
          Applying for the first time?
          <a href="/agent" class="font-black text-[#FF4C00] hover:underline">Create an agent account</a>
        </p>
      </div>
    </main>

    <footer class="px-5 py-8 text-center text-[10px] font-black uppercase tracking-widest text-slate-400">
      © {DateTime.utc_now().year} Komiuta Agent
    </footer>
  </div>
</Layouts.app>
