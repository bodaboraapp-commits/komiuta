<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-[#f8fafc] font-sans text-slate-900">
    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="/agent" class="flex items-center gap-3">
          <img
            src="/images/logo_brand.png"
            alt="Komiuta"
            width="146"
            height="40"
            class="h-9 w-auto"
          />
          <span class="hidden h-8 w-px bg-slate-200 sm:block"></span>
          <span class="hidden text-[10px] font-black uppercase tracking-[0.3em] text-[#FF4C00] sm:block">
            Agent App
          </span>
        </a>

        <a
          href="/agent/login"
          class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-700 shadow-sm transition hover:border-[#FF4C00] hover:text-[#FF4C00]"
        >
          Log in
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-md px-5 py-12 md:py-20">
      <div class="rounded-[2rem] border border-slate-100 bg-white p-6 shadow-xl shadow-slate-900/5 md:p-8">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-50 text-[#FF4C00]">
          <span class="material-symbols-outlined !text-2xl">key</span>
        </div>

        <h1 class="mt-5 text-2xl font-black tracking-tight">Set your agent password</h1>
        <p class="mt-2 text-xs font-bold leading-relaxed text-slate-400">
          For applications submitted before agent login was available. Use the reference from your
          application email.
        </p>

        <form action="/agent/set-password" method="post" class="mt-7 space-y-4">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

          <div>
            <label
              for="agent-identifier"
              class="mb-1.5 block text-[10px] font-black uppercase tracking-widest text-slate-500"
            >
              Email or phone
            </label>
            <input
              id="agent-identifier"
              name="agent[identifier]"
              type="text"
              value={@identifier}
              autocomplete="username"
              required
              class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-sm font-bold outline-none transition focus:border-[#FF4C00] focus:bg-white"
            />
          </div>

          <div>
            <label
              for="agent-reference"
              class="mb-1.5 block text-[10px] font-black uppercase tracking-widest text-slate-500"
            >
              Application reference
            </label>
            <input
              id="agent-reference"
              name="agent[reference]"
              type="text"
              value={@reference}
              placeholder="AGT-XXXXXXXX"
              required
              class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-sm font-bold uppercase outline-none transition focus:border-[#FF4C00] focus:bg-white"
            />
          </div>

          <div>
            <label
              for="agent-password"
              class="mb-1.5 block text-[10px] font-black uppercase tracking-widest text-slate-500"
            >
              New password
            </label>
            <input
              id="agent-password"
              name="agent[password]"
              type="password"
              autocomplete="new-password"
              minlength="8"
              required
              class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-sm font-bold outline-none transition focus:border-[#FF4C00] focus:bg-white"
            />
          </div>

          <div>
            <label
              for="agent-password-confirmation"
              class="mb-1.5 block text-[10px] font-black uppercase tracking-widest text-slate-500"
            >
              Confirm password
            </label>
            <input
              id="agent-password-confirmation"
              name="agent[password_confirmation]"
              type="password"
              autocomplete="new-password"
              minlength="8"
              required
              class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-sm font-bold outline-none transition focus:border-[#FF4C00] focus:bg-white"
            />
          </div>

          <button
            type="submit"
            class="w-full rounded-xl bg-[#FF4C00] px-6 py-4 text-xs font-black uppercase tracking-[0.2em] text-white shadow-xl shadow-orange-200 transition hover:bg-[#E64400] active:scale-[0.99]"
          >
            Set password
          </button>
        </form>

        <p class="mt-5 text-center text-[11px] font-bold text-slate-400">
          Already activated?
          <a href="/agent/login" class="font-black text-[#FF4C00] hover:underline">Log in</a>
        </p>
      </div>
    </main>

    <footer class="px-5 py-8 text-center text-[10px] font-black uppercase tracking-widest text-slate-400">
      © {DateTime.utc_now().year} Komiuta Agent
    </footer>
  </div>
</Layouts.app>
