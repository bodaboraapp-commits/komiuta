<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found · Komiuta</title>
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>
  <body class="min-h-screen bg-[#f8fafc] font-sans text-slate-900 antialiased">
    <main class="min-h-screen flex items-center justify-center px-6 py-16">
      <div class="w-full max-w-2xl text-center">
        <a href="/" class="inline-flex items-center justify-center mb-10">
          <img src="/images/logo_brand.png" alt="Komiuta" class="h-12 w-auto" />
        </a>

        <p class="text-[11px] font-black uppercase tracking-[0.4em] text-[#FF4C00] mb-4">
          Error 404
        </p>
        <h1 class="text-4xl md:text-6xl font-black tracking-tighter leading-none mb-4">
          This page took a different route.
        </h1>
        <p class="text-sm md:text-base font-bold text-slate-500 leading-relaxed mb-10">
          The page you are looking for does not exist, has moved, or the link is out of date.
          Your trip is still on track — pick up where you left off below.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/"
            class="w-full sm:w-auto px-8 py-4 rounded-full bg-[#FF4C00] text-white text-[11px] font-black uppercase tracking-widest hover:bg-[#E64400] transition shadow-lg shadow-orange-200"
          >
            Book a bus
          </a>
          <a
            href="/tickets"
            class="w-full sm:w-auto px-8 py-4 rounded-full bg-white border border-slate-200 text-slate-700 text-[11px] font-black uppercase tracking-widest hover:border-[#FF4C00] hover:text-[#FF4C00] transition"
          >
            Track my ticket
          </a>
          <a
            href="/tour-packages"
            class="w-full sm:w-auto px-8 py-4 rounded-full bg-white border border-slate-200 text-slate-700 text-[11px] font-black uppercase tracking-widest hover:border-[#FF4C00] hover:text-[#FF4C00] transition"
          >
            Explore Chyllz
          </a>
        </div>

        <p class="mt-12 text-[10px] font-black uppercase tracking-[0.3em] text-slate-400">
          Need help?
          <a class="text-[#FF4C00] underline underline-offset-4" href="mailto:hello@komiuta.com">hello@komiuta.com</a>
        </p>
      </div>
    </main>
  </body>
</html>
