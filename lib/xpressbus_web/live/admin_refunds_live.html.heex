<Layouts.app flash={@flash}>
  <div class="flex min-h-screen bg-[#f8fafc]">
    <.sidebar
      active_tab="refunds"
      bus_expanded={@bus_expanded}
      chyllz_expanded={@chyllz_expanded}
      settings_expanded={@settings_expanded}
      collapsed={@sidebar_collapsed}
    />

    <div class={[
      "flex-1 transition-all duration-300",
      if(@sidebar_collapsed, do: "lg:pl-20", else: "lg:pl-72")
    ]}>
      <header class="sticky top-0 z-30 flex h-20 items-center justify-between border-b border-slate-100 bg-white px-8">
        <h2 class="text-xl font-black uppercase tracking-widest text-slate-900">Refunds</h2>
        <div class="flex items-center gap-3">
          <span class="rounded-full bg-orange-50 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-[#FF4C00]">
            {@total_count} total
          </span>
          <div class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-white bg-orange-100 text-xs font-black text-[#FF4C00] shadow-sm">
            AD
          </div>
        </div>
      </header>

      <main class="p-6 md:p-10">
        <div class="mb-8 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div>
            <h1 class="text-3xl font-black uppercase tracking-tighter text-slate-900">
              Refund history
            </h1>
            <p class="mt-1 text-sm font-bold tracking-wide text-slate-400">
              Every refund recorded from a cancelled ticket, with its notification status.
            </p>
          </div>

          <form
            id="refund-search-form"
            phx-change="search"
            class="flex w-full items-center gap-3 rounded-2xl border border-slate-100 bg-white px-5 py-3 shadow-sm md:w-96"
          >
            <span class="material-symbols-outlined text-slate-300">search</span>
            <input
              type="search"
              name="search"
              value={@search}
              phx-debounce="300"
              placeholder="Search ticket, reference, passenger or phone"
              class="w-full border-0 p-0 text-sm font-bold text-slate-700 placeholder:text-slate-300 focus:outline-none focus:ring-0"
            />
          </form>
        </div>

        <div class="mb-6 grid gap-4 sm:grid-cols-2">
          <div class="rounded-[2rem] border border-slate-100 bg-white p-6 shadow-sm">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
              Refunds recorded
            </p>
            <p class="mt-2 text-3xl font-black tabular-nums text-slate-900">
              {@refund_totals.count}
            </p>
          </div>
          <div class="rounded-[2rem] border border-slate-100 bg-white p-6 shadow-sm">
            <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
              Total refunded
            </p>
            <p class="mt-2 text-3xl font-black tabular-nums text-[#FF4C00]">
              KES {@refund_totals.amount}
            </p>
          </div>
        </div>

        <div class="overflow-hidden rounded-[2rem] border border-slate-100 bg-white shadow-sm">
          <table id="refunds-table" class="w-full text-left">
            <thead class="border-b border-slate-100 bg-slate-50/60">
              <tr>
                <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">
                  Refunded
                </th>
                <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">
                  Ticket
                </th>
                <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">
                  Passenger
                </th>
                <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">
                  Route
                </th>
                <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">
                  Amount
                </th>
                <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">
                  Reference
                </th>
                <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">
                  Notifications
                </th>
                <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-slate-400">
                  Status
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-50">
              <%= for refund <- @refunds do %>
                <tr id={"refund-row-#{refund.ticket_id}"} class="hover:bg-slate-50/60">
                  <td class="px-6 py-4 text-xs font-bold text-slate-500">
                    {Calendar.strftime(refund.inserted_at, "%d %b %Y, %H:%M")}
                  </td>
                  <td class="px-6 py-4">
                    <p class="text-xs font-black text-slate-900">{refund.ticket_id}</p>
                    <p class="text-[10px] font-bold text-slate-400">{refund.price}</p>
                  </td>
                  <td class="px-6 py-4">
                    <p class="text-xs font-bold text-slate-700">{refund.passenger_name}</p>
                    <p class="text-[10px] font-bold text-slate-400">{refund.passenger_phone}</p>
                  </td>
                  <td class="px-6 py-4 text-xs font-bold text-slate-600">
                    {refund.from} → {refund.to}
                  </td>
                  <td class="px-6 py-4 text-sm font-black text-[#FF4C00]">
                    KES {refund.amount}
                  </td>
                  <td class="px-6 py-4 text-xs font-bold text-slate-500">
                    {refund.reference || "—"}
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex flex-wrap gap-1.5">
                      <span class={[
                        "rounded-full px-2 py-1 text-[9px] font-black uppercase tracking-widest",
                        refund.email_sent && "bg-emerald-50 text-emerald-600",
                        !refund.email_sent && "bg-slate-100 text-slate-400"
                      ]}>
                        Email
                      </span>
                      <span class={[
                        "rounded-full px-2 py-1 text-[9px] font-black uppercase tracking-widest",
                        refund.sms_sent && "bg-emerald-50 text-emerald-600",
                        !refund.sms_sent && "bg-slate-100 text-slate-400"
                      ]}>
                        SMS
                      </span>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <span class="rounded-full bg-orange-50 px-2.5 py-1 text-[9px] font-black uppercase tracking-widest text-[#FF4C00]">
                      {refund.status}
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>

          <%= if Enum.empty?(@refunds) do %>
            <div class="px-6 py-16 text-center">
              <span class="material-symbols-outlined !text-4xl text-slate-200">reply</span>
              <p class="mt-4 text-sm font-black text-slate-500">No refunds yet</p>
              <p class="mt-1 text-xs font-bold text-slate-400">
                Refunds appear here after you cancel and refund a ticket from the Tickets page.
              </p>
            </div>
          <% end %>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <p class="text-[11px] font-black uppercase tracking-widest text-slate-400">
            Showing {min((@page - 1) * @page_size + 1, @total_count)} to {min(
              @page * @page_size,
              @total_count
            )} of {@total_count} entries
          </p>

          <div class="flex items-center gap-2">
            <button
              phx-click="change_page"
              phx-value-page={@page - 1}
              disabled={@page <= 1}
              class="rounded-xl border border-slate-100 bg-white px-4 py-2 text-[10px] font-black uppercase tracking-widest text-slate-500 transition hover:text-[#FF4C00] disabled:cursor-not-allowed disabled:opacity-40"
            >
              Previous
            </button>

            <%= for p <- 1..@total_pages do %>
              <button
                phx-click="change_page"
                phx-value-page={p}
                class={[
                  "h-9 w-9 rounded-xl text-[10px] font-black transition",
                  p == @page && "bg-[#FF4C00] text-white shadow-md shadow-orange-100",
                  p != @page &&
                    "border border-slate-100 bg-white text-slate-500 hover:text-[#FF4C00]"
                ]}
              >
                {p}
              </button>
            <% end %>

            <button
              phx-click="change_page"
              phx-value-page={@page + 1}
              disabled={@page >= @total_pages}
              class="rounded-xl border border-slate-100 bg-white px-4 py-2 text-[10px] font-black uppercase tracking-widest text-slate-500 transition hover:text-[#FF4C00] disabled:cursor-not-allowed disabled:opacity-40"
            >
              Next
            </button>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layouts.app>
