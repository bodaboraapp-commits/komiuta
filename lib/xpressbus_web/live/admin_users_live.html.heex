<Layouts.app flash={@flash}>
  <div class="flex min-h-screen bg-[#f8fafc]">
    <.sidebar
      active_tab="users"
      bus_expanded={@bus_expanded}
      chyllz_expanded={@chyllz_expanded}
      settings_expanded={@settings_expanded}
      collapsed={@sidebar_collapsed}
    />

    <div class={[
      "flex-1 transition-all duration-300",
      if(@sidebar_collapsed, do: "lg:pl-20", else: "lg:pl-72")
    ]}>
      <header class="h-20 bg-white border-b border-slate-100 flex items-center justify-between px-8 sticky top-0 z-30">
        <h2 class="text-xl font-black text-slate-900 tracking-tight uppercase tracking-widest">
          User/Agent List
        </h2>

        <div class="flex items-center gap-6">
          <button class="w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 hover:text-[#FF4C00] transition-colors relative">
            <span class="material-symbols-outlined">notifications</span>
            <div class="absolute top-2.5 right-2.5 w-2 h-2 bg-[#FF4C00] rounded-full border-2 border-white">
            </div>
          </button>

          <div class="flex items-center gap-3 border-l border-slate-100 pl-6">
            <div class="text-right hidden sm:block">
              <p class="text-[11px] font-black text-slate-900 leading-none">Admin User</p>
              <p class="text-[9px] font-bold text-slate-400 uppercase mt-1">Super Admin</p>
            </div>

            <div class="w-10 h-10 rounded-full bg-orange-100 flex items-center justify-center text-[#FF4C00] font-black text-xs border-2 border-white shadow-sm">
              AD
            </div>
          </div>
        </div>
      </header>

      <main class="p-8 md:p-12">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-8">
          <div>
            <h1 class="text-3xl font-black text-slate-900 tracking-tighter uppercase tracking-widest">
              Users
            </h1>
            <p class="text-sm font-bold text-slate-400 mt-1 tracking-wide">
              Every registered customer — {(@total_count && Integer.to_string(@total_count)) ||
                "0"} account(s)
            </p>
          </div>

          <form
            id="user-search-form"
            phx-change="search"
            class="flex items-center gap-3 bg-white border border-slate-100 rounded-2xl px-5 py-3 shadow-sm w-full md:w-96"
          >
            <span class="material-symbols-outlined text-slate-300">search</span>
            <input
              type="search"
              name="search"
              value={@search}
              phx-debounce="300"
              placeholder="Search name, phone or email"
              class="w-full border-0 focus:ring-0 focus:outline-none p-0 text-sm font-bold text-slate-700 placeholder:text-slate-300"
            />
          </form>
        </div>

        <div class="bg-white rounded-[2.5rem] shadow-sm border border-slate-100 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead>
                <tr class="border-b border-slate-50 bg-slate-50/30">
                  <th class="px-6 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                    #
                  </th>
                  <th class="px-6 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-[#FF4C00]">
                    User
                  </th>
                  <th class="px-6 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                    Phone
                  </th>
                  <th class="px-6 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                    Email
                  </th>
                  <th class="px-6 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                    Signed Up
                  </th>
                  <th class="px-6 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 text-center">
                    Tickets
                  </th>
                  <th class="px-6 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                    Wallet
                  </th>
                  <th class="px-6 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                    Login Ready
                  </th>
                </tr>
              </thead>

              <tbody class="divide-y divide-slate-50">
                <%= if Enum.empty?(@users) do %>
                  <tr>
                    <td colspan="8" class="px-8 py-20 text-center">
                      <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center text-slate-200 mx-auto mb-4">
                        <span class="material-symbols-outlined !text-4xl">group</span>
                      </div>
                      <h3 class="text-lg font-black text-slate-400 uppercase tracking-widest">
                        No users found
                      </h3>
                      <p class="text-sm font-bold text-slate-300 mt-2">
                        {if @search == "",
                          do: "Users appear here after they sign up.",
                          else: "Nothing matches “#{@search}”."}
                      </p>
                    </td>
                  </tr>
                <% else %>
                  <%= for {user, index} <- Enum.with_index(@users) do %>
                    <tr class="hover:bg-slate-50/50 transition-colors">
                      <td class="px-6 py-5 text-sm font-bold text-slate-400">
                        {(@page - 1) * @page_size + index + 1}
                      </td>

                      <td class="px-6 py-5">
                        <div class="flex items-center gap-3">
                          <div class="w-9 h-9 rounded-full bg-orange-100 text-[#FF4C00] flex items-center justify-center font-black text-xs shrink-0">
                            {user.initials}
                          </div>
                          <span class="text-sm font-black text-slate-900">{user.name}</span>
                        </div>
                      </td>

                      <td class="px-6 py-5 text-sm font-bold text-slate-600">
                        {user.phone || "—"}
                      </td>

                      <td class="px-6 py-5 text-sm font-bold text-slate-600">
                        <%= if user.email && String.ends_with?(String.downcase(user.email), "@xpressbus.com") do %>
                          <span class="text-amber-600">Missing email</span>
                        <% else %>
                          {user.email || "—"}
                        <% end %>
                      </td>

                      <td class="px-6 py-5 text-sm font-bold text-slate-500">
                        {if user.signed_up,
                          do: Calendar.strftime(user.signed_up, "%d %b %Y"),
                          else: "—"}
                      </td>

                      <td class="px-6 py-5 text-center">
                        <span class="inline-flex items-center justify-center min-w-8 px-2 py-1 rounded-full bg-slate-50 text-slate-600 text-xs font-black">
                          {user.tickets}
                        </span>
                      </td>

                      <td class="px-6 py-5 text-sm font-black text-slate-900">
                        KES {user.wallet}
                      </td>

                      <td class="px-6 py-5">
                        <%= if user.login_ready do %>
                          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-[10px] font-black uppercase tracking-widest border border-emerald-100">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Ready
                          </span>
                        <% else %>
                          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-50 text-amber-700 text-[10px] font-black uppercase tracking-widest border border-amber-100">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Incomplete
                          </span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>

          <.pager page={@page} page_size={@page_size} total_count={@total_count} />
        </div>
      </main>
    </div>
  </div>
</Layouts.app>
