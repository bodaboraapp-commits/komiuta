<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-slate-50 text-slate-900">
    <.main_header step={@step} current_user={@current_user} />

    <main class="pt-[72px] md:pt-[80px]">
      <section class="bg-slate-950 text-white pt-12 pb-14 px-6">
        <div class="max-w-[1100px] mx-auto">
          <nav
            class="mb-5 flex flex-wrap items-center gap-2 text-[10px] font-black uppercase tracking-widest text-slate-500"
            aria-label="Breadcrumb"
          >
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span>/</span>
            <span class="text-slate-300">{@city.name}</span>
          </nav>
          <p class="mb-3 text-[10px] font-black uppercase tracking-[0.4em] text-[#FF4C00]">
            Bus tickets · {@city.region}
          </p>
          <h1 class="text-4xl md:text-6xl font-black tracking-tighter leading-none mb-4">
            Buses from {@city.name}
          </h1>
          <p class="max-w-2xl text-sm md:text-base font-bold leading-relaxed text-slate-400">
            {@city.intro}
          </p>
        </div>
      </section>

      <section class="px-6 py-10 md:py-14">
        <div class="max-w-[1100px] mx-auto">
          <div class="grid gap-3 md:grid-cols-3 mb-8">
            <div class="rounded-2xl border border-slate-100 bg-white p-4 md:p-5 shadow-sm">
              <div class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-1">
                Terminals
              </div>
              <div class="text-sm font-black text-slate-900 leading-snug">{@city.terminals}</div>
            </div>
            <div class="rounded-2xl border border-slate-100 bg-white p-4 md:p-5 shadow-sm">
              <div class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-1">
                Routes available
              </div>
              <div class="text-2xl font-black text-[#FF4C00]">{length(@routes)}</div>
            </div>
            <div class="rounded-2xl border border-slate-100 bg-white p-4 md:p-5 shadow-sm">
              <div class="text-[9px] font-black uppercase tracking-widest text-slate-400 mb-1">
                Payment
              </div>
              <div class="text-sm font-black text-slate-900">M-PESA · Card · Mobile money</div>
            </div>
          </div>

          <div class="rounded-[2rem] border border-slate-100 bg-white p-6 md:p-9 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2 mb-5">
              <div>
                <h2 class="text-xl md:text-2xl font-black tracking-tight">
                  Popular routes from {@city.name}
                </h2>
                <p class="text-[11px] font-bold text-slate-400 mt-1">
                  Live schedules and fares are shown when you search.
                </p>
              </div>
              <a
                href="/"
                class="text-[10px] font-black uppercase tracking-widest text-[#FF4C00] hover:underline whitespace-nowrap"
              >Search all buses</a>
            </div>

            <%= if @routes == [] do %>
              <div class="rounded-2xl bg-slate-50 p-6 text-center">
                <p class="text-sm font-bold text-slate-500">
                  We're updating schedules for {@city.name}. Search your route to see live buses.
                </p>
                <a
                  href="/"
                  class="mt-3 inline-flex rounded-full bg-[#FF4C00] px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-white"
                >Search buses</a>
              </div>
            <% else %>
              <div class="hidden md:block overflow-hidden rounded-xl border border-slate-100">
                <table class="w-full text-left">
                  <thead class="bg-slate-50">
                    <tr class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                      <th class="px-4 py-3">Destination</th>
                      <th class="px-4 py-3">Operators</th>
                      <th class="px-4 py-3">Departures</th>
                      <th class="px-4 py-3">Fare from</th>
                      <th class="px-4 py-3"></th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <%= for route <- @routes do %>
                      <tr class="text-xs font-bold text-slate-600">
                        <td class="px-4 py-3 text-sm font-black text-slate-900">
                          {@city.name} → {route.to}
                        </td>
                        <td class="px-4 py-3">{Enum.join(route.operators, ", ")}</td>
                        <td class="px-4 py-3">{route.count} scheduled</td>
                        <td class="px-4 py-3 font-black text-[#FF4C00]">
                          {if route.min_price, do: "KES #{route.min_price}", else: "Check live"}
                        </td>
                        <td class="px-4 py-3 text-right">
                          <a
                            href={XpressbusWeb.SEO.route_path(@city.name, route.to)}
                            class="inline-flex rounded-full bg-[#FF4C00] px-4 py-2 text-[9px] font-black uppercase tracking-widest text-white hover:bg-[#E64400] transition-colors"
                          >Book</a>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>

              <div class="grid gap-2 md:hidden">
                <%= for route <- @routes do %>
                  <a
                    href={XpressbusWeb.SEO.route_path(@city.name, route.to)}
                    class="flex items-center justify-between gap-3 rounded-xl border border-slate-100 bg-slate-50/50 p-3"
                  >
                    <div>
                      <div class="text-sm font-black text-slate-900">
                        {@city.name} → {route.to}
                      </div>
                      <div class="text-[10px] font-bold text-slate-400">
                        {Enum.join(route.operators, ", ")} · {route.count} scheduled
                      </div>
                    </div>
                    <div class="text-right">
                      <div class="text-xs font-black text-[#FF4C00]">
                        {if route.min_price, do: "KES #{route.min_price}", else: "Live"}
                      </div>
                      <div class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                        Book
                      </div>
                    </div>
                  </a>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_320px] items-start">
            <div class="rounded-[2rem] border border-slate-100 bg-white p-6 md:p-9 shadow-sm">
              <h2 class="text-xl md:text-2xl font-black tracking-tight mb-4">
                Buses from {@city.name} — FAQs
              </h2>
              <div class="divide-y divide-slate-100">
                <%= for faq <- @faqs do %>
                  <details class="group py-4">
                    <summary class="flex cursor-pointer items-center justify-between gap-3 text-sm font-black text-slate-900">
                      {faq.question}
                      <span class="text-[#FF4C00] text-lg leading-none transition-transform group-open:rotate-45">+</span>
                    </summary>
                    <p class="mt-2 text-xs font-semibold leading-relaxed text-slate-500">
                      {faq.answer}
                    </p>
                  </details>
                <% end %>
              </div>
            </div>

            <aside class="space-y-4">
              <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                <h2 class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-3">
                  More cities
                </h2>
                <div class="grid grid-cols-1 gap-1.5">
                  <%= for {slug, other} <- Enum.take(XpressbusWeb.Cities.all(), 6), slug != String.downcase(@city.name) do %>
                    <a
                      href={"/cities/" <> slug}
                      class="flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 text-[11px] font-black text-slate-700 hover:bg-slate-50 hover:text-[#FF4C00] transition-colors"
                    >
                      <span>Buses from {other.name}</span>
                      <span class="material-symbols-outlined !text-sm text-slate-300">arrow_forward</span>
                    </a>
                  <% end %>
                </div>
              </div>

              <%= if @operators != [] do %>
                <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                  <h2 class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-3">
                    Bus operators here
                  </h2>
                  <div class="grid grid-cols-1 gap-1.5">
                    <%= for operator <- @operators do %>
                      <a
                        href={"/operators/" <> operator.slug}
                        class="flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 text-[11px] font-black text-slate-700 hover:bg-slate-50 hover:text-[#FF4C00] transition-colors"
                      >
                        <span>{operator.name}</span>
                        <span class="material-symbols-outlined !text-sm text-slate-300">arrow_forward</span>
                      </a>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <a
                href="/"
                class="block rounded-2xl bg-[#FF4C00] p-5 text-center text-[11px] font-black uppercase tracking-widest text-white shadow-lg shadow-orange-200 hover:bg-[#E64400] transition-colors"
              >
                Search buses
              </a>
            </aside>
          </div>
        </div>
      </section>

      <.main_footer footer_tab={@footer_tab} />
    </main>
  </div>
</Layouts.app>
