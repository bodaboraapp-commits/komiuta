<Layouts.app flash={@flash}>
  <div class="flex min-h-screen bg-[#f8fafc]">
    <.sidebar
      active_tab="agents"
      bus_expanded={@bus_expanded}
      chyllz_expanded={@chyllz_expanded}
      settings_expanded={@settings_expanded}
      collapsed={@sidebar_collapsed}
    />
    <div class={[
      "flex-1 transition-all duration-300",
      if(@sidebar_collapsed, do: "lg:pl-20", else: "lg:pl-72")
    ]}>
      <header class="sticky top-0 z-30 flex h-20 items-center justify-between border-b border-slate-100 bg-white px-8">
        <h2 class="text-xl font-black uppercase tracking-widest text-slate-900">
          Agent Applications
        </h2>

        <div class="flex items-center gap-3">
          <span class="rounded-full bg-orange-50 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-[#FF4C00]">
            {@total_count} total
          </span>

          <div class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-white bg-orange-100 text-xs font-black text-[#FF4C00] shadow-sm">
            AD
          </div>
        </div>
      </header>

      <main class="p-6 md:p-10">
        <div class="mb-8 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div>
            <h1 class="text-3xl font-black uppercase tracking-tighter text-slate-900">
              Agent sign-ups
            </h1>

            <p class="mt-1 text-sm font-bold tracking-wide text-slate-400">
              Applications submitted from the Komiuta Agent PWA.
            </p>
          </div>

          <form
            id="agent-applications-search-form"
            phx-change="search"
            class="flex w-full items-center gap-3 rounded-2xl border border-slate-100 bg-white px-5 py-3 shadow-sm md:w-96"
          >
            <span class="material-symbols-outlined text-slate-300">search</span>
            <input
              type="search"
              name="search"
              value={@search}
              phx-debounce="300"
              placeholder="Search reference, name, email or business"
              class="w-full border-0 p-0 text-sm font-bold text-slate-700 placeholder:text-slate-300 focus:outline-none focus:ring-0"
            />
          </form>
        </div>

        <div class="space-y-4">
          <%= for application <- @applications do %>
            <article
              id={"application-#{application.id}"}
              class={[
                "overflow-hidden rounded-[1.75rem] border bg-white shadow-sm transition",
                MapSet.member?(@expanded_applications, application.id) &&
                  "border-orange-100 shadow-md",
                !MapSet.member?(@expanded_applications, application.id) &&
                  "border-slate-100 hover:border-orange-100 hover:shadow-md"
              ]}
            >
              <button
                type="button"
                phx-click="toggle_application"
                phx-value-id={application.id}
                aria-expanded={to_string(MapSet.member?(@expanded_applications, application.id))}
                class="flex w-full items-center gap-4 p-5 text-left transition hover:bg-slate-50/60 sm:p-6"
              >
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-orange-50 text-[#FF4C00]">
                  <span class="material-symbols-outlined !text-xl">storefront</span>
                </div>

                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2.5">
                    <h2 class="truncate text-base font-black tracking-tight text-slate-900">
                      {application.business_name}
                    </h2>

                    <span class={[
                      "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[9px] font-black uppercase tracking-widest",
                      application.status == "approved" && "bg-emerald-50 text-emerald-700",
                      application.status == "rejected" && "bg-red-50 text-red-600",
                      application.status == "pending" && "bg-amber-50 text-amber-700"
                    ]}>
                      <span class="h-1.5 w-1.5 rounded-full bg-current"></span> {application.status}
                    </span>
                  </div>

                  <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-bold text-slate-500">
                    <span class="inline-flex min-w-0 items-center gap-1.5">
                      <span class="material-symbols-outlined !text-[14px] text-slate-300">person</span>
                      <span class="truncate">{application.full_name}</span>
                    </span>

                    <span class="inline-flex items-center gap-1.5">
                      <span class="material-symbols-outlined !text-[14px] text-slate-300">location_on</span> {application.city}
                    </span>

                    <span class="inline-flex min-w-0 items-center gap-1.5">
                      <span class="material-symbols-outlined !text-[14px] text-slate-300">mail</span>
                      <span class="truncate">{application.email}</span>
                    </span>

                    <span class="inline-flex min-w-0 items-center gap-1.5">
                      <span class="material-symbols-outlined !text-[14px] text-slate-300">directions_bus</span>
                      <span class="truncate">
                        {if application.bus_operator,
                          do: application.bus_operator.name,
                          else: "No bus operator"}
                      </span>
                    </span>
                  </div>
                </div>

                <div class="flex shrink-0 items-center gap-3">
                  <div class="hidden text-right sm:block">
                    <p class="font-mono text-[10px] font-black text-slate-500">
                      Ref {application.reference}
                    </p>

                    <%= if application.inserted_at do %>
                      <p class="mt-0.5 text-[9px] font-bold uppercase tracking-widest text-slate-300">
                        Submitted {Calendar.strftime(application.inserted_at, "%d %b %Y")}
                      </p>
                    <% end %>
                  </div>

                  <span class={[
                    "material-symbols-outlined text-slate-300 transition-transform duration-200",
                    MapSet.member?(@expanded_applications, application.id) && "rotate-180"
                  ]}>
                    expand_more
                  </span>
                </div>
              </button>

              <%= if MapSet.member?(@expanded_applications, application.id) do %>
                <div
                  id={"application-details-#{application.id}"}
                  class="border-t border-slate-100"
                >
                  <div class="flex flex-col gap-5 px-5 pt-5 sm:px-6 lg:flex-row lg:items-start">
                    <div class="grid flex-1 content-start gap-3 sm:grid-cols-2">
                      <div class="rounded-2xl bg-slate-50/80 px-4 py-3">
                        <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                          Contact
                        </p>

                        <div class="mt-1 flex flex-col gap-1 text-xs font-bold text-slate-600">
                          <a
                            href={"tel:" <> application.phone}
                            class="inline-flex items-center gap-1.5 transition hover:text-[#FF4C00]"
                          >
                            <span class="material-symbols-outlined !text-[14px] text-slate-300">call</span> {application.phone}
                          </a>

                          <a
                            href={"mailto:" <> application.email}
                            class="inline-flex min-w-0 items-center gap-1.5 transition hover:text-[#FF4C00]"
                          >
                            <span class="material-symbols-outlined !text-[14px] text-slate-300">mail</span>
                            <span class="truncate">{application.email}</span>
                          </a>

                          <span class="inline-flex items-center gap-1.5">
                            <span class="material-symbols-outlined !text-[14px] text-slate-300">payments</span>
                            Payout: {payout_label(application.payout_method)}
                          </span>
                        </div>
                      </div>

                      <div class="rounded-2xl bg-slate-50/80 px-4 py-3 sm:col-span-2">
                        <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                          Bus operator / partner
                        </p>

                        <form
                          id={"assign-bus-operator-#{application.id}"}
                          phx-submit="assign_bus_operator"
                          class="mt-2 flex flex-col gap-2 sm:flex-row sm:items-center"
                        >
                          <input type="hidden" name="application_id" value={application.id} />

                          <select
                            name="bus_operator_id"
                            class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-xs font-bold text-slate-700 outline-none transition focus:border-[#FF4C00] sm:max-w-xs"
                          >
                            <option value="" selected={is_nil(application.bus_operator_id)}>
                              No bus operator
                            </option>

                            <%= for bus_operator <- @bus_operators do %>
                              <option
                                value={bus_operator.id}
                                selected={bus_operator.id == application.bus_operator_id}
                              >
                                {bus_operator.name}{if !bus_operator.active, do: " (inactive)"}
                              </option>
                            <% end %>
                          </select>

                          <button
                            type="submit"
                            class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-600 transition hover:border-[#FF4C00] hover:text-[#FF4C00]"
                          >
                            <span class="material-symbols-outlined !text-base">link</span>
                            Save bus operator
                          </button>
                        </form>

                        <p class="mt-2 text-[10px] font-bold text-slate-400">
                          <%= if Enum.empty?(@bus_operators) do %>
                            No bus operators yet — add them under Bus → Bus Operator.
                          <% else %>
                            Agents are tied to the bus operator selected here.
                          <% end %>
                        </p>
                      </div>

                      <%= if application.routes do %>
                        <div class="rounded-2xl bg-slate-50/80 px-4 py-3">
                          <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                            Routes
                          </p>

                          <p class="mt-1 text-xs font-bold leading-relaxed text-slate-600">
                            {application.routes}
                          </p>
                        </div>
                      <% end %>

                      <%= if application.notes do %>
                        <div class="rounded-2xl bg-slate-50/80 px-4 py-3">
                          <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                            Agent note
                          </p>

                          <p class="mt-1 text-xs font-bold leading-relaxed text-slate-600">
                            {application.notes}
                          </p>
                        </div>
                      <% end %>

                      <%= if application.admin_notes do %>
                        <div class="rounded-2xl bg-amber-50 px-4 py-3">
                          <p class="text-[9px] font-black uppercase tracking-widest text-amber-500">
                            Admin note
                          </p>

                          <p class="mt-1 text-xs font-bold leading-relaxed text-amber-800">
                            {application.admin_notes}
                          </p>
                        </div>
                      <% end %>
                    </div>

                    <aside class="shrink-0 rounded-2xl border border-slate-100 bg-slate-50/60 p-4 lg:w-72">
                      <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                        Activity
                      </p>

                      <div class="mt-3">
                        <div class="flex gap-3">
                          <div class="flex flex-col items-center">
                            <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-[#FF4C00] ring-4 ring-slate-50"></span>
                            <span class="mt-1 w-px flex-1 bg-slate-200"></span>
                          </div>

                          <div class="min-w-0 pb-5">
                            <p class="text-[11px] font-black text-slate-700">
                              Application submitted
                            </p>

                            <p class="mt-0.5 text-[10px] font-bold text-slate-400">
                              <%= if application.inserted_at do %>
                                {Calendar.strftime(application.inserted_at, "%d %b %Y")}
                              <% end %>
                            </p>

                            <p class="mt-1.5 inline-flex rounded-md border border-slate-100 bg-white px-2 py-0.5 font-mono text-[9px] font-black text-slate-500">
                              Ref {application.reference}
                            </p>
                          </div>
                        </div>

                        <div class="flex gap-3">
                          <span class={[
                            "mt-1 h-2.5 w-2.5 shrink-0 rounded-full ring-4 ring-slate-50",
                            review_dot_class(application.status)
                          ]}></span>

                          <div class="min-w-0">
                            <p class="text-[11px] font-black text-slate-700">
                              {review_title(application)}
                            </p>

                            <p class="mt-0.5 text-[10px] font-bold text-slate-400">
                              <%= if application.reviewed_at do %>
                                {Calendar.strftime(application.reviewed_at, "%d %b %Y, %H:%M")}
                              <% else %>
                                Awaiting review
                              <% end %>
                            </p>
                          </div>
                        </div>
                      </div>
                    </aside>
                  </div>

                  <div
                    id={"application-actions-#{application.id}"}
                    class="mt-5 flex flex-col gap-3 border-t border-slate-50 bg-slate-50/50 px-5 py-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between"
                  >
                    <div class="flex flex-wrap items-center gap-2">
                      <button
                        type="button"
                        phx-click="update_status"
                        phx-value-id={application.id}
                        phx-value-status="approved"
                        class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-600 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-white shadow-sm transition hover:bg-emerald-700"
                      >
                        <span class="material-symbols-outlined !text-base">check</span> Approve
                      </button>

                      <button
                        type="button"
                        phx-click="update_status"
                        phx-value-id={application.id}
                        phx-value-status="pending"
                        class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-500 transition hover:border-amber-200 hover:text-amber-700"
                      >
                        <span class="material-symbols-outlined !text-base">schedule</span> Pending
                      </button>
                    </div>

                    <form
                      id={"reject-agent-#{application.id}"}
                      phx-submit="reject_application"
                      class="flex w-full flex-col gap-1.5 lg:max-w-lg"
                    >
                      <label
                        for={"reject-reason-#{application.id}"}
                        class="text-[9px] font-black uppercase tracking-widest text-slate-400"
                      >
                        Rejection reason (sent to agent)
                      </label>

                      <div class="flex flex-col gap-2 sm:flex-row">
                        <input type="hidden" name="application_id" value={application.id} /> <textarea
                          id={"reject-reason-#{application.id}"}
                          name="reason"
                          rows="1"
                          required
                          placeholder="Why is this application rejected?"
                          class="min-h-10 w-full resize-y rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-[11px] font-bold text-slate-700 outline-none transition placeholder:text-slate-300 focus:border-[#FF4C00] focus:ring-2 focus:ring-orange-100"
                        >{application.admin_notes}</textarea>
                        <button
                          type="submit"
                          class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-xl border border-red-200 bg-white px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-red-600 transition hover:bg-red-50"
                        >
                          <span class="material-symbols-outlined !text-base">close</span> Reject
                        </button>
                      </div>
                    </form>
                  </div>
                </div>
              <% end %>
            </article>
          <% end %>

          <%= if Enum.empty?(@applications) do %>
            <div class="rounded-[2rem] border border-slate-100 bg-white px-6 py-16 text-center">
              <span class="material-symbols-outlined !text-5xl text-slate-200">group</span>
              <p class="mt-4 text-sm font-black text-slate-500">No agent applications yet</p>

              <p class="mt-1 text-xs font-bold text-slate-400">
                Applications from the Agent PWA will appear here.
              </p>
            </div>
          <% end %>
        </div>

        <div class="mt-6 flex items-center justify-between">
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">
            Page {@page} of {@total_pages}
          </p>

          <div class="flex gap-2">
            <button
              type="button"
              phx-click="change_page"
              phx-value-page={@page - 1}
              disabled={@page <= 1}
              class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-[10px] font-black uppercase tracking-widest text-slate-600 disabled:opacity-30"
            >
              Previous
            </button>

            <button
              type="button"
              phx-click="change_page"
              phx-value-page={@page + 1}
              disabled={@page >= @total_pages}
              class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-[10px] font-black uppercase tracking-widest text-slate-600 disabled:opacity-30"
            >
              Next
            </button>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layouts.app>
