<Layouts.app flash={@flash}>
  <div class="flex min-h-screen bg-[#f8fafc]">
    <.sidebar
      active_tab="agents"
      bus_expanded={@bus_expanded}
      chyllz_expanded={@chyllz_expanded}
      settings_expanded={@settings_expanded}
      collapsed={@sidebar_collapsed}
    />

    <div class={[
      "flex-1 transition-all duration-300",
      if(@sidebar_collapsed, do: "lg:pl-20", else: "lg:pl-72")
    ]}>
      <header class="sticky top-0 z-30 flex h-20 items-center justify-between border-b border-slate-100 bg-white px-8">
        <h2 class="text-xl font-black uppercase tracking-widest text-slate-900">
          Agent Applications
        </h2>
        <div class="flex items-center gap-3">
          <span class="rounded-full bg-orange-50 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-[#FF4C00]">
            {@total_count} total
          </span>
          <div class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-white bg-orange-100 text-xs font-black text-[#FF4C00] shadow-sm">
            AD
          </div>
        </div>
      </header>

      <main class="p-6 md:p-10">
        <div class="mb-8 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div>
            <h1 class="text-3xl font-black uppercase tracking-tighter text-slate-900">
              Agent sign-ups
            </h1>
            <p class="mt-1 text-sm font-bold tracking-wide text-slate-400">
              Applications submitted from the Komiuta Agent PWA.
            </p>
          </div>

          <form
            id="agent-applications-search-form"
            phx-change="search"
            class="flex w-full items-center gap-3 rounded-2xl border border-slate-100 bg-white px-5 py-3 shadow-sm md:w-96"
          >
            <span class="material-symbols-outlined text-slate-300">search</span>
            <input
              type="search"
              name="search"
              value={@search}
              phx-debounce="300"
              placeholder="Search reference, name, email or business"
              class="w-full border-0 p-0 text-sm font-bold text-slate-700 placeholder:text-slate-300 focus:outline-none focus:ring-0"
            />
          </form>
        </div>

        <div class="space-y-4">
          <%= for application <- @applications do %>
            <div class="rounded-[2rem] border border-slate-100 bg-white p-6 shadow-sm">
              <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
                <div class="flex items-start gap-4">
                  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-orange-50 text-[#FF4C00]">
                    <span class="material-symbols-outlined !text-2xl">storefront</span>
                  </div>
                  <div>
                    <div class="flex flex-wrap items-center gap-3">
                      <h2 class="text-base font-black text-slate-900">
                        {application.business_name}
                      </h2>
                      <span class={[
                        "rounded-full px-3 py-1 text-[9px] font-black uppercase tracking-widest",
                        application.status == "approved" && "bg-emerald-50 text-emerald-700",
                        application.status == "rejected" && "bg-red-50 text-red-600",
                        application.status == "pending" && "bg-amber-50 text-amber-700"
                      ]}>
                        {application.status}
                      </span>
                    </div>
                    <p class="mt-1 text-xs font-bold text-slate-500">
                      {application.full_name} · {application.city} · {application.phone}
                    </p>
                    <p class="mt-1 text-[11px] font-bold text-slate-400">
                      {application.email} · payout: {application.payout_method}
                    </p>
                    <p class="mt-3 text-[11px] font-bold text-slate-400">
                      Ref: <span class="font-black text-slate-700">{application.reference}</span>
                    </p>
                    <%= if application.routes do %>
                      <p class="mt-1 text-[11px] font-bold text-slate-400">
                        Routes: {application.routes}
                      </p>
                    <% end %>
                    <%= if application.notes do %>
                      <p class="mt-2 rounded-xl bg-slate-50 px-3 py-2 text-[11px] font-bold text-slate-500">
                        {application.notes}
                      </p>
                    <% end %>
                  </div>
                </div>

                <div class="flex shrink-0 flex-wrap gap-2">
                  <button
                    type="button"
                    phx-click="update_status"
                    phx-value-id={application.id}
                    phx-value-status="approved"
                    class="rounded-xl bg-emerald-600 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-emerald-700"
                  >
                    Approve
                  </button>
                  <button
                    type="button"
                    phx-click="update_status"
                    phx-value-id={application.id}
                    phx-value-status="rejected"
                    class="rounded-xl border border-slate-200 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-500 transition hover:border-red-200 hover:text-red-600"
                  >
                    Reject
                  </button>
                  <button
                    type="button"
                    phx-click="update_status"
                    phx-value-id={application.id}
                    phx-value-status="pending"
                    class="rounded-xl border border-slate-200 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-500 transition hover:border-amber-200 hover:text-amber-700"
                  >
                    Pending
                  </button>
                </div>
              </div>
            </div>
          <% end %>

          <%= if Enum.empty?(@applications) do %>
            <div class="rounded-[2rem] border border-slate-100 bg-white px-6 py-16 text-center">
              <span class="material-symbols-outlined !text-5xl text-slate-200">group</span>
              <p class="mt-4 text-sm font-black text-slate-500">No agent applications yet</p>
              <p class="mt-1 text-xs font-bold text-slate-400">
                Applications from the Agent PWA will appear here.
              </p>
            </div>
          <% end %>
        </div>

        <div class="mt-6 flex items-center justify-between">
          <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">
            Page {@page} of {@total_pages}
          </p>
          <div class="flex gap-2">
            <button
              type="button"
              phx-click="change_page"
              phx-value-page={@page - 1}
              disabled={@page <= 1}
              class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-[10px] font-black uppercase tracking-widest text-slate-600 disabled:opacity-30"
            >
              Previous
            </button>
            <button
              type="button"
              phx-click="change_page"
              phx-value-page={@page + 1}
              disabled={@page >= @total_pages}
              class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-[10px] font-black uppercase tracking-widest text-slate-600 disabled:opacity-30"
            >
              Next
            </button>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layouts.app>
