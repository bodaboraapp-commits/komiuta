<Layouts.app flash={@flash}>
  <div class="flex min-h-screen bg-[#f8fafc]">
    <%!-- Sidebar Component --%>
    <.sidebar
      active_tab="operators"
      bus_expanded={@bus_expanded}
      chyllz_expanded={@chyllz_expanded}
      settings_expanded={@settings_expanded}
      collapsed={@sidebar_collapsed}
    />

    <%!-- Main Content Area --%>
    <div class={[
      "flex-1 transition-all duration-300",
      if(@sidebar_collapsed, do: "lg:pl-20", else: "lg:pl-72")
    ]}>
      <%!-- Top Bar --%>
      <header class="h-20 bg-white border-b border-slate-100 flex items-center justify-between px-8 sticky top-0 z-30">
        <h2 class="text-xl font-black text-slate-900 tracking-tight">Bus Operator Management</h2>

        <div class="flex items-center gap-6">
          <button class="w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 hover:text-[#FF4C00] transition-colors relative">
            <span class="material-symbols-outlined">notifications</span>
            <div class="absolute top-2.5 right-2.5 w-2 h-2 bg-[#FF4C00] rounded-full border-2 border-white">
            </div>
          </button>

          <div class="flex items-center gap-3 border-l border-slate-100 pl-6">
            <div class="text-right hidden sm:block">
              <p class="text-[11px] font-black text-slate-900 leading-none">Admin User</p>
              <p class="text-[9px] font-bold text-slate-400 uppercase mt-1">Super Admin</p>
            </div>
            <div class="w-10 h-10 rounded-full bg-orange-100 flex items-center justify-center text-[#FF4C00] font-black text-xs border-2 border-white shadow-sm">
              AD
            </div>
          </div>
        </div>
      </header>

      <%!-- Main Scrollable Content --%>
      <main class="p-8 md:p-12">
        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 overflow-hidden">
          <%!-- Table Controls --%>
          <div class="p-8 flex flex-col md:flex-row justify-between items-center gap-4 border-b border-slate-50">
            <div class="flex items-center gap-3">
              <span class="text-sm font-bold text-slate-400">Show</span>
              <select class="bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 font-bold text-slate-700 outline-none focus:border-orange-500">
                <option>10</option>
                <option>25</option>
                <option>50</option>
              </select>
              <span class="text-sm font-bold text-slate-400">entries</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-sm font-bold text-slate-400">Search:</span>
              <input
                type="text"
                value={@search_query}
                phx-debounce="300"
                phx-change="search"
                class="bg-slate-50 border border-slate-200 rounded-lg px-4 py-1.5 font-bold text-slate-700 outline-none focus:border-orange-500"
              />
            </div>
          </div>

          <%!-- Table --%>
          <div class="overflow-x-auto">
            <table class="w-full text-left">
              <thead>
                <tr class="border-b border-slate-50 bg-white">
                  <th class="px-8 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-[#FF4C00]">
                    SR NO.
                  </th>
                  <th class="px-8 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                    LOGO
                  </th>
                  <th class="px-8 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                    OPERATOR NAME
                  </th>
                  <th class="px-8 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                    CONTACT PERSON
                  </th>
                  <th class="px-8 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                    PHONE
                  </th>
                  <th class="px-8 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                    EMAIL
                  </th>
                  <th class="px-8 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                    STATUS
                  </th>
                  <th class="px-8 py-5 text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">
                    ACTION
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50">
                <%= if Enum.empty?(@bus_operators) do %>
                  <tr>
                    <td colspan="7" class="px-8 py-12 text-center">
                      <span class="material-symbols-outlined text-4xl text-slate-200 mb-4">directions_bus</span>
                      <p class="text-sm font-bold text-slate-400">No bus operators found.</p>
                    </td>
                  </tr>
                <% else %>
                  <%= for {operator, index} <- Enum.with_index(@bus_operators) do %>
                    <tr class="hover:bg-slate-50/50 transition-colors group">
                      <td class="px-8 py-6 text-sm font-bold text-slate-500">{index + 1}</td>
                      <td class="px-8 py-6">
                        <div class="w-10 h-10 bg-white rounded-lg border border-slate-50 shadow-sm flex items-center justify-center overflow-hidden">
                          <%= if operator.logo_url do %>
                            <img
                              src={operator.logo_url}
                              class="h-full w-full object-contain"
                              onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden'); this.nextElementSibling.classList.add('flex');"
                            />
                            <div class={"hidden w-full h-full flex items-center justify-center text-[10px] font-black text-white uppercase #{initials_color(operator.name)}"}>
                              {String.slice(operator.name, 0, 2)}
                            </div>
                          <% else %>
                            <div class={"w-full h-full flex items-center justify-center text-[10px] font-black text-white uppercase #{initials_color(operator.name)}"}>
                              {String.slice(operator.name, 0, 2)}
                            </div>
                          <% end %>
                        </div>
                      </td>
                      <td class="px-8 py-6 text-sm font-black text-slate-900">{operator.name}</td>
                      <td class="px-8 py-6 text-sm font-bold text-slate-500">
                        {operator.contact_person || "—"}
                      </td>
                      <td class="px-8 py-6 text-sm font-bold text-slate-500">
                        {operator.phone || "—"}
                      </td>
                      <td class="px-8 py-6 text-sm font-bold text-slate-500">
                        {operator.email || "—"}
                      </td>
                      <td class="px-8 py-6">
                        <span class={[
                          "inline-flex items-center gap-1.5 text-[11px] font-black uppercase",
                          operator.active && "text-[#00c9a7]",
                          !operator.active && "text-red-500"
                        ]}>
                          <span class={[
                            "w-1.5 h-1.5 rounded-full",
                            operator.active && "bg-[#00c9a7]",
                            !operator.active && "bg-red-500"
                          ]}></span>
                          {if operator.active, do: "Active", else: "Inactive"}
                        </span>
                      </td>
                      <td class="px-8 py-6">
                        <div class="flex items-center gap-2">
                          <button
                            phx-click="edit_operator"
                            phx-value-id={operator.id}
                            class="w-9 h-9 bg-orange-50 rounded-lg flex items-center justify-center text-[#FF4C00] hover:bg-[#FF4C00] hover:text-white transition-all shadow-sm"
                          >
                            <span class="material-symbols-outlined !text-lg">edit_square</span>
                          </button>
                          <button
                            phx-click="delete_operator"
                            phx-value-id={operator.id}
                            class="w-9 h-9 bg-red-50 rounded-lg flex items-center justify-center text-red-500 hover:bg-red-500 hover:text-white transition-all shadow-sm"
                          >
                            <span class="material-symbols-outlined !text-lg">delete</span>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
          <.pager page={@page} page_size={@page_size} total_count={@total_count} />
        </div>
      </main>
    </div>
  </div>

  <%!-- Add/Edit Modal --%>
  <%= if @show_modal do %>
    <div
      class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4"
      phx-click="close_modal"
    >
      <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-lg" phx-click.stop>
        <div class="p-8 border-b border-slate-50">
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-black text-slate-900 tracking-tight">
              {if @editing_operator, do: "Edit Bus Operator", else: "Add Bus Operator"}
            </h3>
            <button
              phx-click="close_modal"
              class="w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 hover:text-slate-700 transition-colors"
            >
              <span class="material-symbols-outlined">close</span>
            </button>
          </div>
        </div>

        <div class="p-8">
          <%= if @error do %>
            <div class="mb-6 bg-red-50 border border-red-100 rounded-2xl p-4">
              <p class="text-sm font-bold text-red-700">{@error}</p>
            </div>
          <% end %>

          <form phx-submit="save_operator" class="space-y-5">
            <div>
              <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Operator Name *</label>
              <input
                type="text"
                name="operator_name"
                value={@operator_name}
                placeholder="Enter operator name"
                class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-orange-500 transition outline-none"
                required
              />
            </div>
            <div>
              <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Contact Person</label>
              <input
                type="text"
                name="contact_person"
                value={@contact_person}
                placeholder="Enter contact person name"
                class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-orange-500 transition outline-none"
              />
            </div>
            <div>
              <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Phone</label>
              <input
                type="text"
                name="phone"
                value={@phone}
                placeholder="Enter phone number"
                class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-orange-500 transition outline-none"
              />
            </div>
            <div>
              <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Email</label>
              <input
                type="email"
                name="email"
                value={@email}
                placeholder="Enter email address"
                class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-orange-500 transition outline-none"
              />
            </div>
            <div>
              <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Logo URL</label>
              <input
                type="text"
                name="logo_url"
                value={@logo_url}
                placeholder="https://example.com/logo.png"
                class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-orange-500 transition outline-none"
              />
            </div>
            <div class="flex items-center gap-3">
              <input type="hidden" name="active" value="false" />
              <input
                type="checkbox"
                name="active"
                checked={@active}
                value="true"
                class="w-5 h-5 rounded border-slate-300 text-[#FF4C00] focus:ring-[#FF4C00]"
              />
              <label class="text-sm font-bold text-slate-700">Active</label>
            </div>

            <div class="flex gap-3 pt-4">
              <button
                type="button"
                phx-click="close_modal"
                class="flex-1 bg-slate-50 text-slate-700 py-4 rounded-2xl font-black text-sm hover:bg-slate-100 transition border border-slate-200"
              >
                Cancel
              </button>
              <button
                type="submit"
                class="flex-1 bg-[#FF4C00] text-white py-4 rounded-2xl font-black text-sm hover:bg-[#E64400] transition shadow-lg shadow-orange-200"
              >
                {if @editing_operator, do: "Update Operator", else: "Add Operator"}
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% end %>

  <%!-- Delete Confirmation Modal --%>
  <%= if @show_delete_modal do %>
    <div
      class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4"
      phx-click="cancel_delete"
    >
      <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-md" phx-click.stop>
        <div class="p-8 text-center">
          <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center text-red-500 mx-auto mb-4">
            <span class="material-symbols-outlined !text-3xl">warning</span>
          </div>
          <h3 class="text-xl font-black text-slate-900 tracking-tight mb-2">
            Delete Bus Operator
          </h3>
          <p class="text-sm font-bold text-slate-400 mb-8">
            Are you sure you want to delete this bus operator? This action cannot be undone.
          </p>

          <div class="flex gap-3">
            <button
              phx-click="cancel_delete"
              class="flex-1 bg-slate-50 text-slate-700 py-4 rounded-2xl font-black text-sm hover:bg-slate-100 transition border border-slate-200"
            >
              Cancel
            </button>
            <button
              phx-click="confirm_delete"
              class="flex-1 bg-red-500 text-white py-4 rounded-2xl font-black text-sm hover:bg-red-600 transition shadow-lg shadow-red-200"
            >
              Delete
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%!-- Floating Add Button --%>
  <button
    phx-click="open_add_modal"
    class="fixed bottom-8 right-8 w-14 h-14 bg-[#FF4C00] text-white rounded-full shadow-lg shadow-orange-200 flex items-center justify-center hover:bg-[#E64400] transition-colors z-40"
  >
    <span class="material-symbols-outlined !text-2xl">add</span>
  </button>
  <%!-- Floating Add Button --%>
  <button
    phx-click="open_add_modal"
    class="fixed bottom-8 right-8 w-14 h-14 bg-[#FF4C00] text-white rounded-full shadow-lg shadow-orange-200 flex items-center justify-center hover:bg-[#E64400] transition-colors z-40"
  >
    <span class="material-symbols-outlined !text-2xl">add</span>
  </button>
</Layouts.app>
