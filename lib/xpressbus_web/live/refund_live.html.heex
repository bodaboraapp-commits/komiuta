<Layouts.app flash={@flash}>
  <.main_header step={@step} current_user={@current_user} />

  <main class="min-h-screen bg-[#f8fafc] px-4 pb-16 pt-[112px] md:px-6">
    <div class="mx-auto max-w-3xl space-y-6">
      <section class="rounded-[2rem] border border-slate-100 bg-white p-6 shadow-sm md:p-8">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.25em] text-[#FF4C00]">
              Refund centre
            </p>
            <h1 class="mt-2 text-2xl font-black tracking-tight text-slate-900 md:text-3xl">
              {if @refund, do: "Track your refund", else: "Need to change your plans?"}
            </h1>
            <p class="mt-2 text-sm font-bold text-slate-400">
              {if @refund,
                do: "Every update on this request is recorded below.",
                else: "Request a refund or keep your journey with travel credit."}
            </p>
          </div>
          <a
            href={if @ticket, do: Xpressbus.TicketAccess.path(@ticket), else: ~p"/tickets"}
            class="rounded-xl border border-slate-200 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-slate-500 hover:text-[#FF4C00]"
          >
            Back to ticket
          </a>
        </div>

        <div :if={@ticket} class="mt-6 grid gap-3 rounded-2xl bg-slate-50 p-4 sm:grid-cols-3">
          <div>
            <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">Ticket</p>
            <p class="mt-1 text-sm font-black text-slate-900">{@ticket.ticket_id}</p>
          </div>
          <div>
            <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">Route</p>
            <p class="mt-1 text-sm font-black text-slate-900">{@ticket.from} → {@ticket.to}</p>
          </div>
          <div>
            <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">
              Amount paid
            </p>
            <p class="mt-1 text-sm font-black text-[#FF4C00]">{@ticket.price}</p>
          </div>
        </div>
      </section>

      <div
        :if={@error}
        class="rounded-2xl border border-red-100 bg-red-50 px-5 py-4 text-sm font-bold text-red-700"
      >
        {@error}
      </div>

      <%= if @refund do %>
        <section class="rounded-[2rem] border border-slate-100 bg-white p-6 shadow-sm md:p-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">
                Current status
              </p>
              <p class="mt-1 text-xl font-black text-slate-900">
                {Xpressbus.Refunds.status_label(@refund.status)}
              </p>
            </div>
            <%= if @refund.credit_code do %>
              <div class="rounded-2xl border border-emerald-100 bg-emerald-50 px-4 py-3">
                <p class="text-[9px] font-black uppercase tracking-widest text-emerald-600">
                  Travel credit
                </p>
                <p class="mt-1 font-mono text-sm font-black text-emerald-800">
                  {@refund.credit_code}
                </p>
              </div>
            <% end %>
          </div>

          <div class="mt-6 grid gap-3 sm:grid-cols-3">
            <div class="rounded-2xl border border-slate-100 p-4">
              <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                Requested
              </p>
              <p class="mt-1 text-sm font-black text-slate-900">KES {@refund.amount}</p>
            </div>
            <div class="rounded-2xl border border-slate-100 p-4">
              <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                Resolution
              </p>
              <p class="mt-1 text-sm font-black text-slate-900">
                {if @refund.resolution == "travel_credit",
                  do: "Travel credit",
                  else: "Original payment"}
              </p>
            </div>
            <div class="rounded-2xl border border-slate-100 p-4">
              <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                Reference
              </p>
              <p class="mt-1 text-sm font-black text-slate-900">{@refund.reference || "—"}</p>
            </div>
          </div>

          <div :if={Xpressbus.Refunds.open?(@refund)} class="mt-6 grid gap-3 md:grid-cols-2">
            <button
              id="accept-travel-credit"
              type="button"
              phx-click="accept_credit"
              class="rounded-2xl bg-emerald-600 px-5 py-4 text-left text-white shadow-lg shadow-emerald-100 transition hover:bg-emerald-700"
            >
              <span class="block text-xs font-black uppercase tracking-widest">Keep exploring with +5% credit</span>
              <span class="mt-1 block text-[11px] font-bold text-emerald-100">Cancel this refund and receive travel credit instead.</span>
            </button>
            <button
              id="keep-booking"
              type="button"
              phx-click="keep_booking"
              class="rounded-2xl border border-slate-200 bg-white px-5 py-4 text-left transition hover:border-[#FF4C00]"
            >
              <span class="block text-xs font-black uppercase tracking-widest text-slate-800">Keep my booking</span>
              <span class="mt-1 block text-[11px] font-bold text-slate-400">Withdraw the request and travel as planned.</span>
            </button>
          </div>

          <div class="mt-8">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">
              Timeline
            </p>
            <ol id="refund-timeline" class="mt-4 space-y-4">
              <li :for={event <- @refund.events} class="flex gap-3">
                <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-[#FF4C00]"></span>
                <div>
                  <p class="text-xs font-black text-slate-900">
                    {Xpressbus.Refunds.status_label(event.status)}
                  </p>
                  <p class="mt-0.5 text-[11px] font-bold text-slate-400">
                    {Calendar.strftime(event.inserted_at, "%d %b %Y, %H:%M")} · {event.actor_type}
                  </p>
                  <p
                    :if={event.note not in [nil, ""]}
                    class="mt-1 text-xs font-bold text-slate-600"
                  >
                    {event.note}
                  </p>
                </div>
              </li>
            </ol>
          </div>
        </section>
      <% else %>
        <section class="rounded-[2rem] border border-slate-100 bg-white p-6 shadow-sm md:p-8">
          <h2 class="text-lg font-black text-slate-900">Request a refund</h2>
          <p class="mt-1 text-xs font-bold text-slate-400">
            Refund eligibility depends on the fare rules and time before departure. Our team reviews every request.
          </p>

          <.form
            for={@form}
            id="refund-request-form"
            phx-submit="request_refund"
            class="mt-6 space-y-4"
          >
            <.input
              field={@form[:amount]}
              type="number"
              label="Refund amount (KES)"
              min="1"
              required
            />
            <.input field={@form[:email]} type="email" label="Email for updates" required />
            <.input
              field={@form[:reason]}
              type="textarea"
              label="What changed?"
              placeholder="Tell us briefly why you need to cancel."
              required
            />
            <button
              id="submit-refund-request"
              type="submit"
              class="w-full rounded-2xl bg-[#FF4C00] px-5 py-4 text-xs font-black uppercase tracking-widest text-white shadow-lg shadow-orange-100 transition hover:bg-[#E64400]"
            >
              Submit refund request
            </button>
          </.form>

          <div class="mt-6 rounded-2xl border border-emerald-100 bg-emerald-50 p-4">
            <p class="text-xs font-black text-emerald-900">Prefer not to cancel?</p>
            <p class="mt-1 text-[11px] font-bold leading-relaxed text-emerald-700">
              Once your request is open you can choose +5% travel credit or keep your booking from the tracking page.
            </p>
          </div>
        </section>
      <% end %>
    </div>
  </main>
</Layouts.app>
