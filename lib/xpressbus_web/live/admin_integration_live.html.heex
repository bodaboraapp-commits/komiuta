<Layouts.app flash={@flash}>
  <div class="flex min-h-screen bg-[#f8fafc]">
    <.sidebar
      active_tab={@active_tab}
      bus_expanded={@bus_expanded}
      chyllz_expanded={@chyllz_expanded}
      settings_expanded={@settings_expanded}
      collapsed={@sidebar_collapsed}
    />

    <div class={[
      "flex-1 transition-all duration-300",
      if(@sidebar_collapsed, do: "lg:pl-20", else: "lg:pl-72")
    ]}>
      <header class="h-20 bg-gradient-to-r from-orange-50 to-white border-b border-slate-100 flex items-center justify-between px-8 sticky top-0 z-30">
        <h2 class="text-xl font-black text-slate-900 tracking-tight uppercase tracking-widest">
          System Integrations
        </h2>

        <div class="flex items-center gap-6">
          <button class="w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 hover:text-[#FF4C00] transition-colors relative">
            <span class="material-symbols-outlined">notifications</span>
            <div class="absolute top-2.5 right-2.5 w-2 h-2 bg-[#FF4C00] rounded-full border-2 border-white">
            </div>
          </button>

          <div class="flex items-center gap-4 border-l border-slate-100 pl-6">
            <div class="text-right hidden sm:block">
              <p class="text-[11px] font-black text-slate-900 leading-none">Admin User</p>
              <p class="text-[9px] font-bold text-slate-400 uppercase mt-1">Super Admin</p>
            </div>
            <div class="w-10 h-10 rounded-full bg-orange-100 flex items-center justify-center text-[#FF4C00] font-black text-xs border-2 border-white shadow-sm">
              AD
            </div>
          </div>
        </div>
      </header>

      <main class="p-6 md:p-10">
        <div class="bg-white rounded-[2.5rem] shadow-sm border border-slate-100 overflow-hidden">
          <div class="p-6 md:p-10">
            <%!-- Provider Tabs --%>
            <div class="flex flex-wrap gap-2 sm:gap-4 mb-4 border-b border-slate-50">
              <%= for {provider_key, provider_info} <- @providers do %>
                <button
                  phx-click="switch_provider"
                  phx-value-provider={provider_key}
                  class={[
                    "px-8 py-5 text-xs font-black transition-all border-b-4 -mb-px uppercase tracking-widest",
                    @current_provider == provider_key && "border-[#FF4C00] text-[#FF4C00]",
                    @current_provider != provider_key &&
                      "border-transparent text-slate-400 hover:text-slate-600"
                  ]}
                >
                  <span class="material-symbols-outlined text-lg mr-2 align-middle">{provider_info.icon}</span>
                  {provider_info.label}
                </button>
              <% end %>
            </div>

            <%!-- User Login Method --%>
            <%= if @current_provider == "user_login" do %>
              <% selected_method = @login_method_choice %>
              <div class="animate-fade-in-up space-y-8">
                <form
                  id="user-login-method-form"
                  phx-submit="save"
                  phx-change="select_login_method"
                  class="space-y-8"
                >
                  <input type="hidden" name="provider" value="user_login" />

                  <div>
                    <h4 class="font-black text-slate-900 text-sm uppercase tracking-widest">
                      Traveller login method
                    </h4>
                    <p class="text-[11px] font-bold text-slate-400 mt-1">
                      Choose how travellers sign in to their Komiuta accounts. Google sign-in remains available on all options.
                    </p>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <%= for {value, label, description, icon} <- [
                      {"email", "Email code", "Sends a 6-digit login code to the account email address.", "mail"},
                      {"sms", "SMS code", "Sends a one-time code to the account phone via Firebase SMS.", "sms"},
                      {"both", "Email or SMS", "Travellers can choose either email or SMS at login.", "login"}
                    ] do %>
                      <label class={[
                        "relative cursor-pointer rounded-[1.5rem] border-2 p-5 transition-all",
                        selected_method == value && "border-[#FF4C00] bg-orange-50/60 shadow-sm",
                        selected_method != value &&
                          "border-slate-100 bg-white hover:border-slate-200"
                      ]}>
                        <input
                          type="radio"
                          name="config[method]"
                          value={value}
                          checked={selected_method == value}
                          class="sr-only"
                        />
                        <span class="material-symbols-outlined !text-2xl text-[#FF4C00]">{icon}</span>
                        <span class="mt-3 block text-sm font-black text-slate-900">{label}</span>
                        <span class="mt-1 block text-[10px] font-bold text-slate-400 leading-relaxed">{description}</span>
                        <%= if selected_method == value do %>
                          <span class="material-symbols-outlined absolute top-4 right-4 !text-lg text-[#FF4C00]">check_circle</span>
                        <% end %>
                      </label>
                    <% end %>
                  </div>

                  <%= if selected_method in ["sms", "both"] do %>
                    <%= if @firebase_config do %>
                      <div class="rounded-[1.5rem] bg-emerald-50 border border-emerald-100 p-5">
                        <p class="text-[11px] font-bold text-emerald-800">
                          Firebase SMS is configured for project <strong>{@firebase_config.project_id}</strong>.
                          Phone sign-in must be enabled and the Blaze billing plan active in the Firebase Console for SMS to send.
                        </p>
                      </div>
                    <% else %>
                      <div class="rounded-[1.5rem] bg-amber-50 border border-amber-100 p-5">
                        <p class="text-[11px] font-bold text-amber-800">
                          Firebase SMS isn't configured yet, so choosing SMS will fall back to email login until it is set up.
                        </p>
                      </div>
                    <% end %>
                  <% end %>

                  <div class="pt-2 flex flex-wrap gap-4">
                    <button
                      type="submit"
                      class="flex-1 min-w-[220px] bg-[#FF4C00] text-white py-4 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-orange-100 hover:bg-[#E64400] transition-all transform active:scale-95"
                    >
                      Save Login Setting
                    </button>
                    <button
                      type="button"
                      phx-click="switch_provider"
                      phx-value-provider="firebase"
                      class="px-8 bg-slate-900 text-white py-4 rounded-[1.5rem] font-black text-xs uppercase tracking-widest shadow-xl shadow-slate-200 hover:bg-black transition-all"
                    >
                      Firebase SMS Settings
                    </button>
                  </div>
                </form>
              </div>
            <% end %>

            <%!-- MPESA Integration Form --%>
            <%= if @current_provider == "mpesa" do %>
              <% mpesa_config = provider_config(@settings, "mpesa") %>
              <div class="animate-fade-in-up">
                <form phx-submit="save" class="space-y-6">
                  <input type="hidden" name="provider" value="mpesa" />

                  <div class="flex items-center justify-between p-4 bg-slate-50 rounded-[2rem] border border-slate-100">
                    <div>
                      <h4 class="font-black text-slate-900 text-sm uppercase tracking-widest">
                        Active Status
                      </h4>
                      <p class="text-[11px] font-bold text-slate-400">
                        Toggle M-PESA payment availability during checkout
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input
                        type="checkbox"
                        phx-click="toggle_active"
                        phx-value-provider="mpesa"
                        checked={Map.get(@settings["mpesa"], :active, true)}
                        class="sr-only peer"
                      />
                      <div class="relative w-20 h-9 bg-[#FF4C00] peer-focus:outline-none rounded-full peer-checked:after:translate-x-[3rem] peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-7 after:w-7 after:transition-all peer-checked:bg-green-500">
                        <span class={[
                          "absolute inset-0 flex items-center justify-end pr-3 text-[11px] font-black uppercase tracking-wider text-white transition-opacity duration-200 z-10 drop-shadow-sm",
                          if(Map.get(@settings["mpesa"], :active, true), do: "opacity-0")
                        ]}>OFF</span>
                        <span class={[
                          "absolute inset-0 flex items-center justify-start pl-3 text-[11px] font-black uppercase tracking-wider text-white transition-opacity duration-200 opacity-0 z-10 drop-shadow-sm",
                          if(Map.get(@settings["mpesa"], :active, true), do: "opacity-100")
                        ]}>ON</span>
                      </div>
                    </label>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6">
                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Environment Mode</label>
                      <select
                        name="config[mode]"
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all appearance-none cursor-pointer"
                      >
                        <option value="sandbox" selected={mpesa_config["mode"] == "sandbox"}>
                          Sandbox / Test
                        </option>
                        <option value="production" selected={mpesa_config["mode"] == "production"}>
                          Live Production
                        </option>
                      </select>
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Service Type</label>
                      <select
                        name="config[type]"
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all appearance-none cursor-pointer"
                      >
                        <option value="paybill" selected={mpesa_config["type"] == "paybill"}>
                          Lipa Na M-PESA Paybill
                        </option>
                        <option value="till" selected={mpesa_config["type"] == "till"}>
                          Lipa Na M-PESA Buy Goods (Till)
                        </option>
                      </select>
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Short Code / Till Number</label>
                      <input
                        type="text"
                        name="config[business_shortcode]"
                        value={mpesa_config["business_shortcode"]}
                        placeholder="e.g. 174379"
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                        required
                      />
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Party B / Store Number (Buy Goods)</label>
                      <input
                        type="text"
                        name="config[party_b]"
                        value={mpesa_config["party_b"]}
                        placeholder="e.g. 5145977 (leave blank for Paybill)"
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                      />
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Initiator Name (HQ/HO)</label>
                      <input
                        type="text"
                        name="config[initiator_name]"
                        value={mpesa_config["initiator_name"]}
                        placeholder="Business Initiator"
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                      />
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Consumer Key</label>
                      <input
                        type="password"
                        name="config[consumer_key]"
                        value={mpesa_config["consumer_key"]}
                        placeholder="Daraja API Consumer Key"
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                        required
                      />
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Consumer Secret</label>
                      <input
                        type="password"
                        name="config[consumer_secret]"
                        value={mpesa_config["consumer_secret"]}
                        placeholder="Daraja API Consumer Secret"
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                        required
                      />
                    </div>

                    <div class="md:col-span-2">
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Passkey (Online Checkout)</label>
                      <input
                        type="password"
                        name="config[passkey]"
                        value={mpesa_config["passkey"]}
                        placeholder="bfb279f9aa9bdbcf158e97dd71a467cd2..."
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                      />
                    </div>

                    <div class="md:col-span-2">
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Callback URL (Webhook)</label>
                      <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-300">link</span>
                        <input
                          type="url"
                          name="config[callback_url]"
                          value={mpesa_config["callback_url"]}
                          placeholder="https://api.komiuta.com/v1/payments/mpesa/callback"
                          class="w-full pl-12 pr-3 py-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                          required
                        />
                      </div>
                    </div>
                  </div>

                  <div class="pt-6 flex gap-4">
                    <button
                      type="submit"
                      class="flex-1 bg-[#FF4C00] text-white py-5 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-orange-100 hover:bg-[#E64400] transition-all transform active:scale-95"
                    >
                      Update M-PESA Link
                    </button>
                    <button
                      type="button"
                      phx-click="test_connection"
                      class="px-10 bg-slate-900 text-white py-5 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-slate-200 hover:bg-black transition-all"
                    >
                      Test API
                    </button>
                  </div>
                </form>
              </div>
            <% end %>

            <%!-- Flutterwave Integration Form --%>
            <%= if @current_provider == "flutterwave" do %>
              <% flutterwave_config = provider_config(@settings, "flutterwave") %>
              <div class="animate-fade-in-up">
                <form phx-submit="save" class="space-y-6">
                  <input type="hidden" name="provider" value="flutterwave" />

                  <div class="flex items-center justify-between p-4 bg-slate-50 rounded-[2rem] border border-slate-100">
                    <div>
                      <h4 class="font-black text-slate-900 text-sm uppercase tracking-widest">
                        Active Status
                      </h4>
                      <p class="text-[11px] font-bold text-slate-400">
                        Toggle Flutterwave card payments during checkout
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input
                        type="checkbox"
                        phx-click="toggle_active"
                        phx-value-provider="flutterwave"
                        checked={Map.get(@settings["flutterwave"], :active, true)}
                        class="sr-only peer"
                      />
                      <div class="relative w-20 h-9 bg-[#FF4C00] peer-focus:outline-none rounded-full peer-checked:after:translate-x-[3rem] peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-7 after:w-7 after:transition-all peer-checked:bg-green-500">
                        <span class={[
                          "absolute inset-0 flex items-center justify-end pr-3 text-[11px] font-black uppercase tracking-wider text-white transition-opacity duration-200 z-10 drop-shadow-sm",
                          if(Map.get(@settings["flutterwave"], :active, true), do: "opacity-0")
                        ]}>OFF</span>
                        <span class={[
                          "absolute inset-0 flex items-center justify-start pl-3 text-[11px] font-black uppercase tracking-wider text-white transition-opacity duration-200 opacity-0 z-10 drop-shadow-sm",
                          if(Map.get(@settings["flutterwave"], :active, true), do: "opacity-100")
                        ]}>ON</span>
                      </div>
                    </label>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6">
                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Environment</label>
                      <select
                        name="config[environment]"
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all appearance-none cursor-pointer"
                      >
                        <option
                          value="sandbox"
                          selected={flutterwave_config["environment"] != "production"}
                        >
                          Sandbox / Test
                        </option>
                        <option
                          value="production"
                          selected={flutterwave_config["environment"] == "production"}
                        >
                          Live Production
                        </option>
                      </select>
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Public Key</label>
                      <input
                        type="text"
                        name="config[public_key]"
                        value={flutterwave_config["public_key"]}
                        placeholder="FLWPUBK-..."
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                        required
                      />
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Secret Key</label>
                      <input
                        type="password"
                        name="config[secret_key]"
                        value={flutterwave_config["secret_key"]}
                        placeholder="FLWSECK-..."
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                        required
                      />
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Encryption Key</label>
                      <input
                        type="text"
                        name="config[encryption_key]"
                        value={flutterwave_config["encryption_key"]}
                        placeholder="FLWSECK_TEST-..."
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                      />
                    </div>

                    <div class="md:col-span-2">
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Callback URL</label>
                      <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-300">link</span>
                        <input
                          type="url"
                          name="config[callback_url]"
                          value={flutterwave_config["callback_url"]}
                          placeholder="https://api.komiuta.com/v1/payments/flutterwave/callback"
                          class="w-full pl-12 pr-3 py-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                          required
                        />
                      </div>
                    </div>

                    <div class="md:col-span-2">
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Webhook URL</label>
                      <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-300">webhook</span>
                        <input
                          type="url"
                          name="config[webhook_url]"
                          value={flutterwave_config["webhook_url"]}
                          placeholder="https://api.komiuta.com/v1/payments/flutterwave/webhook"
                          class="w-full pl-12 pr-3 py-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                        />
                      </div>
                    </div>
                  </div>

                  <div class="pt-6 flex gap-4">
                    <button
                      type="submit"
                      class="flex-1 bg-[#FF4C00] text-white py-5 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-orange-100 hover:bg-[#E64400] transition-all transform active:scale-95"
                    >
                      Update Flutterwave Link
                    </button>
                    <button
                      type="button"
                      phx-click="test_connection"
                      class="px-10 bg-slate-900 text-white py-5 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-slate-200 hover:bg-black transition-all"
                    >
                      Test API
                    </button>
                  </div>
                </form>
              </div>
            <% end %>

            <%!-- Paystack Integration Form --%>
            <%= if @current_provider == "paystack" do %>
              <% paystack_config = provider_config(@settings, "paystack") %>
              <div class="animate-fade-in-up">
                <form phx-submit="save" class="space-y-6">
                  <input type="hidden" name="provider" value="paystack" />

                  <div class="flex items-center justify-between p-4 bg-slate-50 rounded-[2rem] border border-slate-100">
                    <div>
                      <h4 class="font-black text-slate-900 text-sm uppercase tracking-widest">
                        Active Status
                      </h4>
                      <p class="text-[11px] font-bold text-slate-400">
                        Toggle Paystack card payments during checkout
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input
                        type="checkbox"
                        phx-click="toggle_active"
                        phx-value-provider="paystack"
                        checked={Map.get(@settings["paystack"], :active, true)}
                        class="sr-only peer"
                      />
                      <div class="relative w-20 h-9 bg-[#FF4C00] peer-focus:outline-none rounded-full peer-checked:after:translate-x-[3rem] peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-7 after:w-7 after:transition-all peer-checked:bg-green-500">
                        <span class={[
                          "absolute inset-0 flex items-center justify-end pr-3 text-[11px] font-black uppercase tracking-wider text-white transition-opacity duration-200 z-10 drop-shadow-sm",
                          if(Map.get(@settings["paystack"], :active, true), do: "opacity-0")
                        ]}>OFF</span>
                        <span class={[
                          "absolute inset-0 flex items-center justify-start pl-3 text-[11px] font-black uppercase tracking-wider text-white transition-opacity duration-200 opacity-0 z-10 drop-shadow-sm",
                          if(Map.get(@settings["paystack"], :active, true), do: "opacity-100")
                        ]}>ON</span>
                      </div>
                    </label>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6">
                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Environment</label>
                      <select
                        name="config[environment]"
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all appearance-none cursor-pointer"
                      >
                        <option
                          value="sandbox"
                          selected={paystack_config["environment"] != "production"}
                        >
                          Sandbox / Test
                        </option>
                        <option
                          value="production"
                          selected={paystack_config["environment"] == "production"}
                        >
                          Live Production
                        </option>
                      </select>
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Public Key</label>
                      <input
                        type="text"
                        name="config[public_key]"
                        value={paystack_config["public_key"]}
                        placeholder="pk_test_..."
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                        required
                      />
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Secret Key</label>
                      <input
                        type="password"
                        name="config[secret_key]"
                        value={paystack_config["secret_key"]}
                        placeholder="sk_test_..."
                        class="w-full p-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                        required
                      />
                    </div>

                    <div class="md:col-span-2">
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Callback URL</label>
                      <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-300">link</span>
                        <input
                          type="url"
                          name="config[callback_url]"
                          value={paystack_config["callback_url"]}
                          placeholder="https://api.komiuta.com/v1/payments/paystack/callback"
                          class="w-full pl-12 pr-3 py-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                          required
                        />
                      </div>
                    </div>

                    <div class="md:col-span-2">
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Webhook URL</label>
                      <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-300">webhook</span>
                        <input
                          type="url"
                          name="config[webhook_url]"
                          value={paystack_config["webhook_url"]}
                          placeholder="https://api.komiuta.com/v1/payments/paystack/webhook"
                          class="w-full pl-12 pr-3 py-3 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                        />
                      </div>
                    </div>
                  </div>

                  <div class="pt-6 flex gap-4">
                    <button
                      type="submit"
                      class="flex-1 bg-[#FF4C00] text-white py-5 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-orange-100 hover:bg-[#E64400] transition-all transform active:scale-95"
                    >
                      Update Paystack Link
                    </button>
                    <button
                      type="button"
                      phx-click="test_connection"
                      class="px-10 bg-slate-900 text-white py-5 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-slate-200 hover:bg-black transition-all"
                    >
                      Test API
                    </button>
                  </div>
                </form>
              </div>
            <% end %>

            <%!-- Google Integration Form --%>
            <%= if @current_provider == "google" do %>
              <% google_config = provider_config(@settings, "google") %>
              <div class="animate-fade-in-up">
                <form phx-submit="save" class="space-y-8">
                  <input type="hidden" name="provider" value="google" />

                  <div class="flex items-center justify-between p-6 bg-slate-50 rounded-[2rem] border border-slate-100">
                    <div>
                      <h4 class="font-black text-slate-900 text-sm uppercase tracking-widest">
                        OAuth Status
                      </h4>
                      <p class="text-[11px] font-bold text-slate-400">
                        Enable or disable Google Sign-In for travelers
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input
                        type="checkbox"
                        phx-click="toggle_active"
                        phx-value-provider="google"
                        checked={Map.get(@settings["google"], :active, true)}
                        class="sr-only peer"
                      />
                      <div class="relative w-20 h-9 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-[3rem] peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-7 after:w-7 after:transition-all peer-checked:bg-[#FF4C00]">
                        <span class="absolute inset-0 flex items-center justify-between px-2 pointer-events-none">
                          <span class="text-[11px] font-black uppercase tracking-wider text-white opacity-0 peer-checked:opacity-100 transition-opacity">OFF</span>
                          <span class="text-[11px] font-black uppercase tracking-wider text-white opacity-100 peer-checked:opacity-0 transition-opacity">ON</span>
                        </span>
                      </div>
                    </label>
                  </div>

                  <div class="grid grid-cols-1 gap-y-12">
                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Client ID</label>
                      <input
                        type="text"
                        name="config[client_id]"
                        value={google_config["client_id"]}
                        placeholder="your-app-id.apps.googleusercontent.com"
                        class="w-full p-4 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                        required
                      />
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Client Secret</label>
                      <input
                        type="password"
                        name="config[client_secret]"
                        value={google_config["client_secret"]}
                        placeholder="Enter Google OAuth Client Secret"
                        class="w-full p-4 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                        required
                      />
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">Authorized Redirect URI</label>
                      <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-300">link</span>
                        <input
                          type="url"
                          name="config[redirect_uri]"
                          value={google_config["redirect_uri"]}
                          placeholder="https://yourdomain.com/auth/google/callback"
                          class="w-full pl-12 pr-4 py-4 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                          required
                        />
                      </div>
                    </div>
                  </div>

                  <div class="pt-8 flex gap-4">
                    <button
                      type="submit"
                      class="flex-1 bg-[#FF4C00] text-white py-5 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-orange-100 hover:bg-[#E64400] transition-all transform active:scale-95"
                    >
                      Update Google Auth Link
                    </button>
                    <button
                      type="button"
                      phx-click="test_connection"
                      class="px-10 bg-slate-900 text-white py-5 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-slate-200 hover:bg-black transition-all"
                    >
                      Test API
                    </button>
                  </div>
                </form>
              </div>
            <% end %>

            <%!-- Firebase Phone Auth (SMS OTP) Integration --%>
            <%= if @current_provider == "firebase" do %>
              <div class="animate-fade-in-up space-y-8">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-6 bg-slate-50 rounded-[2rem] border border-slate-100">
                  <div>
                    <h4 class="font-black text-slate-900 text-sm uppercase tracking-widest">
                      Firebase Phone Authentication
                    </h4>
                    <p class="text-[11px] font-bold text-slate-400 mt-1">
                      Sends SMS one-time codes from the user login page. Email OTP remains the fallback.
                    </p>
                  </div>
                  <span class={[
                    "inline-flex items-center gap-2 px-4 py-2 rounded-full text-[10px] font-black uppercase tracking-widest",
                    @firebase_config &&
                      "bg-emerald-50 text-emerald-700 border border-emerald-100",
                    is_nil(@firebase_config) &&
                      "bg-amber-50 text-amber-700 border border-amber-100"
                  ]}>
                    <span class={[
                      "w-2 h-2 rounded-full",
                      @firebase_config && "bg-emerald-500",
                      is_nil(@firebase_config) && "bg-amber-500"
                    ]}></span>
                    {if @firebase_config, do: "Configured", else: "Not configured"}
                  </span>
                </div>

                <%= if @firebase_config do %>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-[0.2em]">Project ID</label>
                      <div class="p-4 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700">
                        {@firebase_config.project_id}
                      </div>
                    </div>
                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-[0.2em]">Auth Domain</label>
                      <div class="p-4 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700">
                        {@firebase_config.auth_domain}
                      </div>
                    </div>
                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-[0.2em]">Web App ID</label>
                      <div class="p-4 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 break-all">
                        {@firebase_config.app_id}
                      </div>
                    </div>
                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-[0.2em]">Web API Key</label>
                      <div class="p-4 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700">
                        {String.slice(@firebase_config.api_key, 0, 8)}…{String.slice(
                          @firebase_config.api_key,
                          -4,
                          4
                        )}
                      </div>
                    </div>
                  </div>

                  <div class="rounded-[1.5rem] bg-orange-50 border border-orange-100 p-6">
                    <h4 class="text-xs font-black text-slate-900 uppercase tracking-widest mb-3">
                      Firebase Console checklist
                    </h4>
                    <ul class="space-y-2 text-[11px] font-bold text-slate-600">
                      <li class="flex gap-2">
                        <span class="material-symbols-outlined !text-base text-[#FF4C00]">check_circle</span>
                        Enable <strong>Authentication → Sign-in method → Phone</strong>.
                      </li>
                      <li class="flex gap-2">
                        <span class="material-symbols-outlined !text-base text-[#FF4C00]">check_circle</span>
                        Add authorized domains <strong>www.komiuta.com</strong>,
                        <strong>komiuta.com</strong>
                        and <strong>localhost</strong>.
                      </li>
                      <li class="flex gap-2">
                        <span class="material-symbols-outlined !text-base text-[#FF4C00]">check_circle</span>
                        Allow the Kenya (+254) SMS region. Firebase may require the Blaze plan for production SMS volume.
                      </li>
                      <li class="flex gap-2">
                        <span class="material-symbols-outlined !text-base text-[#FF4C00]">check_circle</span>
                        Only existing Komiuta accounts can use SMS login; new users must sign up with email first.
                      </li>
                    </ul>
                    <a
                      href="https://console.firebase.google.com/project/komiuta/authentication/providers"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-4 inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-[#FF4C00] hover:underline"
                    >
                      Open Firebase Console
                      <span class="material-symbols-outlined !text-sm">open_in_new</span>
                    </a>
                  </div>

                  <div class="pt-2 flex gap-4">
                    <button
                      type="button"
                      phx-click="test_connection"
                      class="px-10 bg-slate-900 text-white py-4 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-slate-200 hover:bg-black transition-all"
                    >
                      Check Firebase Configuration
                    </button>
                  </div>
                <% else %>
                  <div class="rounded-[1.5rem] bg-amber-50 border border-amber-100 p-6">
                    <p class="text-sm font-bold text-slate-700">
                      Firebase Phone Auth is not configured. Add the Firebase web config as
                      <code class="font-black">FIREBASE_*</code>
                      environment variables (or in <code class="font-black">config/config.exs</code>), then redeploy.
                    </p>
                    <p class="mt-3 text-[11px] font-bold text-slate-500">
                      Required values: API key, auth domain, project ID, app ID and messaging sender ID.
                    </p>
                  </div>
                <% end %>
              </div>
            <% end %>
            <%!-- WeatherAPI (Chyllz weather) Integration --%>
            <%= if @current_provider == "weather_api" do %>
              <% weather_config = provider_config(@settings, "weather_api") %>
              <% weather_key = Map.get(weather_config, "api_key") %>
              <% weather_connected = is_binary(weather_key) and String.trim(weather_key) != "" %>
              <div class="animate-fade-in-up space-y-8">
                <form id="weather-api-form" phx-submit="save" class="space-y-8">
                  <input type="hidden" name="provider" value="weather_api" />

                  <div class="flex items-center justify-between p-4 bg-slate-50 rounded-[2rem] border border-slate-100">
                    <div>
                      <h4 class="font-black text-slate-900 text-sm uppercase tracking-widest">
                        WeatherAPI Configuration
                      </h4>
                      <p class="text-[11px] font-bold text-slate-400">
                        Live current conditions and forecast for the Chyllz account page
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input
                        type="checkbox"
                        phx-click="toggle_active"
                        phx-value-provider="weather_api"
                        checked={Map.get(@settings["weather_api"], :active, true)}
                        class="sr-only peer"
                      />
                      <div class="relative w-20 h-9 bg-[#FF4C00] peer-focus:outline-none rounded-full peer-checked:after:translate-x-[3rem] peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-7 after:w-7 after:transition-all peer-checked:bg-green-500">
                        <span class={[
                          "absolute inset-0 flex items-center justify-end pr-3 text-[11px] font-black uppercase tracking-wider text-white transition-opacity duration-200 z-10 drop-shadow-sm",
                          if(Map.get(@settings["weather_api"], :active, true), do: "opacity-0")
                        ]}>OFF</span>
                        <span class={[
                          "absolute inset-0 flex items-center justify-start pl-3 text-[11px] font-black uppercase tracking-wider text-white transition-opacity duration-200 opacity-0 z-10 drop-shadow-sm",
                          if(Map.get(@settings["weather_api"], :active, true), do: "opacity-100")
                        ]}>ON</span>
                      </div>
                    </label>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6">
                    <div class="md:col-span-2">
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">API Key</label>
                      <input
                        type="password"
                        name="config[api_key]"
                        value={weather_config["api_key"]}
                        placeholder="Paste your WeatherAPI.com API key"
                        class="w-full p-4 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                      />
                      <p class="mt-3 text-[10px] font-bold leading-relaxed text-slate-400">
                        Create a free key at
                        <a
                          href="https://www.weatherapi.com/my/"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-black text-[#FF4C00] hover:underline"
                        >weatherapi.com</a>
                        and paste it here. The key stays in the integrations table and is never rendered on the public site.
                      </p>
                    </div>
                  </div>

                  <span class={[
                    "inline-flex items-center gap-2 rounded-full px-4 py-2 text-[10px] font-black uppercase tracking-widest",
                    weather_connected &&
                      "bg-emerald-50 text-emerald-700 border border-emerald-100",
                    !weather_connected &&
                      "bg-amber-50 text-amber-700 border border-amber-100"
                  ]}>
                    <span class={[
                      "w-2 h-2 rounded-full",
                      weather_connected && "bg-emerald-500",
                      !weather_connected && "bg-amber-500"
                    ]}></span>
                    {if weather_connected,
                      do: "WeatherAPI connected to Chyllz",
                      else: "Chyllz is using the free Open-Meteo fallback"}
                  </span>

                  <div class="rounded-[1.5rem] bg-orange-50 border border-orange-100 p-6">
                    <h4 class="text-xs font-black text-slate-900 uppercase tracking-widest mb-2">
                      How Chyllz uses this
                    </h4>
                    <p class="text-[11px] font-bold leading-relaxed text-slate-600">
                      When this integration is ON and has a key, the Chyllz weather card loads live conditions and the 3-day forecast
                      from WeatherAPI.com. If the key is missing, the integration is OFF, or WeatherAPI is unreachable, Chyllz
                      automatically falls back to Open-Meteo so travellers always see weather. Saving a key clears the cached
                      forecasts immediately.
                    </p>
                  </div>

                  <div class="pt-2 flex flex-wrap gap-4">
                    <button
                      type="submit"
                      class="flex-1 min-w-[220px] bg-[#FF4C00] text-white py-5 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-orange-100 hover:bg-[#E64400] transition-all transform active:scale-95"
                    >
                      Update WeatherAPI Link
                    </button>
                    <button
                      type="button"
                      phx-click="test_connection"
                      class="px-10 bg-slate-900 text-white py-5 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-slate-200 hover:bg-black transition-all"
                    >
                      Test API
                    </button>
                  </div>
                </form>
              </div>
            <% end %>

            <%!-- Google Maps Platform Integration --%>
            <%= if @current_provider == "google_maps" do %>
              <% maps_config = provider_config(@settings, "google_maps") %>
              <% maps_key = Map.get(maps_config, "api_key") %>
              <% maps_connected = is_binary(maps_key) and String.trim(maps_key) != "" %>
              <div class="animate-fade-in-up space-y-8">
                <form id="google-maps-form" phx-submit="save" class="space-y-8">
                  <input type="hidden" name="provider" value="google_maps" />

                  <div class="flex items-center justify-between p-4 bg-slate-50 rounded-[2rem] border border-slate-100">
                    <div>
                      <h4 class="font-black text-slate-900 text-sm uppercase tracking-widest">
                        Google Maps Configuration
                      </h4>
                      <p class="text-[11px] font-bold text-slate-400">
                        Maps, places and route geocoding for the Komiuta platform
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input
                        type="checkbox"
                        phx-click="toggle_active"
                        phx-value-provider="google_maps"
                        checked={Map.get(@settings["google_maps"], :active, true)}
                        class="sr-only peer"
                      />
                      <div class="relative w-20 h-9 bg-[#FF4C00] peer-focus:outline-none rounded-full peer-checked:after:translate-x-[3rem] peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-7 after:w-7 after:transition-all peer-checked:bg-green-500">
                        <span class={[
                          "absolute inset-0 flex items-center justify-end pr-3 text-[11px] font-black uppercase tracking-wider text-white transition-opacity duration-200 z-10 drop-shadow-sm",
                          if(Map.get(@settings["google_maps"], :active, true), do: "opacity-0")
                        ]}>OFF</span>
                        <span class={[
                          "absolute inset-0 flex items-center justify-start pl-3 text-[11px] font-black uppercase tracking-wider text-white transition-opacity duration-200 opacity-0 z-10 drop-shadow-sm",
                          if(Map.get(@settings["google_maps"], :active, true), do: "opacity-100")
                        ]}>ON</span>
                      </div>
                    </label>
                  </div>

                  <div class="grid grid-cols-1 gap-6">
                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">
                        Google Maps API Key
                      </label>
                      <input
                        type="password"
                        name="config[api_key]"
                        value={maps_config["api_key"]}
                        placeholder="AIza..."
                        class="w-full p-4 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                      />
                      <p class="mt-3 text-[10px] font-bold leading-relaxed text-slate-400">
                        Create a key in Google Cloud Console → APIs &amp; Services → Credentials.
                        Enable Maps JavaScript API, Places API and Geocoding API as needed. The key
                        is stored in the integrations table and is never rendered on the public site.
                      </p>
                    </div>
                  </div>

                  <span class={[
                    "inline-flex items-center gap-2 rounded-full px-4 py-2 text-[10px] font-black uppercase tracking-widest",
                    maps_connected &&
                      "bg-emerald-50 text-emerald-700 border border-emerald-100",
                    !maps_connected &&
                      "bg-amber-50 text-amber-700 border border-amber-100"
                  ]}>
                    <span class={[
                      "w-2 h-2 rounded-full",
                      maps_connected && "bg-emerald-500",
                      !maps_connected && "bg-amber-500"
                    ]}></span>
                    {if maps_connected,
                      do: "Google Maps key saved",
                      else: "Google Maps key not configured"}
                  </span>

                  <div class="rounded-[1.5rem] bg-orange-50 border border-orange-100 p-6">
                    <h4 class="text-xs font-black text-slate-900 uppercase tracking-widest mb-2">
                      Where this key is used
                    </h4>
                    <p class="text-[11px] font-bold leading-relaxed text-slate-600">
                      The saved key is available to the backend through
                      <code class="font-mono text-[10px]">Xpressbus.Integrations.google_maps_api_key/0</code>
                      for maps, route geocoding and place search. Restrict the key to the Komiuta
                      website origins and the required Google Maps APIs.
                    </p>
                  </div>

                  <div class="pt-2 flex flex-wrap gap-4">
                    <button
                      type="submit"
                      class="flex-1 min-w-[220px] bg-[#FF4C00] text-white py-5 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-orange-100 hover:bg-[#E64400] transition-all transform active:scale-95"
                    >
                      Save Google Maps Key
                    </button>
                    <button
                      type="button"
                      phx-click="test_connection"
                      class="px-10 bg-slate-900 text-white py-5 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-slate-200 hover:bg-black transition-all"
                    >
                      Test API
                    </button>
                  </div>
                </form>
              </div>
            <% end %>

            <%!-- Chyllz AI provider (Chat / Lens / Receipt / Food) --%>
            <%= if @current_provider == "ai" do %>
              <% ai_config = provider_config(@settings, "ai") %>
              <% ai_status = @ai_status %>
              <% ai_model = ai_config["model"] || ai_status.model %>
              <% ai_vision_model = ai_config["vision_model"] || ai_status.vision_model %>
              <% ai_base_url = ai_config["base_url"] || ai_status.base_url %>
              <% ai_timeout = ai_config["timeout"] || "20000" %>
              <% ai_status_label =
                case ai_status.source do
                  :integration -> "Connected via admin"
                  :environment -> "Using environment key"
                  :disabled -> "Disabled by admin"
                  :missing_key -> "Enabled — add an API key"
                  _ -> "Local guide mode (no key)"
                end %>
              <div class="animate-fade-in-up space-y-8">
                <form id="ai-integration-form" phx-submit="save" class="space-y-8">
                  <input type="hidden" name="provider" value="ai" />

                  <div class="flex items-center justify-between p-4 bg-slate-50 rounded-[2rem] border border-slate-100">
                    <div>
                      <h4 class="font-black text-slate-900 text-sm uppercase tracking-widest">
                        Chyllz AI Configuration
                      </h4>
                      <p class="text-[11px] font-bold text-slate-400">
                        OpenAI-compatible provider for the travel assistant
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input
                        type="checkbox"
                        phx-click="toggle_active"
                        phx-value-provider="ai"
                        checked={Map.get(@settings["ai"], :active, true)}
                        class="sr-only peer"
                      />
                      <div class="relative w-20 h-9 bg-[#FF4C00] peer-focus:outline-none rounded-full peer-checked:after:translate-x-[3rem] peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-7 after:w-7 after:transition-all peer-checked:bg-green-500">
                        <span class={[
                          "absolute inset-0 flex items-center justify-end pr-3 text-[11px] font-black uppercase tracking-wider text-white transition-opacity duration-200 z-10 drop-shadow-sm",
                          if(Map.get(@settings["ai"], :active, true), do: "opacity-0")
                        ]}>OFF</span>
                        <span class={[
                          "absolute inset-0 flex items-center justify-start pl-3 text-[11px] font-black uppercase tracking-wider text-white transition-opacity duration-200 opacity-0 z-10 drop-shadow-sm",
                          if(Map.get(@settings["ai"], :active, true), do: "opacity-100")
                        ]}>ON</span>
                      </div>
                    </label>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="rounded-[1.5rem] border border-slate-100 bg-slate-50 p-5">
                      <p class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">
                        Connection
                      </p>
                      <span class={[
                        "mt-3 inline-flex items-center gap-2 rounded-full px-3 py-2 text-[9px] font-black uppercase tracking-widest",
                        ai_status.configured &&
                          "bg-emerald-50 text-emerald-700 border border-emerald-100",
                        !ai_status.configured &&
                          "bg-amber-50 text-amber-700 border border-amber-100"
                      ]}>
                        <span class={[
                          "w-2 h-2 rounded-full",
                          ai_status.configured && "bg-emerald-500",
                          !ai_status.configured && "bg-amber-500"
                        ]}></span>
                        {ai_status_label}
                      </span>
                    </div>

                    <div class="rounded-[1.5rem] border border-slate-100 bg-white p-5">
                      <p class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">
                        Chat model
                      </p>
                      <p class="mt-2 break-words text-xs font-black text-slate-900">
                        {ai_model}
                      </p>
                    </div>

                    <div class="rounded-[1.5rem] border border-slate-100 bg-white p-5">
                      <p class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400">
                        Vision model
                      </p>
                      <p class="mt-2 break-words text-xs font-black text-slate-900">
                        {ai_vision_model}
                      </p>
                    </div>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6">
                    <div class="md:col-span-2">
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">
                        API Key
                      </label>
                      <input
                        type="password"
                        name="config[api_key]"
                        value=""
                        autocomplete="new-password"
                        placeholder={
                          if ai_status.has_integration_key,
                            do: "•••••••• — leave blank to keep the saved key",
                            else: "sk-... or your provider key"
                        }
                        class="w-full p-4 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                      />
                      <p class="mt-3 text-[10px] font-bold leading-relaxed text-slate-400">
                        <%= if ai_status.has_integration_key do %>
                          A key is saved and is never sent back to this page. Leave the field blank to keep it, or paste a new key to replace it.
                        <% else %>
                          Add an OpenAI, OpenRouter, Groq, Together or other OpenAI-compatible key. The key stays server-side.
                        <% end %>
                        <%= if ai_status.has_env_key and !ai_status.has_integration_key do %>
                          The server also has an environment key configured; it is used until you save a key here.
                        <% end %>
                      </p>
                    </div>

                    <div class="md:col-span-2">
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">
                        Base URL
                      </label>
                      <input
                        type="url"
                        name="config[base_url]"
                        value={ai_base_url}
                        placeholder="https://api.openai.com/v1"
                        class="w-full p-4 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                      />
                      <p class="mt-3 text-[10px] font-bold leading-relaxed text-slate-400">
                        Use an OpenAI-compatible <code class="font-black">/v1</code>
                        base. For OpenRouter use <code class="font-black">https://openrouter.ai/api/v1</code>.
                      </p>
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">
                        Chat model
                      </label>
                      <input
                        type="text"
                        name="config[model]"
                        value={ai_model}
                        placeholder="gpt-4o-mini"
                        class="w-full p-4 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                      />
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">
                        Vision model
                      </label>
                      <input
                        type="text"
                        name="config[vision_model]"
                        value={ai_vision_model}
                        placeholder="gpt-4o-mini"
                        class="w-full p-4 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                      />
                    </div>

                    <div>
                      <label class="block text-[10px] font-black text-slate-500 uppercase mb-3 tracking-[0.2em]">
                        Request timeout (ms)
                      </label>
                      <input
                        type="number"
                        name="config[timeout]"
                        value={ai_timeout}
                        min="1000"
                        max="60000"
                        step="1000"
                        class="w-full p-4 bg-white border-2 border-slate-100 rounded-2xl font-bold text-slate-700 outline-none focus:border-[#FF4C00] transition-all shadow-sm"
                      />
                    </div>
                  </div>

                  <div class="rounded-[1.5rem] bg-orange-50 border border-orange-100 p-6">
                    <h4 class="text-xs font-black text-slate-900 uppercase tracking-widest mb-2">
                      How Chyllz uses this
                    </h4>
                    <p class="text-[11px] font-bold leading-relaxed text-slate-600">
                      When this integration is ON and a key is saved, the Chyllz assistant uses the provider for Chat and Food,
                      and the vision model for Lens and Receipt photos. With no key, the assistant stays in its live-catalogue
                      guide mode and still answers, plans trips and reads pasted receipts. AI errors always fall back to the guide.
                    </p>
                  </div>

                  <div class="pt-2 flex flex-wrap gap-4">
                    <button
                      type="submit"
                      class="flex-1 min-w-[220px] bg-[#FF4C00] text-white py-5 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-orange-100 hover:bg-[#E64400] transition-all transform active:scale-95"
                    >
                      Save AI Settings
                    </button>
                    <button
                      type="button"
                      phx-click="test_connection"
                      class="px-10 bg-slate-900 text-white py-5 rounded-[1.5rem] font-black text-sm uppercase tracking-widest shadow-xl shadow-slate-200 hover:bg-black transition-all"
                    >
                      Test Connection
                    </button>
                    <button
                      :if={ai_status.has_integration_key}
                      type="button"
                      phx-click="clear_ai_key"
                      class="px-8 bg-white text-red-600 border-2 border-red-100 py-5 rounded-[1.5rem] font-black text-xs uppercase tracking-widest hover:bg-red-50 transition-all"
                    >
                      Remove saved key
                    </button>
                  </div>
                </form>
              </div>
            <% end %>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layouts.app>
