<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-[#f8fafc] text-slate-900">
    <section class="bg-gradient-to-br from-[#FF4C00] via-[#FF6A00] to-[#E64400] text-white">
      <div class="mx-auto max-w-6xl px-5 pb-5 pt-5 md:px-8">
        <div class="flex items-center justify-between gap-3">
          <a
            href="/dashboard"
            class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3.5 py-2 text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-white/20"
          >
            <span class="material-symbols-outlined !text-[15px] rotate-180">chevron_right</span>
            Back to Trips
          </a>

          <span class="rounded-full bg-white/15 px-3.5 py-2 text-[10px] font-black uppercase tracking-widest text-white/90">
            {@trip.status}
          </span>
        </div>

        <div class="mt-5 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div>
            <h1 class="text-2xl font-black tracking-tight md:text-3xl">{@trip.title}</h1>
            <p class="mt-2 text-xs font-bold text-white/80">{@trip.subtitle}</p>

            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-[10px] font-black uppercase tracking-widest text-white/75">
              <span class="inline-flex items-center gap-1.5">
                <span class="material-symbols-outlined !text-[15px]">calendar_month</span>
                {@trip.date_label}
              </span>
              <span>{@trip.days} day{if @trip.days == 1, do: "", else: "s"}</span>
              <span>{@trip.party}</span>
              <span class="font-mono text-white/60">{@trip.reference}</span>
            </div>
          </div>

          <a
            href={"/tickets?ticket_id=#{@ticket.ticket_id}"}
            class="inline-flex items-center justify-center rounded-xl bg-white px-5 py-3 text-[10px] font-black uppercase tracking-widest text-[#FF4C00] shadow-lg shadow-orange-900/20 transition hover:bg-orange-50"
          >
            View ticket
          </a>
        </div>

        <div class="mt-5 grid grid-cols-3 overflow-hidden rounded-2xl bg-black/15 text-center backdrop-blur md:grid-cols-6">
          <%= for {label, value} <- [
                {"Total spent", @spent_label},
                {"Budget", @budget_label},
                {"Remaining", @remaining_label},
                {"Expenses", length(@expenses)},
                {"Food items", @meal_count},
                {"Used", "#{@budget_used}%"}
              ] do %>
            <div class="border-white/10 px-2 py-3 odd:border-r md:border-r md:last:border-r-0">
              <p class="text-sm font-black text-white">{value}</p>
              <p class="mt-1 text-[7px] font-black uppercase tracking-[0.18em] text-white/55">
                {label}
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <div class="sticky top-0 z-20 border-b border-slate-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl gap-1 overflow-x-auto px-3 md:px-8">
        <%= for {key, label, icon} <- @tabs do %>
          <button
            type="button"
            id={"trip-tab-#{key}"}
            phx-click="set_tab"
            phx-value-tab={key}
            class={[
              "inline-flex shrink-0 items-center gap-2 border-b-2 px-4 py-4 text-[10px] font-black uppercase tracking-widest transition",
              @active_tab == key && "border-[#FF4C00] text-[#FF4C00]",
              @active_tab != key && "border-transparent text-slate-400 hover:text-slate-700"
            ]}
          >
            <span class="material-symbols-outlined !text-[16px]">{icon}</span>
            {label}
            <%= if key == "expenses" do %>
              <span class="rounded-full bg-orange-100 px-2 py-0.5 text-[8px] text-[#FF4C00]">{length(
                @expenses
              )}</span>
            <% end %>
            <%= if key == "meals" do %>
              <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[8px] text-slate-500">{@meal_count}</span>
            <% end %>
          </button>
        <% end %>
      </div>
    </div>

    <main class="mx-auto max-w-6xl px-4 py-6 md:px-8 md:py-8">
      <%= if @error do %>
        <div class="mb-4 rounded-2xl border border-red-100 bg-red-50 px-4 py-3 text-xs font-bold text-red-700">
          {@error}
        </div>
      <% end %>

      <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_330px]">
        <div class="min-w-0">
          <%= if @active_tab == "expenses" do %>
            <div class="overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm">
              <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-50 px-5 py-4">
                <h2 class="flex items-center gap-2 text-base font-black tracking-tight">
                  <span class="material-symbols-outlined !text-xl text-[#FF4C00]">payments</span>
                  All Expenses
                  <span class="rounded-full bg-orange-50 px-2 py-0.5 text-[9px] font-black text-[#FF4C00]">{length(
                    @expenses
                  )}</span>
                </h2>

                <div class="flex flex-wrap items-center gap-2">
                  <button
                    type="button"
                    phx-click="toggle_budget"
                    class="rounded-xl bg-[#FF4C00] px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-white shadow-md shadow-orange-200 transition hover:bg-[#E64400]"
                  >
                    Add Trip Budget
                  </button>
                  <button
                    type="button"
                    phx-click="toggle_expense"
                    class="rounded-xl border border-orange-200 bg-orange-50 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-[#FF4C00] transition hover:bg-orange-100"
                  >
                    + Add Expense
                  </button>
                </div>
              </div>

              <%= if @budget_form do %>
                <form
                  phx-submit="save_budget"
                  class="border-b border-slate-100 bg-orange-50/50 px-5 py-4"
                >
                  <p class="text-[10px] font-black uppercase tracking-widest text-slate-500">
                    Set a trip budget
                  </p>
                  <div class="mt-2 flex flex-col gap-2 sm:flex-row">
                    <input
                      type="text"
                      name="budget[amount]"
                      inputmode="decimal"
                      placeholder="e.g. 25000"
                      required
                      class="min-w-0 flex-1 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold outline-none focus:border-[#FF4C00]"
                    />
                    <button class="rounded-xl bg-[#FF4C00] px-5 py-3 text-[10px] font-black uppercase tracking-widest text-white">
                      Save budget
                    </button>
                  </div>
                </form>
              <% end %>

              <%= if @expense_form do %>
                <form
                  phx-submit="save_expense"
                  class="border-b border-slate-100 bg-slate-50 px-5 py-4"
                >
                  <p class="text-[10px] font-black uppercase tracking-widest text-slate-500">
                    Add an expense
                  </p>
                  <div class="mt-2 grid gap-2 sm:grid-cols-[1fr_140px_120px_auto]">
                    <input
                      type="text"
                      name="expense[label]"
                      placeholder="Description"
                      required
                      class="min-w-0 rounded-xl border border-slate-200 bg-white px-3 py-3 text-sm font-bold outline-none focus:border-[#FF4C00]"
                    />
                    <select
                      name="expense[category]"
                      class="rounded-xl border border-slate-200 bg-white px-3 py-3 text-sm font-bold outline-none focus:border-[#FF4C00]"
                    >
                      <%= for category <- @categories do %>
                        <option value={category} selected={category == @expense_category}>
                          {category}
                        </option>
                      <% end %>
                    </select>
                    <input
                      type="text"
                      name="expense[amount]"
                      inputmode="decimal"
                      placeholder="Amount"
                      required
                      class="rounded-xl border border-slate-200 bg-white px-3 py-3 text-sm font-bold outline-none focus:border-[#FF4C00]"
                    />
                    <button class="rounded-xl bg-[#FF4C00] px-5 py-3 text-[10px] font-black uppercase tracking-widest text-white">
                      Add
                    </button>
                  </div>
                </form>
              <% end %>

              <div class="flex items-center gap-2 border-b border-slate-50 px-5 py-3">
                <span class="rounded-full bg-[#FF4C00] px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-white">All</span>
              </div>

              <%= if @expense_rows == [] do %>
                <div class="px-5 py-16 text-center">
                  <div class="mx-auto grid h-12 w-12 place-items-center rounded-2xl bg-orange-50 text-[#FF4C00]">
                    <span class="material-symbols-outlined !text-2xl">payments</span>
                  </div>
                  <p class="mt-3 text-sm font-black text-slate-600">No expenses yet</p>
                  <p class="mt-1 text-xs font-bold text-slate-400">
                    Start tracking by adding your first expense.
                  </p>
                </div>
              <% else %>
                <div class="divide-y divide-slate-50">
                  <%= for expense <- @expense_rows do %>
                    <div
                      id={"expense-#{expense.id}"}
                      class="flex items-center justify-between gap-3 px-5 py-3.5"
                    >
                      <div class="flex min-w-0 items-center gap-3">
                        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-orange-50 text-[#FF4C00]">
                          <span class="material-symbols-outlined !text-[17px]">payments</span>
                        </span>
                        <div class="min-w-0">
                          <p class="truncate text-xs font-black text-slate-800">
                            {expense.label}
                          </p>
                          <p class="mt-0.5 text-[9px] font-bold uppercase tracking-widest text-slate-400">
                            {expense.category} · {expense.date_label}
                          </p>
                        </div>
                      </div>

                      <div class="flex shrink-0 items-center gap-3">
                        <span class="text-xs font-black text-slate-800">{expense.amount_label}</span>
                        <button
                          type="button"
                          phx-click="delete_expense"
                          phx-value-id={expense.id}
                          class="text-slate-300 transition hover:text-red-500"
                          aria-label="Delete expense"
                        >
                          <span class="material-symbols-outlined !text-[18px]">delete</span>
                        </button>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <div class="border-t border-slate-100 bg-orange-50/40 px-5 py-4">
                <div class="flex items-center justify-between text-[10px] font-black uppercase tracking-widest">
                  <span class="text-slate-500">Budget used: {@spent_label} of {@budget_label}</span>
                  <span class="text-[#FF4C00]">{@budget_used}%</span>
                </div>
                <div class="mt-2 h-2 overflow-hidden rounded-full bg-white">
                  <div
                    class="h-full rounded-full bg-[#FF4C00] transition-all"
                    style={"width: #{@budget_used}%"}
                  >
                  </div>
                </div>
                <div class="mt-2 flex justify-between text-[9px] font-bold text-slate-400">
                  <span>{@spent_label}</span>
                  <span>{@remaining_label} remaining</span>
                  <span>{@budget_label}</span>
                </div>
              </div>
            </div>
          <% end %>

          <%= if @active_tab == "meals" do %>
            <div class="rounded-3xl border border-slate-100 bg-white p-5 shadow-sm">
              <h2 class="flex items-center gap-2 text-base font-black tracking-tight">
                <span class="material-symbols-outlined !text-xl text-[#FF4C00]">restaurant</span>
                Meals &amp; Food
              </h2>
              <p class="mt-1 text-xs font-bold text-slate-400">Food spending for this trip.</p>

              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                <div class="rounded-2xl bg-orange-50 px-4 py-4">
                  <p class="text-[9px] font-black uppercase tracking-widest text-orange-500">
                    Food spend
                  </p>
                  <p class="mt-1 text-xl font-black text-[#FF4C00]">{@meal_total}</p>
                </div>
                <div class="rounded-2xl bg-slate-50 px-4 py-4">
                  <p class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                    Meals logged
                  </p>
                  <p class="mt-1 text-xl font-black text-slate-800">{@meal_count}</p>
                </div>
              </div>

              <%= if @meal_rows == [] do %>
                <div class="mt-4 rounded-2xl border border-dashed border-slate-200 px-5 py-12 text-center">
                  <p class="text-sm font-black text-slate-500">No meals logged yet</p>
                  <p class="mt-1 text-xs font-bold text-slate-400">
                    Add an expense with the Food category to track meals.
                  </p>
                </div>
              <% else %>
                <div class="mt-4 divide-y divide-slate-50">
                  <%= for expense <- @meal_rows do %>
                    <div class="flex items-center justify-between gap-3 py-3">
                      <div>
                        <p class="text-xs font-black text-slate-800">{expense.label}</p>
                        <p class="mt-0.5 text-[9px] font-bold uppercase tracking-widest text-slate-400">
                          {expense.date_label}
                        </p>
                      </div>
                      <span class="text-xs font-black text-slate-800">{expense.amount_label}</span>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <%= if @active_tab == "summary" do %>
            <div class="rounded-3xl border border-slate-100 bg-white p-5 shadow-sm">
              <h2 class="flex items-center gap-2 text-base font-black tracking-tight">
                <span class="material-symbols-outlined !text-xl text-[#FF4C00]">category</span>
                Trip Summary
              </h2>

              <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                <%= for {label, value} <- [
                      {"Route", "#{@trip.from} → #{@trip.to}"},
                      {"Operator", @trip.subtitle},
                      {"Travel date", @trip.date_label},
                      {"Reference", @trip.reference}
                    ] do %>
                  <div class="rounded-2xl bg-slate-50 px-4 py-3">
                    <dt class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                      {label}
                    </dt>
                    <dd class="mt-1 text-sm font-black text-slate-800">{value}</dd>
                  </div>
                <% end %>
              </dl>

              <div class="mt-4 rounded-2xl border border-orange-100 bg-orange-50 px-4 py-4">
                <p class="text-[9px] font-black uppercase tracking-widest text-orange-500">
                  Budget
                </p>
                <p class="mt-1 text-lg font-black text-[#FF4C00]">
                  {@spent_label} spent of {@budget_label}
                </p>
                <div class="mt-2 h-2 overflow-hidden rounded-full bg-white">
                  <div class="h-full rounded-full bg-[#FF4C00]" style={"width: #{@budget_used}%"}>
                  </div>
                </div>
                <p class="mt-2 text-[10px] font-bold text-slate-500">
                  {@remaining_label} remaining · {@budget_used}% used
                </p>
              </div>
            </div>
          <% end %>

          <%= if @active_tab == "places" do %>
            <div class="rounded-3xl border border-slate-100 bg-white p-5 shadow-sm">
              <h2 class="flex items-center gap-2 text-base font-black tracking-tight">
                <span class="material-symbols-outlined !text-xl text-[#FF4C00]">history</span>
                Visited Places
              </h2>
              <div class="mt-4 rounded-2xl border border-dashed border-slate-200 px-5 py-16 text-center">
                <p class="text-sm font-black text-slate-500">No visited places yet</p>
                <p class="mt-1 text-xs font-bold text-slate-400">
                  Places you visit on this trip will appear here.
                </p>
              </div>
            </div>
          <% end %>
        </div>

        <aside class="space-y-5">
          <div class="rounded-3xl border border-slate-100 bg-white p-5 shadow-sm">
            <h2 class="flex items-center gap-2 text-sm font-black tracking-tight">
              <span class="material-symbols-outlined !text-lg text-[#FF4C00]">category</span>
              Spending by Category
            </h2>

            <%= if @category_rows == [] do %>
              <div class="py-10 text-center">
                <div class="mx-auto grid h-10 w-10 place-items-center rounded-xl bg-slate-50 text-slate-300">
                  <span class="material-symbols-outlined !text-xl">category</span>
                </div>
                <p class="mt-2 text-xs font-black text-slate-500">No data yet</p>
                <p class="mt-1 text-[10px] font-bold text-slate-400">
                  Add expenses to see spending breakdown.
                </p>
              </div>
            <% else %>
              <div class="mt-4 space-y-3">
                <%= for row <- @category_rows do %>
                  <div>
                    <div class="flex justify-between text-[10px] font-black">
                      <span class="text-slate-600">{row.category}</span>
                      <span class="text-slate-800">{row.total_label}</span>
                    </div>
                    <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-100">
                      <div class="h-full rounded-full bg-[#FF4C00]" style={"width: #{row.width}%"}>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="rounded-3xl border border-slate-100 bg-white p-5 shadow-sm">
            <h2 class="flex items-center gap-2 text-sm font-black tracking-tight">
              <span class="material-symbols-outlined !text-lg text-[#FF4C00]">history</span>
              Recent Activity
            </h2>

            <%= if @recent_expenses == [] do %>
              <div class="py-10 text-center">
                <div class="mx-auto grid h-10 w-10 place-items-center rounded-xl bg-slate-50 text-slate-300">
                  <span class="material-symbols-outlined !text-xl">history</span>
                </div>
                <p class="mt-2 text-xs font-black text-slate-500">No recent activity</p>
                <p class="mt-1 text-[10px] font-bold text-slate-400">
                  Your recent expenses will appear here.
                </p>
              </div>
            <% else %>
              <div class="mt-4 divide-y divide-slate-50">
                <%= for expense <- @recent_expenses do %>
                  <div class="flex items-center justify-between gap-2 py-2.5">
                    <div class="min-w-0">
                      <p class="truncate text-[11px] font-black text-slate-700">
                        {expense.label}
                      </p>
                      <p class="text-[9px] font-bold text-slate-400">
                        {expense.category} · {expense.date_label}
                      </p>
                    </div>
                    <span class="shrink-0 text-[10px] font-black text-slate-700">{expense.amount_label}</span>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </aside>
      </div>
    </main>
  </div>
</Layouts.app>
