<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-slate-50 text-slate-900 live-content">
    <.main_header step={:dashboard} current_user={@current_user} />
    <main class="pt-[72px] md:pt-[80px]">
      <%!-- Dashboard Hero --%>
      <section class="px-6 pt-10 pb-4">
        <div class="mx-auto max-w-[1350px]">
          <div
            id="chyllz-welcome"
            class="relative overflow-hidden rounded-[28px] border border-slate-100 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04)] md:p-7"
          >
            <div
              class="pointer-events-none absolute -right-12 -top-16 h-44 w-44 rounded-full bg-orange-50/80 blur-2xl"
              aria-hidden="true"
            >
            </div>
            
            <div
              class="pointer-events-none absolute -bottom-20 left-24 h-40 w-40 rounded-full bg-amber-50/70 blur-2xl"
              aria-hidden="true"
            >
            </div>
            
            <div class="relative grid grid-cols-1 items-center gap-6 md:grid-cols-[auto_minmax(0,1fr)] xl:grid-cols-[auto_minmax(0,1fr)_auto]">
              <div
                class="relative mx-auto hidden h-[152px] w-[172px] shrink-0 md:block"
                aria-hidden="true"
              >
                <div class="absolute inset-0 -rotate-6 rounded-[22px] bg-orange-50"></div>
                
                <div class="absolute left-1.5 top-1.5 h-full w-full rotate-[6deg] rounded-[20px] border border-orange-100 bg-white/70">
                </div>
                
                <div class="absolute left-1/2 top-1/2 w-[150px] -translate-x-1/2 -translate-y-1/2 -rotate-[7deg] rounded-xl bg-white p-1.5 shadow-xl ring-1 ring-slate-100">
                  <img
                    src="/images/chyllz_account_hero.webp"
                    alt=""
                    width="600"
                    height="450"
                    loading="eager"
                    decoding="async"
                    class="h-[118px] w-full rounded-lg object-cover"
                  />
                  <div class="mt-1 flex items-center justify-between px-0.5 pb-0.5">
                    <span class="text-[7px] font-black uppercase tracking-[0.18em] text-slate-400">
                      Chyllz travels
                    </span>
                     <span class="h-1.5 w-1.5 rounded-full bg-[#FF4C00]"></span>
                  </div>
                </div>
                
                <div class="absolute -bottom-2 -right-1 grid h-10 w-10 place-items-center rounded-full border-2 border-white bg-[#FF4C00] text-white shadow-lg">
                  <.ui_icon name={:compass} class="h-5 w-5" />
                </div>
              </div>
              
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-orange-50 px-2.5 py-1 text-[9px] font-black uppercase tracking-[0.18em] text-[#FF4C00]">
                    <.ui_icon name={:sparkles} class="h-3 w-3" /> Chyllz account
                  </span>
                  
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-50 px-2.5 py-1 text-[9px] font-black uppercase tracking-[0.18em] text-slate-400">
                    Member since {Calendar.strftime(@user.inserted_at, "%B %Y")}
                  </span>
                </div>
                
                <h1 class="mt-3 text-2xl font-black leading-tight tracking-tight md:text-[28px] 2xl:text-[32px]">
                  Welcome back, {hd(String.split(@user.name || "Traveller"))}!
                </h1>
                
                <p class="mt-2 max-w-md text-sm font-bold leading-relaxed text-slate-400">
                  Ready to explore the world? Plan your next adventure or manage your trips.
                </p>
              </div>
              
              <div
                class="relative hidden w-[176px] shrink-0 select-none xl:block"
                aria-hidden="true"
              >
                <svg viewBox="0 0 230 102" class="h-[92px] w-[196px]" fill="none">
                  <path
                    d="M6 68c30-46 62 22 96-16 22-25 46-26 74-8 16 10 26 26 30 44"
                    stroke="#FF4C00"
                    stroke-width="2"
                    stroke-dasharray="5 7"
                    stroke-linecap="round"
                    opacity="0.7"
                  /> <circle cx="6" cy="68" r="4" fill="#FF4C00" />
                  <path d="m206 80 14 8-16 4 4-6z" fill="#FF4C00" opacity="0.9" />
                  <text
                    x="12"
                    y="38"
                    font-family="'Segoe Script','Brush Script MT','Bradley Hand',cursive"
                    font-size="26"
                    font-weight="700"
                    fill="#0F172A"
                  >
                    New places,
                  </text>
                  
                  <text
                    x="34"
                    y="74"
                    font-family="'Segoe Script','Brush Script MT','Bradley Hand',cursive"
                    font-size="26"
                    font-weight="700"
                    fill="#FF4C00"
                    transform="rotate(-5 34 74)"
                  >
                    New stories
                  </text>
                </svg>
              </div>
            </div>
            
            <div class="relative mt-5 flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
              <div
                id="hero-stats"
                class="grid grid-cols-1 gap-2.5 sm:grid-cols-3 xl:max-w-[620px]"
              >
                <a
                  id="stat-total-trips"
                  href="/dashboard"
                  class="group flex items-center gap-3 rounded-2xl border border-slate-100 bg-white p-3 shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition-all hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-lg"
                >
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-orange-50 text-[#FF4C00]">
                    <.ui_icon name={:route} class="h-5 w-5" />
                  </span>
                  
                  <span class="min-w-0 flex-1">
                    <span
                      id="stat-total-trips-value"
                      class="block text-xl font-black tabular-nums tracking-tight text-slate-900"
                    >
                      {@hero_stats.trips}
                    </span>
                    
                    <span class="block text-[9px] font-black uppercase tracking-[0.16em] text-slate-400">
                      Total Trips
                    </span>
                  </span>
                  
                  <span class="shrink-0 text-slate-300 transition-colors group-hover:text-[#FF4C00]">
                    <.ui_icon name={:chevron_right} class="h-4 w-4" />
                  </span>
                </a>
                
                <a
                  id="stat-upcoming-trips"
                  href="/dashboard"
                  class="group flex items-center gap-3 rounded-2xl border border-slate-100 bg-white p-3 shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition-all hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-lg"
                >
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-orange-50 text-[#FF4C00]">
                    <.ui_icon name={:calendar} class="h-5 w-5" />
                  </span>
                  
                  <span class="min-w-0 flex-1">
                    <span
                      id="stat-upcoming-trips-value"
                      class="block text-xl font-black tabular-nums tracking-tight text-slate-900"
                    >
                      {@hero_stats.upcoming}
                    </span>
                    
                    <span class="block text-[9px] font-black uppercase tracking-[0.16em] text-slate-400">
                      Upcoming Trips
                    </span>
                  </span>
                  
                  <span class="shrink-0 text-slate-300 transition-colors group-hover:text-[#FF4C00]">
                    <.ui_icon name={:chevron_right} class="h-4 w-4" />
                  </span>
                </a>
                
                <a
                  id="stat-places-visited"
                  href="/tour-packages"
                  class="group flex items-center gap-3 rounded-2xl border border-slate-100 bg-white p-3 shadow-[0_1px_2px_rgba(15,23,42,0.04)] transition-all hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-lg"
                >
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-orange-50 text-[#FF4C00]">
                    <.ui_icon name={:pin} class="h-5 w-5" />
                  </span>
                  
                  <span class="min-w-0 flex-1">
                    <span
                      id="stat-places-visited-value"
                      class="block text-xl font-black tabular-nums tracking-tight text-slate-900"
                    >
                      {@hero_stats.places_visited}
                    </span>
                    
                    <span class="block text-[9px] font-black uppercase tracking-[0.16em] text-slate-400">
                      Places Visited
                    </span>
                  </span>
                  
                  <span class="shrink-0 text-slate-300 transition-colors group-hover:text-[#FF4C00]">
                    <.ui_icon name={:chevron_right} class="h-4 w-4" />
                  </span>
                </a>
              </div>
              
              <div class="flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:items-center xl:ml-auto xl:shrink-0">
                <a
                  id="build-with-ai"
                  href="/trip/build-with-ai"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#FF4C00] px-5 py-3 text-[10px] font-black uppercase tracking-widest text-white shadow-lg shadow-orange-500/20 transition-all hover:-translate-y-0.5 hover:bg-[#E64400] hover:shadow-xl sm:w-auto"
                >
                  <.ui_icon name={:sparkles} class="h-4 w-4" /> Build with AI
                </a>
                
                <a
                  id="create-new-trip"
                  href="/tour-packages"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-full border-2 border-[#FF4C00] bg-orange-50 px-5 py-3 text-[10px] font-black uppercase tracking-widest text-[#FF4C00] transition-all hover:-translate-y-0.5 hover:bg-[#FF4C00] hover:text-white sm:w-auto"
                >
                  <.ui_icon name={:compass} class="h-4 w-4" /> Create New Trip
                </a>
                
                <a
                  id="view-my-trips"
                  href="/dashboard"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-slate-200 bg-white px-5 py-3 text-[10px] font-black uppercase tracking-widest text-slate-700 transition-all hover:-translate-y-0.5 hover:border-[#FF4C00] hover:text-[#FF4C00] sm:w-auto"
                >
                  <.ui_icon name={:ticket} class="h-4 w-4" /> View My Trips
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
       <%!-- Tab Navigation: one row that scrolls horizontally on narrow screens --%>
      <nav class="relative z-20 mt-2 max-w-[1350px] mx-auto px-6 mb-12">
        <div class="flex flex-nowrap gap-2 overflow-x-auto no-scrollbar rounded-2xl border border-slate-100 bg-white p-2 shadow-xl">
          <.user_tab_link
            id="bus"
            label="My Bus"
            active={@active_tab}
            icon="confirmation_number"
          /> <.user_tab_link id="chyllz" label="My Chyllz" active={@active_tab} icon="hotel" />
          <.user_tab_link
            id="wallet"
            label="Wallet & Pay"
            active={@active_tab}
            icon="account_balance_wallet"
          />
          <.user_tab_link id="transactions" label="History" active={@active_tab} icon="history" />
          <.user_tab_link id="referral" label="Rewards" active={@active_tab} icon="redeem" />
          <.user_tab_link id="profile" label="Settings" active={@active_tab} icon="settings" />
        </div>
      </nav>
       <%!-- Main Content Area --%>
      <div class="max-w-[1350px] mx-auto px-6 pb-24">
        <%= case @active_tab do %>
          <% "bus" -> %>
            <div class="bg-white rounded-3xl shadow-sm border border-slate-100 p-8">
              <div class="flex items-center justify-between mb-8">
                <h2 class="text-xl font-black text-slate-900 tracking-tight uppercase tracking-widest">
                  Active & Past Bookings
                </h2>
                
                <a
                  href="/"
                  class="text-[#FF4C00] font-black text-xs uppercase tracking-widest hover:underline flex items-center gap-2"
                >Book New Trip <span class="material-symbols-outlined !text-sm">add</span></a>
              </div>
              
              <%= if Enum.empty?(@tickets) do %>
                <div class="py-20 text-center">
                  <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center text-slate-200 mx-auto mb-4">
                    <span class="material-symbols-outlined !text-4xl">confirmation_number</span>
                  </div>
                  
                  <h3 class="text-lg font-black text-slate-400">No bookings found</h3>
                  
                  <p class="text-sm font-bold text-slate-300 mt-2">
                    Start your first journey with KOMIUTA today.
                  </p>
                </div>
              <% else %>
                <div class="space-y-4">
                  <%= for ticket <- @tickets do %>
                    <div
                      id={"ticket-card-#{ticket.ticket_id}"}
                      class="group bg-white border border-slate-100 rounded-2xl p-5 hover:border-orange-200 hover:shadow-md transition-all"
                    >
                      <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                        <div class="flex items-center gap-5 w-full md:w-auto">
                          <div class="w-12 h-12 bg-orange-50 rounded-xl flex items-center justify-center text-orange-500 shrink-0">
                            <span class="material-symbols-outlined">directions_bus</span>
                          </div>
                          
                          <div class="flex-1">
                            <div class="flex items-center gap-2 mb-1">
                              <span class="font-black text-slate-900">{ticket.from}</span>
                              <span class="material-symbols-outlined !text-sm text-slate-300">arrow_forward</span>
                              <span class="font-black text-slate-900">{ticket.to}</span>
                            </div>
                            
                            <p class="text-xs font-bold text-slate-400">
                              {format_date(ticket.travel_date)} • {ticket.company}
                            </p>
                          </div>
                        </div>
                        
                        <div class="flex items-center gap-8 w-full md:w-auto justify-between md:justify-end">
                          <div class="text-center md:text-right">
                            <div class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-0.5">
                              Seat(s)
                            </div>
                            
                            <div class="font-black text-slate-900">
                              {format_seats(ticket.seats)}
                            </div>
                          </div>
                          
                          <div class={[
                            "px-3 py-1 rounded-full text-[10px] font-black uppercase",
                            ticket.status == "confirmed" && "bg-green-50 text-green-600",
                            ticket.status == "cancelled" && "bg-red-50 text-red-600",
                            ticket.status == "completed" && "bg-blue-50 text-blue-600"
                          ]}>
                            {ticket.status}
                          </div>
                          
                          <button
                            phx-click="view_ticket"
                            phx-value-ticket_id={ticket.ticket_id}
                            class="w-10 h-10 bg-slate-50 rounded-full flex items-center justify-center text-slate-400 hover:bg-[#FF4C00] hover:text-white transition-all"
                          >
                            <span class="material-symbols-outlined">visibility</span>
                          </button>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% "chyllz" -> %>
            <%!-- Chyllz account view: greeting, counters, recent trips and the
            weather/destination sidebar. Same account shell as My Bus. --%>
            <.account_dashboard
              user={@user}
              overview={@chyllz_overview}
              trips={@chyllz_trips}
              hotel_bookings={@hotel_bookings}
              itineraries={@chyllz_itineraries}
              picks={@chyllz_overview.picks}
              story_cards={@chyllz_overview.story_cards}
              member_since={@member_since}
              weather={@weather}
              weather_error={@weather_error}
              weather_loading={@weather_loading}
              weather_chart={@weather_chart}
              weather_query={@weather_query}
              weather_city={@weather_city}
            />
          <% "transactions" -> %>
            <div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden">
              <div class="p-8 border-b border-slate-50">
                <h2 class="text-xl font-black text-slate-900 tracking-tight uppercase tracking-widest">
                  Transaction History
                </h2>
              </div>
              
              <div class="overflow-x-auto">
                <table class="w-full text-left">
                  <thead>
                    <tr class="bg-slate-50/50 text-[10px] font-black text-slate-400 uppercase tracking-widest">
                      <th class="px-8 py-4">Date</th>
                      
                      <th class="px-8 py-4">Description</th>
                      
                      <th class="px-8 py-4">Ref ID</th>
                      
                      <th class="px-8 py-4">Amount</th>
                      
                      <th class="px-8 py-4">Status</th>
                    </tr>
                  </thead>
                  
                  <tbody class="divide-y divide-slate-50">
                    <%= if Enum.empty?(@transactions) do %>
                      <tr>
                        <td colspan="5" class="px-8 py-20 text-center font-bold text-slate-400">
                          No transaction records found.
                        </td>
                      </tr>
                    <% else %>
                      <%= for tx <- @transactions do %>
                        <tr class="hover:bg-slate-50/50 transition-colors">
                          <td class="px-8 py-5 text-sm font-bold text-slate-500">
                            {format_date(tx.inserted_at)}
                          </td>
                          
                          <td class="px-8 py-5 text-sm font-black text-slate-900">
                            {tx.description}
                          </td>
                          
                          <td class="px-8 py-5 font-mono text-xs text-slate-400">
                            {tx.reference_id}
                          </td>
                          
                          <td class={[
                            "px-8 py-5 font-black",
                            if(tx.type == "credit", do: "text-green-600", else: "text-slate-900")
                          ]}>
                            {if tx.type == "credit", do: "+", else: "-"}KES {tx.amount}
                          </td>
                          
                          <td class="px-8 py-5">
                            <span class="text-[10px] font-black uppercase text-green-600 bg-green-50 px-2 py-0.5 rounded">{tx.status}</span>
                          </td>
                        </tr>
                      <% end %>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          <% "wallet" -> %>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
              <div class="bg-white rounded-3xl p-10 shadow-sm border border-slate-100 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-3 mb-8">
                    <div class="w-12 h-12 bg-orange-50 rounded-2xl flex items-center justify-center text-orange-500">
                      <span class="material-symbols-outlined !text-2xl">account_balance_wallet</span>
                    </div>
                    
                    <h2 class="text-xl font-black text-slate-900 uppercase tracking-widest">
                      KOMIUTA Wallet
                    </h2>
                  </div>
                  
                  <p class="text-sm font-bold text-slate-400 mb-2">Current Balance</p>
                  
                  <div class="text-5xl font-black text-slate-900 tracking-tighter">
                    KES {@user.wallet_balance}
                  </div>
                </div>
                
                <div class="mt-12 flex gap-4">
                  <button
                    type="button"
                    phx-click="wallet_action"
                    phx-value-action="top-up"
                    class="flex-1 bg-[#FF4C00] text-white py-4 rounded-2xl font-black shadow-lg shadow-orange-200 hover:bg-[#E64400] transition-all"
                  >Top Up Wallet</button>
                  <button
                    type="button"
                    phx-click="wallet_action"
                    phx-value-action="transfer"
                    class="flex-1 bg-white border-2 border-slate-100 text-slate-700 py-4 rounded-2xl font-black hover:border-orange-500 transition-all"
                  >Transfer</button>
                </div>
              </div>
              
              <div class="bg-slate-900 rounded-3xl p-10 shadow-xl text-white relative overflow-hidden">
                <div class="absolute top-0 right-0 w-64 h-64 bg-orange-500/20 rounded-full blur-[80px]">
                </div>
                
                <div class="relative z-10">
                  <h3 class="text-lg font-black uppercase tracking-widest text-slate-400 mb-8">
                    Default Payment
                  </h3>
                  
                  <div class="flex items-center gap-6 mb-10">
                    <div class="w-16 h-12 bg-white rounded-lg flex items-center justify-center p-2 text-green-600 font-black text-[10px] border border-slate-100 shadow-sm leading-none text-center">
                      M-PESA<br />EXPRESS
                    </div>
                    
                    <div>
                      <div class="font-black text-xl tracking-tight">M-Pesa Express</div>
                      
                      <p class="text-sm font-bold text-slate-500">Connected: {@user.phone}</p>
                    </div>
                  </div>
                  
                  <button
                    type="button"
                    phx-click="wallet_action"
                    phx-value-action="change-payment-method"
                    class="w-full bg-white/10 backdrop-blur-md border border-white/20 text-white py-4 rounded-2xl font-black hover:bg-white/20 transition-all"
                  >Change Method</button>
                </div>
              </div>
            </div>
          <% "referral" -> %>
            <div class="max-w-4xl mx-auto bg-white rounded-3xl shadow-sm border border-slate-100 p-10 text-center">
              <div class="w-24 h-24 bg-orange-50 rounded-full flex items-center justify-center text-orange-500 mx-auto mb-8">
                <span class="material-symbols-outlined !text-5xl">redeem</span>
              </div>
              
              <h2 class="text-3xl font-black text-slate-900 tracking-tighter mb-4">
                Refer & Earn KES 200
              </h2>
              
              <p class="text-slate-500 font-bold max-w-md mx-auto mb-10 leading-relaxed">
                Share your unique code with friends. When they book their first trip, both of you get KES 200 in your KOMIUTA wallets!
              </p>
              
              <div class="flex items-center justify-center gap-3 bg-slate-50 p-6 rounded-[2rem] border-2 border-dashed border-slate-200">
                <span class="font-mono text-2xl font-black text-slate-900 tracking-widest">{@user.referral_code}</span>
                <button
                  id="copy-referral-button"
                  phx-hook=".CopyReferral"
                  data-code={@user.referral_code}
                  type="button"
                  aria-label="Copy referral code"
                  class="w-10 h-10 bg-white rounded-full flex items-center justify-center text-orange-500 shadow-md hover:scale-110 transition-all"
                >
                  <span class="material-symbols-outlined !text-lg">content_copy</span>
                </button>
              </div>
              
              <div class="mt-8 text-xs font-black text-slate-400 uppercase tracking-[0.3em]">
                Total referrals: 0
              </div>
            </div>
          <% "profile" -> %>
            <div class="max-w-3xl mx-auto bg-white rounded-3xl shadow-sm border border-slate-100 p-10">
              <h2 class="text-xl font-black text-slate-900 uppercase tracking-widest border-b pb-4 mb-10">
                Account Settings
              </h2>
              
              <.form
                for={@profile_form}
                id="profile-form"
                phx-submit="update_profile"
                class="space-y-6"
              >
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Full Name</label>
                    <input
                      type="text"
                      name="user[name]"
                      value={@profile_form[:name].value}
                      class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl font-bold focus:bg-white focus:border-orange-500 outline-none transition"
                    />
                  </div>
                  
                  <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Email Address</label>
                    <div class="flex items-center gap-2">
                      <div class="flex-1 min-w-0 p-4 bg-slate-100 border border-slate-200 rounded-xl font-bold text-slate-500 break-all">
                        {@user.email}
                      </div>
                      
                      <button
                        type="button"
                        phx-click="open_email_change"
                        class="shrink-0 px-4 py-4 rounded-xl bg-orange-50 text-[#FF4C00] text-[10px] font-black uppercase tracking-widest border border-orange-100 hover:bg-orange-100 transition-all"
                      >
                        Change
                      </button>
                    </div>
                    
                    <p class="text-[9px] font-bold text-slate-400 mt-1">
                      Changing your email requires a verification code sent to the new address.
                    </p>
                  </div>
                  
                  <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Phone Number</label>
                    <input
                      type="text"
                      value={@user.phone}
                      class="w-full p-4 bg-slate-100 border border-slate-200 rounded-xl font-bold text-slate-400 cursor-not-allowed outline-none"
                      readonly
                    />
                    <p class="text-[9px] font-bold text-slate-400 mt-1">
                      Phone number cannot be changed.
                    </p>
                  </div>
                  
                  <div>
                    <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Language Preference</label>
                    <select
                      disabled
                      aria-disabled="true"
                      class="w-full p-4 bg-slate-100 border border-slate-200 rounded-xl font-bold text-slate-400 cursor-not-allowed outline-none appearance-none"
                    >
                      <option>English (US)</option>
                    </select>
                    
                    <p class="text-[9px] font-bold text-slate-400 mt-1">
                      More languages are coming soon.
                    </p>
                  </div>
                </div>
                
                <div class="pt-6">
                  <button
                    type="submit"
                    class="bg-[#FF4C00] text-white px-10 py-4 rounded-xl font-black text-sm shadow-lg shadow-orange-200 hover:bg-[#E64400] transition-all"
                  >Save Changes</button>
                </div>
              </.form>
            </div>
        <% end %>
      </div>
       <%!-- Ticket Detail Modal --%>
      <%= if @show_ticket_modal && @selected_ticket do %>
        <div
          class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4"
          phx-click="close_ticket"
        >
          <div
            class="bg-white rounded-[2.5rem] max-w-[770px] w-full overflow-hidden shadow-2xl animate-fade-in-up"
            phx-click.stop
          >
            <div class="text-center mb-6 pt-8 relative">
              <button
                phx-click="close_ticket"
                class="absolute top-4 right-4 w-10 h-10 bg-slate-100 hover:bg-slate-200 rounded-full flex items-center justify-center transition-all text-slate-600"
              >
                <span class="material-symbols-outlined">close</span>
              </button>
              
              <div class="w-16 h-16 bg-green-500 text-white rounded-full flex items-center justify-center text-3xl mx-auto mb-4 shadow-xl shadow-green-100 animate-bounce">
                <span class="material-symbols-outlined !text-4xl" aria-hidden="true">check</span>
                <span class="sr-only">Booking confirmed</span>
              </div>
              
              <h1 class="text-2xl font-black text-slate-900 mb-1">Congratulations!</h1>
              
              <p class="text-xs font-bold text-slate-500 tracking-wide opacity-80">
                Booking Confirmed & E-Ticket Ready
              </p>
            </div>
             <%!-- E-Ticket Card --%>
            <div class="bg-white rounded-[2rem] md:rounded-[2.5rem] shadow-xl overflow-hidden border border-slate-100 relative mb-4">
              <div class="absolute left-0 top-[65%] -translate-x-1/2 w-6 h-6 bg-[#f8fafc] rounded-full border border-slate-100 shadow-inner">
              </div>
              
              <div class="absolute right-0 top-[65%] translate-x-1/2 w-6 h-6 bg-[#f8fafc] rounded-full border border-slate-100 shadow-inner">
              </div>
              
              <div class="bg-gradient-to-br from-[#FF4C00] to-[#FF8C00] py-4 md:py-5 px-4 md:px-5 text-white relative">
                <div class="flex justify-between items-center mb-3">
                  <div class="bg-white/20 px-2.5 py-0.5 rounded-full text-[8px] font-black uppercase tracking-widest">
                    Boarding Pass
                  </div>
                  
                  <div class="font-black tracking-tighter text-base uppercase">
                    KOMIUTA<span class="opacity-50">.</span>
                  </div>
                </div>
                
                <div class="flex justify-between items-end gap-3">
                  <div>
                    <div class="text-[8px] font-black opacity-60 uppercase mb-0.5">From</div><div class="text-xl md:text-2xl font-black leading-none uppercase">
                      {@selected_ticket.from}
                    </div>
                  </div>
                  
                  <div class="flex-1 border-b-2 border-dashed border-white/30 mb-1.5 relative">
                    <span
                      class="absolute left-1/2 top-1/2 grid h-5 w-5 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-[#FF4C00]"
                      aria-hidden="true"
                    >
                      <.ui_icon name={:plane} class="h-3 w-3" />
                    </span>
                  </div>
                  
                  <div class="text-right">
                    <div class="text-[8px] font-black opacity-60 uppercase mb-0.5">To</div><div class="text-xl md:text-2xl font-black leading-none uppercase">
                      {@selected_ticket.to}
                    </div>
                  </div>
                </div>
                
                <div class="mt-3 pt-2 border-t border-white/10 flex justify-between items-center">
                  <div>
                    <div class="text-[8px] font-black opacity-60 uppercase">Vehicle Reg</div><div class="font-black text-[10px] uppercase">
                      {(@selected_ticket.bus && @selected_ticket.bus.registration) || "N/A"}
                    </div>
                  </div>
                  
                  <div class="text-right">
                    <div class="text-[8px] font-black opacity-60 uppercase">Travel Date</div><div class="font-black text-[10px] uppercase">
                      {@selected_ticket.travel_date}
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="py-4 md:py-5 pb-1 px-4 md:px-5">
                <div class="grid grid-cols-2 gap-y-3 gap-x-10 mb-4">
                  <div>
                    <div class="text-[8px] font-black text-slate-400 uppercase mb-0.5">
                      Departure Time
                    </div><div class="font-black text-slate-800 text-xs">
                      {@selected_ticket.departure}
                    </div>
                  </div>
                  
                  <div>
                    <div class="text-[8px] font-black text-slate-400 uppercase mb-0.5">
                      Bus Operator
                    </div><div class="font-black text-slate-800 text-xs">
                      {@selected_ticket.company}
                    </div>
                  </div>
                  
                  <div>
                    <div class="text-[8px] font-black text-slate-400 uppercase mb-0.5">
                      Boarding Point
                    </div><div class="font-black text-slate-800 text-[10px]">
                      N/A
                    </div>
                  </div>
                  
                  <div>
                    <div class="text-[8px] font-black text-slate-400 uppercase mb-0.5">
                      Alighting Point
                    </div><div class="font-black text-slate-800 text-[10px]">
                      N/A
                    </div>
                  </div>
                  
                  <div class="md:col-span-2 border-t border-slate-50 pt-3">
                    <div class="text-[8px] font-black text-slate-400 uppercase mb-1.5">
                      Passenger(s) Details
                    </div>
                    
                    <div class="space-y-2">
                      <div class="flex justify-between items-center bg-slate-50/50 p-2.5 rounded-lg border border-slate-100/50 w-full">
                        <div>
                          <div class="text-[11px] font-black text-slate-900 capitalize">
                            {@selected_ticket.passenger_name}
                          </div><div class="text-[8px] font-bold text-slate-400 tracking-tight">
                            {@selected_ticket.passenger_phone}
                          </div>
                        </div>
                        
                        <div class="text-[8px] font-black text-[#FF4C00] bg-orange-50 px-2 py-0.5 rounded-md border border-orange-100 uppercase">
                          Seat {format_seats(@selected_ticket.seats)}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="border-t-2 border-dashed border-slate-100 mx-5"></div>
              
              <div class="py-3 md:py-4 pt-3 md:pt-4 px-4 md:px-5">
                <div class="flex flex-col md:flex-row items-center justify-between gap-5">
                  <div class="flex-1 w-full min-w-0">
                    <div class="flex items-center justify-between mb-2">
                      <div>
                        <div class="text-[8px] font-black text-slate-400 uppercase mb-0.5">
                          Ticket Number
                        </div><div class="text-base md:text-lg font-mono font-black text-[#FF4C00] tracking-tight">
                          {@selected_ticket.ticket_id}
                        </div>
                      </div>
                      
                      <div class="text-right">
                        <div class="text-[8px] font-black text-slate-400 uppercase mb-0.5">
                          Status
                        </div><div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-green-100 text-green-700 text-[8px] font-black uppercase tracking-wider">
                          <span class="w-1 h-1 bg-green-500 rounded-full"></span>{String.capitalize(
                            @selected_ticket.status || "Unused"
                          )}
                        </div>
                      </div>
                    </div>
                    
                    <%!-- Real ISO/IEC 15417 Code 128B barcode of the ticket number (locally generated inline SVG) --%>
                    <div
                      id="ticket-barcode"
                      class="w-full bg-white border border-slate-200 rounded-lg flex items-center justify-center overflow-hidden px-2 py-1.5"
                    >
                      <%= if @ticket_barcode do %>
                        {@ticket_barcode}
                      <% else %>
                        <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">
                          Barcode unavailable — present the ticket number above
                        </span>
                      <% end %>
                    </div>
                  </div>
                  
                  <div class="shrink-0 text-center">
                    <%!-- Real QR code (locally generated inline SVG) encoding the signed ticket URL --%>
                    <div
                      id="ticket-qr"
                      class="w-40 h-40 bg-white border-2 border-slate-900 rounded-2xl p-2 flex items-center justify-center overflow-hidden"
                    >
                      <%= if @ticket_qr do %>
                        {@ticket_qr}
                      <% else %>
                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest text-center leading-tight">
                          Ticket<br />{@selected_ticket.ticket_id}
                        </span>
                      <% end %>
                    </div>
                    
                    <div class="text-[7px] font-black text-slate-400 mt-1.5 uppercase tracking-widest">
                      Scan to Board
                    </div>
                  </div>
                </div>
              </div>
              
              <div class="p-4 md:p-5 flex gap-4">
                <a
                  id="download-ticket-pdf"
                  href={@download_url || ~p"/tickets"}
                  class="flex-1 bg-[#FF4C00] text-white py-4 rounded-2xl font-black shadow-lg shadow-orange-200 hover:bg-[#E64400] transition-all flex items-center justify-center gap-2"
                >
                  <span class="material-symbols-outlined">download</span> Download PDF
                </a>
                
                <button
                  phx-click="close_ticket"
                  class="px-6 py-4 rounded-2xl font-black text-sm border-2 border-slate-100 hover:border-[#FF4C00] hover:text-[#FF4C00] transition"
                >
                  Close
                </button>
              </div>
            </div>
          </div>
        </div>
      <% end %>
       <%!-- Email Change Modal --%>
      <%= if @show_email_change_modal do %>
        <div class="fixed inset-0 bg-slate-950/80 backdrop-blur-md flex items-center justify-center z-[100] p-4">
          <div class="bg-white rounded-[2.5rem] max-w-md w-full p-10 shadow-2xl animate-fade-in-up border border-slate-100">
            <div class="text-center mb-8">
              <div class="w-20 h-20 bg-orange-50 rounded-3xl flex items-center justify-center text-[#FF4C00] mx-auto mb-6 shadow-sm border border-orange-100">
                <span class="material-symbols-outlined !text-4xl">mark_email_unread</span>
              </div>
              
              <h2 class="text-3xl font-black text-slate-900 tracking-tighter mb-2">
                Change email
              </h2>
              
              <p class="text-sm font-bold text-slate-400">
                <%= if @email_change_step == :email do %>
                  We'll send a verification code to the new address before changing your account.
                <% else %>
                  Enter the 6-digit code we sent to your new address.
                <% end %>
              </p>
            </div>
            
            <%= if @email_change_step == :email do %>
              <form
                id="email-change-request-form"
                phx-submit="request_email_change"
                class="space-y-5"
              >
                <div>
                  <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">New Email Address</label>
                  <input
                    type="email"
                    name="email_change[new_email]"
                    value={@email_change_form[:new_email].value}
                    placeholder="you@example.com"
                    autocomplete="email"
                    class="w-full p-4 bg-slate-50 border-2 border-slate-100 rounded-2xl font-black text-slate-900 placeholder:text-slate-300 focus:bg-white focus:border-[#FF4C00] outline-none transition-all shadow-sm"
                    required
                  />
                  <p class="text-[10px] font-bold text-slate-400 mt-2">
                    Current: <span class="text-slate-600">{@user.email}</span>
                  </p>
                </div>
                
                <%= if @email_change_error do %>
                  <p class="text-[11px] font-bold text-red-500 flex items-center gap-1">
                    <span class="material-symbols-outlined !text-xs">error</span> {@email_change_error}
                  </p>
                <% end %>
                
                <button
                  type="submit"
                  class="w-full bg-[#FF4C00] text-white py-5 rounded-2xl font-black text-sm uppercase tracking-widest shadow-xl shadow-orange-500/20 hover:bg-[#E64400] transition-all transform active:scale-95 flex items-center justify-center gap-2"
                >
                  Send verification code
                  <span class="material-symbols-outlined">arrow_forward</span>
                </button>
              </form>
            <% else %>
              <form
                id="email-change-confirm-form"
                phx-submit="confirm_email_change"
                class="space-y-5"
              >
                <div>
                  <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Verification Code</label>
                  <input
                    type="text"
                    name="code"
                    inputmode="numeric"
                    pattern="[0-9]{6}"
                    maxlength="6"
                    placeholder="000000"
                    autocomplete="one-time-code"
                    class="w-full p-4 bg-slate-50 border-2 border-slate-100 rounded-2xl font-black text-slate-900 text-center text-2xl tracking-[0.4em] focus:bg-white focus:border-[#FF4C00] outline-none transition-all shadow-sm"
                    required
                  />
                  <p class="text-[10px] font-bold text-slate-400 mt-2 text-center break-all">
                    Sent to <span class="text-slate-600">{@pending_new_email}</span>
                  </p>
                </div>
                
                <%= if @email_change_error do %>
                  <p class="text-[11px] font-bold text-red-500 flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined !text-xs">error</span> {@email_change_error}
                  </p>
                <% end %>
                
                <button
                  type="submit"
                  class="w-full bg-[#FF4C00] text-white py-5 rounded-2xl font-black text-sm uppercase tracking-widest shadow-xl shadow-orange-500/20 hover:bg-[#E64400] transition-all transform active:scale-95 flex items-center justify-center gap-2"
                >
                  Confirm email change <span class="material-symbols-outlined">check_circle</span>
                </button>
                
                <button
                  type="button"
                  phx-click="open_email_change"
                  class="w-full text-[10px] font-black uppercase tracking-widest text-slate-400 hover:text-[#FF4C00] transition-colors"
                >
                  Use a different email
                </button>
              </form>
            <% end %>
            
            <button
              type="button"
              phx-click="close_email_change"
              class="w-full mt-5 text-[10px] font-black uppercase tracking-widest text-slate-300 hover:text-slate-500 transition-colors"
            >
              Cancel
            </button>
          </div>
        </div>
      <% end %>
       <%!-- Mandatory Phone Modal --%>
      <%= if @show_phone_modal do %>
        <div class="fixed inset-0 bg-slate-950/80 backdrop-blur-md flex items-center justify-center z-[100] p-4">
          <div class="bg-white rounded-[2.5rem] max-w-md w-full p-10 shadow-2xl animate-fade-in-up border border-slate-100">
            <div class="text-center mb-10">
              <div class="w-20 h-20 bg-orange-50 rounded-3xl flex items-center justify-center text-[#FF4C00] mx-auto mb-6 shadow-sm border border-orange-100">
                <span class="material-symbols-outlined !text-4xl">phone_iphone</span>
              </div>
              
              <h2 class="text-3xl font-black text-slate-900 tracking-tighter mb-2">
                Complete Profile
              </h2>
              
              <p class="text-sm font-bold text-slate-400">
                Please provide your phone number to continue using KOMIUTA services.
              </p>
            </div>
            
            <form phx-submit="save_missing_phone" class="space-y-6">
              <div>
                <label class="block text-[10px] font-black text-slate-500 uppercase mb-2 tracking-widest">Phone Number</label>
                <div class="relative">
                  <input
                    type="tel"
                    name="phone"
                    placeholder="07XX XXX XXX"
                    class="w-full p-4 pl-12 bg-slate-50 border-2 border-slate-100 rounded-2xl font-black text-slate-900 focus:bg-white focus:border-[#FF4C00] outline-none transition-all shadow-sm"
                    required
                  />
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-slate-300">call</span>
                </div>
                
                <%= if @phone_error do %>
                  <p class="text-[10px] font-bold text-red-500 mt-2 flex items-center gap-1">
                    <span class="material-symbols-outlined !text-xs">error</span> {@phone_error}
                  </p>
                <% end %>
              </div>
              
              <button
                type="submit"
                class="w-full bg-[#FF4C00] text-white py-5 rounded-2xl font-black text-sm uppercase tracking-widest shadow-xl shadow-orange-500/20 hover:bg-[#E64400] transition-all transform active:scale-95 flex items-center justify-center gap-2"
              >
                Secure My Account <span class="material-symbols-outlined">arrow_forward</span>
              </button>
            </form>
            
            <div class="mt-8 pt-8 border-t border-slate-50 text-center">
              <p class="text-[9px] font-black text-slate-300 tracking-[0.2em]">
                KOMIUTA Gold Standard Identity Protection
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </main>
     <.main_footer footer_tab={@footer_tab} />
  </div>
  
  <script :type={Phoenix.LiveView.ColocatedHook} name=".CopyReferral">
    export default {
      mounted() {
        this.el.addEventListener("click", async () => {
          const code = this.el.dataset.code
          try {
            if (navigator.clipboard) {
              await navigator.clipboard.writeText(code)
              this.pushEvent("referral_copied", {})
            } else {
              this.pushEvent("referral_copy_failed", {})
            }
          } catch (_error) {
            this.pushEvent("referral_copy_failed", {})
          }
        })
      }
    }
  </script>
</Layouts.app>
