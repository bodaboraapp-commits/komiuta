<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-[#f8fafc] px-4 py-8 sm:px-6 md:py-10">
    <main id="ai-trip-builder" class="mx-auto max-w-[1100px]">
      <%!-- Wizard progress --%>
      <section class="rounded-[28px] border border-slate-100 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04)] md:p-6">
        <ol class="relative grid grid-cols-5 gap-1">
          <span
            class="pointer-events-none absolute left-[10%] right-[10%] top-5 border-t border-dashed border-slate-200"
            aria-hidden="true"
          ></span>

          <%= for step <- @steps do %>
            <li class="relative z-10 flex flex-col items-center gap-2 text-center">
              <span class={[
                "grid h-10 w-10 place-items-center rounded-full border-2 transition-colors",
                @step >= step.key &&
                  "border-[#FF4C00] bg-[#FF4C00] text-white shadow-lg shadow-orange-500/20",
                @step < step.key && "border-slate-200 bg-white text-slate-400"
              ]}>
                <.ui_icon name={step.icon} class="h-5 w-5" />
              </span>
              <span class={[
                "text-[8px] font-black uppercase tracking-[0.14em] sm:text-[9px]",
                @step >= step.key && "text-slate-900",
                @step < step.key && "text-slate-400"
              ]}>
                <span class="block text-[9px] font-black text-slate-400">
                  {String.pad_leading(to_string(step.key), 2, "0")}
                </span>
                {step.title}
              </span>
            </li>
          <% end %>
        </ol>
      </section>

      <%!-- Step content --%>
      <section class="mt-5 rounded-[28px] border border-slate-100 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04)] md:p-8">
        <%= if @error do %>
          <div
            id="builder-error"
            class="mb-5 rounded-2xl border border-red-100 bg-red-50 px-4 py-3 text-xs font-bold text-red-700"
          >
            {@error}
          </div>
        <% end %>

        <%= if @step == 1 do %>
          <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1fr)_360px]">
            <div class="min-w-0">
              <p class="flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.24em] text-[#FF4C00]">
                <.ui_icon name={:sparkles} class="h-4 w-4" /> Where do you want to go?
              </p>
              <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-900 md:text-4xl">
                Find your dream destination
              </h1>
              <p class="mt-2 max-w-md text-sm font-bold leading-relaxed text-slate-400">
                Search any city, country, or landmark worldwide, or click a trending destination
                below to begin.
              </p>

              <form
                id="destination-search-form"
                phx-submit="search_destination"
                class="mt-5 flex items-center gap-2 rounded-2xl border border-slate-200 bg-white p-1.5 pl-4 shadow-sm focus-within:border-[#FF4C00]"
              >
                <.ui_icon name={:pin} class="h-5 w-5 shrink-0 text-slate-400" />
                <input
                  id="destination-search"
                  type="text"
                  name="query"
                  value={@query}
                  placeholder="Search destination (e.g. Paris, Tokyo, Bali)..."
                  autocomplete="off"
                  class="min-w-0 flex-1 border-0 bg-transparent py-2 text-sm font-bold text-slate-700 outline-none placeholder:text-slate-400"
                />
                <button
                  id="destination-search-submit"
                  type="submit"
                  aria-label="Search destination"
                  class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[#FF4C00] text-white transition hover:bg-[#E64400]"
                >
                  <.ui_icon name={:search} class="h-4 w-4" />
                </button>
              </form>

              <div class="mt-4 flex flex-wrap gap-2">
                <%= for {icon, label} <- [
                      {:check, "Personalized Day-by-Day Plan"},
                      {:sparkles, "Hidden Gems & Local Tips"},
                      {:route, "Optimized Travel Routes"}
                    ] do %>
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-100 bg-slate-50 px-3 py-1.5 text-[10px] font-black text-slate-600">
                    <.ui_icon name={icon} class="h-3.5 w-3.5 text-[#FF4C00]" /> {label}
                  </span>
                <% end %>
              </div>
            </div>

            <div class="relative hidden overflow-hidden rounded-[24px] lg:block">
              <.trip_art variant={:mountains} tag="ai-builder-hero" class="h-[252px] w-full" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 via-transparent to-transparent">
              </div>
              <p class="absolute bottom-4 left-4 right-4 text-xs font-black text-white">
                Tell Chyllz AI where you dream of going — it builds the rest around you.
              </p>
            </div>
          </div>

          <div class="mt-7">
            <h2 class="flex items-center gap-2 text-base font-black tracking-tight text-slate-900">
              <span aria-hidden="true">🔥</span> Trending Destinations
            </h2>

            <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
              <%= for destination <- @destinations do %>
                <button
                  type="button"
                  id={"destination-" <> destination.tag}
                  phx-click="choose_destination"
                  phx-value-destination={destination.name}
                  phx-value-country={destination.country}
                  class="group relative h-36 overflow-hidden rounded-2xl text-left transition-transform hover:-translate-y-0.5"
                >
                  <.trip_art
                    variant={destination.art}
                    tag={"builder-" <> destination.tag}
                    class="absolute inset-0 h-full w-full"
                  />
                  <span class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/10 to-transparent"></span>
                  <span class="absolute inset-x-3 bottom-3 text-white">
                    <span class="flex items-center gap-1 text-xs font-black">
                      <.ui_icon name={:pin} class="h-3.5 w-3.5 text-[#FF8A00]" />
                      {destination.name}
                    </span>
                    <span class="mt-0.5 block text-[9px] font-bold text-white/70">
                      {destination.country}
                    </span>
                  </span>
                  <span class="absolute bottom-3 right-3 grid h-7 w-7 place-items-center rounded-full bg-white/20 text-white backdrop-blur transition group-hover:bg-[#FF4C00]">
                    <.ui_icon name={:chevron_right} class="h-3.5 w-3.5" />
                  </span>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>

        <%= if @step == 2 do %>
          <div id="step-dates" class="mx-auto max-w-3xl">
            <div class="flex justify-center">
              <div class="inline-flex max-w-full items-center gap-2 rounded-full border border-orange-200 bg-orange-50/70 px-3 py-1.5 text-[10px] font-black text-slate-700">
                <.ui_icon name={:pin} class="h-3.5 w-3.5 shrink-0 text-[#FF4C00]" />
                <span class="max-w-[190px] truncate">{@trip.destination}</span>
                <button
                  id="change-destination"
                  type="button"
                  phx-click="change_destination"
                  class="inline-flex shrink-0 items-center gap-1 rounded-full bg-white px-2 py-1 text-[9px] font-black uppercase tracking-widest text-[#FF4C00] shadow-sm"
                >
                  <.ui_icon name={:search} class="h-3 w-3" /> Change
                </button>
              </div>
            </div>

            <h1 class="mt-4 text-center text-2xl font-black tracking-tight text-slate-900 md:text-3xl">
              When will you want to go? <span aria-hidden="true">🗓️</span>
            </h1>
            <p class="mt-1 text-center text-sm font-bold leading-relaxed text-slate-400">
              Select your start and end dates to construct a well-timed daily itinerary.
            </p>

            <div class="mt-4 flex justify-center">
              <span
                id="date-range-label"
                class="rounded-full border border-orange-200 bg-orange-50 px-4 py-1.5 text-[10px] font-black text-[#FF4C00]"
              >
                {range_label(@trip)}
              </span>
            </div>

            <div class="mt-5">
              <div class="flex items-center justify-between px-2">
                <button
                  id="calendar-prev"
                  type="button"
                  phx-click="calendar_shift"
                  phx-value-shift="-2"
                  aria-label="Previous months"
                  class="grid h-9 w-9 place-items-center rounded-full border border-slate-200 bg-white text-slate-500 transition hover:border-[#FF4C00] hover:text-[#FF4C00]"
                >
                  <.ui_icon name={:chevron_right} class="h-4 w-4 rotate-180" />
                </button>
                <span class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-300">
                  Two-month view
                </span>
                <button
                  id="calendar-next"
                  type="button"
                  phx-click="calendar_shift"
                  phx-value-shift="2"
                  aria-label="Next months"
                  class="grid h-9 w-9 place-items-center rounded-full border border-slate-200 bg-white text-slate-500 transition hover:border-[#FF4C00] hover:text-[#FF4C00]"
                >
                  <.ui_icon name={:chevron_right} class="h-4 w-4" />
                </button>
              </div>

              <div class="mt-2 grid grid-cols-1 gap-6 md:grid-cols-2">
                <%= for month <- calendar_months(@calendar_month) do %>
                  <div>
                    <p class="text-center text-sm font-black text-slate-800">{month.label}</p>
                    <div class="mt-3 grid grid-cols-7 gap-y-1 text-center">
                      <%= for weekday <- ~w(SU MO TU WE TH FR SA) do %>
                        <span class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                          {weekday}
                        </span>
                      <% end %>

                      <%= for day <- List.flatten(month.weeks) do %>
                        <%= if day do %>
                          <button
                            type="button"
                            id={"calendar-day-" <> Date.to_iso8601(day)}
                            phx-click="pick_date"
                            phx-value-date={Date.to_iso8601(day)}
                            aria-label={"Select " <> Date.to_iso8601(day)}
                            class={[
                              "mx-auto grid h-8 w-8 place-items-center text-[11px] font-bold transition",
                              calendar_day_class(day, @trip, @today)
                            ]}
                          >
                            {day.day}
                          </button>
                        <% else %>
                          <span class="h-8 w-8"></span>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>

              <%= if @trip.start_date && @trip.end_date do %>
                <% days = duration_days(@trip.start_date, @trip.end_date) %>
                <div
                  id="date-range-summary"
                  class="mt-5 grid grid-cols-1 divide-y divide-slate-100 overflow-hidden rounded-2xl border border-slate-100 bg-white text-left shadow-sm sm:grid-cols-3 sm:divide-x sm:divide-y-0"
                >
                  <div class="flex items-center gap-3 px-4 py-3">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-orange-50 text-[#FF4C00]">
                      <.ui_icon name={:clock} class="h-4 w-4" />
                    </span>
                    <span>
                      <span class="block text-[8px] font-black uppercase tracking-[0.18em] text-slate-400">
                        Duration
                      </span>
                      <span class="block text-sm font-black text-slate-900">{days} Days</span>
                    </span>
                  </div>
                  <div class="flex items-center gap-3 px-4 py-3">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-orange-50 text-[#FF4C00]">
                      <.ui_icon name={:sparkles} class="h-4 w-4" />
                    </span>
                    <span>
                      <span class="block text-[8px] font-black uppercase tracking-[0.18em] text-slate-400">
                        Estimated cost
                      </span>
                      <span id="estimated-credits" class="block text-sm font-black text-slate-900">
                        {estimated_credits(@trip.start_date, @trip.end_date)} Credits
                      </span>
                    </span>
                  </div>
                  <div class="flex items-center gap-3 px-4 py-3">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-orange-50 text-[#FF4C00]">
                      <.ui_icon name={:wallet} class="h-4 w-4" />
                    </span>
                    <span>
                      <span class="block text-[8px] font-black uppercase tracking-[0.18em] text-slate-400">
                        Your balance
                      </span>
                      <span id="credit-balance" class="block text-sm font-black text-slate-900">
                        {credit_balance()} Credits
                      </span>
                    </span>
                  </div>
                </div>
              <% end %>
            </div>

            <div class="mt-7 flex items-center justify-between border-t border-slate-100 pt-4">
              <button
                type="button"
                phx-click="back"
                class="inline-flex items-center gap-1 rounded-xl border border-slate-200 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-600 transition hover:border-slate-300"
              >
                <.ui_icon name={:chevron_right} class="h-3.5 w-3.5 rotate-180" /> Previous
              </button>
              <span class="text-[10px] font-bold text-slate-400">Step 2 of 5</span>
              <button
                id="dates-next"
                type="button"
                phx-click="dates_next"
                disabled={is_nil(@trip.start_date) or is_nil(@trip.end_date)}
                class={[
                  "inline-flex items-center gap-1 rounded-xl px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-white transition",
                  !is_nil(@trip.start_date) && !is_nil(@trip.end_date) &&
                    "bg-[#FF4C00] shadow-lg shadow-orange-500/25 hover:bg-[#E64400]",
                  (is_nil(@trip.start_date) || is_nil(@trip.end_date)) &&
                    "cursor-not-allowed bg-slate-200 text-slate-400"
                ]}
              >
                Next <.ui_icon name={:arrow_right} class="h-3.5 w-3.5" />
              </button>
            </div>
          </div>
        <% end %>

        <%= if @step == 3 do %>
          <div id="step-companions" class="mx-auto max-w-4xl">
            <div class="flex justify-center">
              <div class="inline-flex max-w-full items-center gap-2 rounded-full border border-orange-200 bg-orange-50/70 px-3 py-1.5 text-[10px] font-black text-slate-700">
                <.ui_icon name={:pin} class="h-3.5 w-3.5 shrink-0 text-[#FF4C00]" />
                <span class="max-w-[190px] truncate">{@trip.destination}</span>
                <button
                  id="change-destination"
                  type="button"
                  phx-click="change_destination"
                  class="inline-flex shrink-0 items-center gap-1 rounded-full bg-white px-2 py-1 text-[9px] font-black uppercase tracking-widest text-[#FF4C00] shadow-sm"
                >
                  <.ui_icon name={:search} class="h-3 w-3" /> Change
                </button>
              </div>
            </div>

            <h1 class="mt-4 text-center text-2xl font-black tracking-tight text-slate-900 md:text-3xl">
              Who is traveling with you? <span aria-hidden="true">🧑‍🤝‍🧑</span>
            </h1>
            <p class="mt-1 text-center text-sm font-bold leading-relaxed text-slate-400">
              Select your travel companions to customize recommendations for your group.
            </p>

            <div class="mt-6 flex flex-wrap justify-center gap-3">
              <%= for party <- @parties do %>
                <% selected = @trip.travel_party == party.key %>
                <button
                  type="button"
                  id={"companion-" <> party.key}
                  phx-click="select_companions"
                  phx-value-party={party.key}
                  aria-pressed={to_string(selected)}
                  class={[
                    "flex w-full max-w-[320px] items-start gap-3 rounded-2xl border-2 bg-white px-4 py-4 text-left shadow-sm transition sm:w-[260px]",
                    selected && "border-[#FF4C00] bg-orange-50/60 shadow-orange-100",
                    !selected && "border-slate-100 hover:border-orange-200 hover:bg-orange-50/30"
                  ]}
                >
                  <span class={[
                    "grid h-9 w-9 shrink-0 place-items-center rounded-xl",
                    selected && "bg-[#FF4C00] text-white",
                    !selected && "bg-orange-50 text-[#FF4C00]"
                  ]}>
                    <.ui_icon name={party.icon} class="h-4.5 w-4.5" />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-sm font-black text-slate-900">{party.title}</span>
                    <span class="mt-1 block text-[11px] font-bold leading-snug text-slate-400">
                      {party.description}
                    </span>
                  </span>
                </button>
              <% end %>
            </div>

            <div class="mt-6 flex flex-col gap-4 rounded-2xl border border-slate-100 bg-slate-50/60 p-4 sm:flex-row sm:items-center">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-amber-50 text-amber-500">
                <.ui_icon name={:paw} class="h-5 w-5" />
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-xs font-black text-slate-900">Are you traveling with pets?</p>
                <p class="mt-1 text-[11px] font-bold leading-relaxed text-slate-400">
                  We'll scan reviews and recommendations of travelers with pets to highlight pet-friendly
                  options, though some recommendations may not be entirely accommodating for pets.
                </p>
              </div>
              <div class="flex shrink-0 gap-2">
                <button
                  type="button"
                  id="pets-yes"
                  phx-click="toggle_pets"
                  phx-value-value="yes"
                  aria-pressed={to_string(@trip.pets)}
                  class={[
                    "rounded-full border px-4 py-2 text-[10px] font-black uppercase tracking-widest transition",
                    @trip.pets && "border-[#FF4C00] bg-[#FF4C00] text-white",
                    !@trip.pets &&
                      "border-slate-200 bg-white text-slate-600 hover:border-[#FF4C00] hover:text-[#FF4C00]"
                  ]}
                >
                  Yes
                </button>
                <button
                  type="button"
                  id="pets-no"
                  phx-click="toggle_pets"
                  phx-value-value="no"
                  aria-pressed={to_string(!@trip.pets)}
                  class={[
                    "rounded-full border px-4 py-2 text-[10px] font-black uppercase tracking-widest transition",
                    !@trip.pets && "border-[#FF4C00] bg-[#FF4C00] text-white",
                    @trip.pets &&
                      "border-slate-200 bg-white text-slate-600 hover:border-[#FF4C00] hover:text-[#FF4C00]"
                  ]}
                >
                  No
                </button>
              </div>
            </div>

            <div class="mt-7 flex items-center justify-between border-t border-slate-100 pt-4">
              <button
                type="button"
                phx-click="back"
                class="inline-flex items-center gap-1 rounded-xl border border-slate-200 bg-slate-100 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-600 transition hover:border-slate-300"
              >
                <.ui_icon name={:chevron_right} class="h-3.5 w-3.5 rotate-180" /> Previous
              </button>
              <span class="text-[10px] font-bold text-slate-400">Step 3 of 5</span>
              <button
                id="companions-next"
                type="button"
                phx-click="companions_next"
                disabled={is_nil(@trip.travel_party)}
                class={[
                  "inline-flex items-center gap-1 rounded-xl px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-white transition",
                  !is_nil(@trip.travel_party) &&
                    "bg-[#FF4C00] shadow-lg shadow-orange-500/25 hover:bg-[#E64400]",
                  is_nil(@trip.travel_party) && "cursor-not-allowed bg-slate-200 text-slate-400"
                ]}
              >
                Next <.ui_icon name={:arrow_right} class="h-3.5 w-3.5" />
              </button>
            </div>
          </div>
        <% end %>

        <%= if @step == 4 do %>
          <div id="step-budget" class="mx-auto max-w-xl">
            <p class="text-[10px] font-black uppercase tracking-[0.24em] text-[#FF4C00]">
              Step 04 · Budget
            </p>
            <h1 class="mt-2 text-2xl font-black tracking-tight text-slate-900 md:text-3xl">
              What's your budget?
            </h1>
            <p class="mt-2 text-sm font-bold text-slate-400">
              A rough range is enough — we'll suggest options that fit.
            </p>

            <form id="budget-form" phx-submit="budget" class="mt-6 space-y-2">
              <%= for budget <- @budgets do %>
                <label class={[
                  "flex cursor-pointer items-center gap-3 rounded-xl border-2 px-4 py-3 transition",
                  @trip.budget == budget && "border-[#FF4C00] bg-orange-50",
                  @trip.budget != budget && "border-slate-100 bg-white hover:border-slate-200"
                ]}>
                  <input
                    type="radio"
                    name="budget"
                    value={budget}
                    checked={@trip.budget == budget}
                    class="h-4 w-4 accent-[#FF4C00]"
                  />
                  <span class="text-sm font-black text-slate-700">{budget}</span>
                </label>
              <% end %>

              <div class="flex gap-2 pt-3">
                <button
                  type="button"
                  phx-click="back"
                  class="rounded-xl border border-slate-200 px-5 py-3 text-[10px] font-black uppercase tracking-widest text-slate-600 hover:border-slate-300"
                >
                  Back
                </button>
                <button
                  type="submit"
                  class="flex-1 rounded-xl bg-[#FF4C00] px-5 py-3 text-[10px] font-black uppercase tracking-widest text-white hover:bg-[#E64400]"
                >
                  Continue
                </button>
              </div>
            </form>
          </div>
        <% end %>

        <%= if @step == 5 do %>
          <div id="step-preferences" class="mx-auto max-w-xl">
            <p class="text-[10px] font-black uppercase tracking-[0.24em] text-[#FF4C00]">
              Step 05 · Preferences
            </p>
            <h1 class="mt-2 text-2xl font-black tracking-tight text-slate-900 md:text-3xl">
              What do you love doing?
            </h1>
            <p class="mt-2 text-sm font-bold text-slate-400">
              Pick as many as you like — this is what Chyllz AI uses to shape your itinerary.
            </p>

            <div id="preference-chips" class="mt-5 flex flex-wrap gap-2">
              <%= for preference <- @preferences do %>
                <button
                  type="button"
                  id={"preference-" <> String.downcase(preference)}
                  phx-click="toggle_preference"
                  phx-value-preference={preference}
                  class={[
                    "rounded-full border-2 px-4 py-2 text-[10px] font-black uppercase tracking-widest transition",
                    preference in @trip.preferences &&
                      "border-[#FF4C00] bg-[#FF4C00] text-white",
                    preference not in @trip.preferences &&
                      "border-slate-100 bg-white text-slate-600 hover:border-[#FF4C00] hover:text-[#FF4C00]"
                  ]}
                  aria-pressed={to_string(preference in @trip.preferences)}
                >
                  {preference}
                </button>
              <% end %>
            </div>

            <div class="mt-6 flex gap-2">
              <button
                type="button"
                phx-click="back"
                class="rounded-xl border border-slate-200 px-5 py-3 text-[10px] font-black uppercase tracking-widest text-slate-600 hover:border-slate-300"
              >
                Back
              </button>
              <button
                id="build-itinerary"
                type="button"
                phx-click="finish"
                class="flex-1 rounded-xl bg-[#FF4C00] px-5 py-3 text-[10px] font-black uppercase tracking-widest text-white hover:bg-[#E64400]"
              >
                Build My Itinerary
              </button>
            </div>
          </div>
        <% end %>

        <%= if @step >= 6 do %>
          <div id="step-summary" class="mx-auto max-w-xl text-center">
            <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-orange-50 text-[#FF4C00]">
              <.ui_icon name={:sparkles} class="h-7 w-7" />
            </span>
            <h1 class="mt-4 text-2xl font-black tracking-tight text-slate-900 md:text-3xl">
              Your trip brief is ready
            </h1>
            <p class="mt-2 text-sm font-bold text-slate-400">
              Chyllz AI will use this brief to build a day-by-day plan, routes and local tips.
            </p>

            <dl class="mt-6 space-y-2 rounded-2xl border border-slate-100 bg-slate-50/60 p-4 text-left">
              <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-2">
                <dt class="text-[10px] font-black uppercase tracking-[0.18em] text-slate-400">
                  Destination
                </dt>
                <dd class="text-right text-sm font-black text-slate-800">
                  {@trip.destination}
                  <%= if @trip.country != "" do %>
                    <span class="block text-[10px] font-bold text-slate-400">{@trip.country}</span>
                  <% end %>
                </dd>
              </div>
              <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-2">
                <dt class="text-[10px] font-black uppercase tracking-[0.18em] text-slate-400">
                  Dates
                </dt>
                <dd class="text-right text-sm font-black text-slate-800">
                  {travel_label(@trip)}
                </dd>
              </div>
              <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-2">
                <dt class="text-[10px] font-black uppercase tracking-[0.18em] text-slate-400">
                  Travellers
                </dt>
                <dd class="text-right text-sm font-black text-slate-800">
                  {companion_label(@trip)}{pets_label(@trip)}
                </dd>
              </div>
              <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-2">
                <dt class="text-[10px] font-black uppercase tracking-[0.18em] text-slate-400">
                  Budget
                </dt>
                <dd class="text-right text-sm font-black text-slate-800">
                  {budget_label(@trip)}
                </dd>
              </div>
              <div class="flex items-start justify-between gap-4">
                <dt class="text-[10px] font-black uppercase tracking-[0.18em] text-slate-400">
                  Preferences
                </dt>
                <dd class="max-w-[60%] text-right text-sm font-black text-slate-800">
                  {preference_label(@trip.preferences)}
                </dd>
              </div>
            </dl>

            <div class="mt-6 flex flex-col gap-2 sm:flex-row">
              <a
                id="open-chyllz-ai"
                href="/tour-packages?assistant=1"
                class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-[#FF4C00] px-5 py-3 text-[10px] font-black uppercase tracking-widest text-white hover:bg-[#E64400]"
              >
                <.ui_icon name={:sparkles} class="h-4 w-4" /> Build with Chyllz AI
              </a>
              <a
                id="browse-chyllz"
                href="/tour-packages"
                class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl border border-slate-200 px-5 py-3 text-[10px] font-black uppercase tracking-widest text-slate-700 hover:border-[#FF4C00] hover:text-[#FF4C00]"
              >
                Browse Chyllz
              </a>
            </div>
            <button
              type="button"
              phx-click="restart"
              class="mt-4 text-[10px] font-black uppercase tracking-widest text-slate-400 hover:text-[#FF4C00]"
            >
              Start over
            </button>
          </div>
        <% end %>
      </section>
    </main>
  </div>
</Layouts.app>
