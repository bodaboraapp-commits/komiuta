<Layouts.app flash={@flash}>
  <.main_header step={:chyllz} current_user={@current_user && @current_user.phone} />
  <%= if @generating do %>
    <div
      id="trip-generating"
      class="fixed inset-0 z-[90] flex min-h-screen flex-col items-center justify-center bg-[#fff8f3] px-6 text-center"
    >
      <div class="relative">
        <div class="relative grid h-36 w-36 place-items-center rounded-full bg-orange-100/70 text-[#FF4C00] shadow-inner ring-8 ring-white/60">
          <span class="absolute inset-0 animate-ping rounded-full border-2 border-orange-300/50"></span>
          <.ui_icon name={:bot} class="h-16 w-16" />
        </div>

        <span
          class="absolute -bottom-1 left-1/2 flex -translate-x-1/2 gap-1 text-amber-400"
          aria-hidden="true"
        >
          <.ui_icon name={:sparkles} class="h-4 w-4" />
          <.ui_icon name={:sparkles} class="h-3 w-3" />
        </span>
      </div>

      <h1 class="mt-7 text-2xl font-black tracking-tight text-slate-900 md:text-[28px]">
        Generating Your Trip
      </h1>

      <p id="generation-message" class="mt-2 text-sm font-bold text-slate-500">
        {@generation_message}
      </p>

      <p
        id="generation-detail"
        class="mt-1 max-w-md text-xs font-bold leading-relaxed text-slate-400"
      >
        {@generation_detail}
      </p>

      <div class="mt-4 flex items-center gap-2 text-[9px] font-black uppercase tracking-[0.18em] text-orange-400">
        <span>Task {@generation_stage + 1} of {@generation_total}</span>
        <span class="h-1 w-1 rounded-full bg-orange-300"></span>
        <span>{@generation_task_label}</span>
      </div>

      <div class="mt-3 w-64">
        <div class="h-2 overflow-hidden rounded-full bg-orange-100">
          <div
            class="h-full rounded-full bg-gradient-to-r from-[#FF4C00] to-amber-400 transition-all duration-700"
            style={"width: #{round((@generation_stage + 1) / @generation_total * 100)}%"}
          >
          </div>
        </div>
      </div>

      <div class="mt-6 flex items-center gap-2" aria-hidden="true">
        <span class="h-2.5 w-2.5 animate-bounce rounded-full bg-[#FF4C00]"></span>
        <span
          class="h-2.5 w-2.5 animate-bounce rounded-full bg-[#FF4C00]"
          style="animation-delay: .15s"
        ></span>
        <span
          class="h-2.5 w-2.5 animate-bounce rounded-full bg-[#FF4C00]"
          style="animation-delay: .3s"
        ></span>
      </div>

      <div
        id="generation-slow"
        data-generation-slow
        phx-hook=".GenerationSlow"
        hidden
        class="mt-7 max-w-md rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-left"
      >
        <p class="text-xs font-black text-amber-900">Still working on it</p>

        <p class="mt-1 text-[11px] font-bold leading-relaxed text-amber-800">
          Live Google results are taking longer than usual. We'll fall back to curated picks
          automatically — your trip will still be ready.
        </p>
      </div>

      <div
        id="generation-network-banner"
        data-network-banner
        phx-hook=".NetworkStatus"
        hidden
        class="mt-7 max-w-md rounded-2xl border border-slate-200 bg-white px-4 py-3 text-left shadow-lg"
      >
        <p class="text-xs font-black text-slate-900">Connection lost</p>

        <p
          id="generation-network-status"
          data-network-status
          class="mt-1 text-[11px] font-bold leading-relaxed text-slate-500"
        >
          We'll reconnect automatically. Your trip is still being prepared.
        </p>

        <button
          type="button"
          data-network-retry
          class="mt-3 rounded-lg bg-slate-900 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-white"
        >
          Retry now
        </button>
      </div>
    </div>
  <% end %>

  <div class="min-h-screen bg-[#f8fafc] px-4 pb-8 pt-20 sm:px-6 md:pb-10 md:pt-24">
    <div
      id="builder-network-banner"
      data-network-banner
      phx-hook=".NetworkStatus"
      hidden
      class="mx-auto mb-4 max-w-[1100px] rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3"
    >
      <p class="text-xs font-black text-amber-900">You're offline</p>

      <p
        id="builder-network-status"
        data-network-status
        class="mt-1 text-[11px] font-bold leading-relaxed text-amber-800"
      >
        Reconnect to load live destination search and Google recommendations. Your current trip
        details are safe.
      </p>

      <button
        type="button"
        data-network-retry
        class="mt-3 rounded-lg bg-amber-900 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-white"
      >
        Retry now
      </button>
    </div>

    <main
      id="ai-trip-builder"
      phx-hook="UnsavedChanges"
      data-dirty={to_string(@dirty)}
      class={[
        "mx-auto",
        @step >= 6 && "max-w-[1500px]",
        @step < 6 && "max-w-[1100px]"
      ]}
    >
      <%= if @refining && @itinerary do %>
        <div
          id="refine-banner"
          class="mb-4 flex flex-col gap-3 rounded-2xl border border-orange-200 bg-orange-50 px-4 py-3 sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="flex items-start gap-2.5">
            <span class="material-symbols-outlined !text-xl text-[#FF4C00]">edit</span>
            <div>
              <p class="text-xs font-black text-slate-800">Refining your itinerary</p>

              <p class="mt-0.5 text-[10px] font-bold text-slate-500">
                Update the trip details, then generate a fresh version. Your previous saved itinerary stays safe.
              </p>
            </div>
          </div>

          <button
            type="button"
            id="cancel-refine"
            phx-click="cancel_refine"
            class="shrink-0 rounded-xl border border-orange-200 bg-white px-3.5 py-2 text-[9px] font-black uppercase tracking-widest text-[#FF4C00] transition hover:bg-orange-50"
          >
            Back to itinerary
          </button>
        </div>
      <% end %>
      <%!-- Wizard progress --%>
      <section
        :if={@step < 6}
        class="rounded-[28px] border border-slate-100 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04)] md:p-6"
      >
        <ol class="relative grid grid-cols-5 gap-1">
          <span
            class="pointer-events-none absolute left-[10%] right-[10%] top-5 border-t border-dashed border-slate-200"
            aria-hidden="true"
          ></span>
          <%= for step <- @steps do %>
            <li class="relative z-10 flex flex-col items-center gap-2 text-center">
              <span class={[
                "grid h-10 w-10 place-items-center rounded-full border-2 transition-colors",
                @step >= step.key &&
                  "border-[#FF4C00] bg-[#FF4C00] text-white shadow-lg shadow-orange-500/20",
                @step < step.key && "border-slate-200 bg-white text-slate-400"
              ]}>
                <.ui_icon name={step.icon} class="h-5 w-5" />
              </span>

              <span class={[
                "text-[7px] font-black uppercase leading-tight tracking-[0.02em] sm:text-[9px] sm:tracking-[0.14em]",
                @step >= step.key && "text-slate-900",
                @step < step.key && "text-slate-400"
              ]}>
                <span class="block text-[8px] font-black text-slate-400 sm:text-[9px]">
                  {String.pad_leading(to_string(step.key), 2, "0")}
                </span>
                {step.title}
              </span>
            </li>
          <% end %>
        </ol>
      </section>
      <%!-- Step content --%>
      <section class={[
        "mt-5 rounded-[28px] border border-slate-100 bg-white shadow-[0_1px_2px_rgba(15,23,42,0.04)]",
        @step >= 6 && "overflow-clip",
        @step < 6 && "p-5 md:p-8"
      ]}>
        <%= if @error && !@generation_failed do %>
          <div
            id="builder-error"
            class="mb-5 rounded-2xl border border-red-100 bg-red-50 px-4 py-3 text-xs font-bold text-red-700"
          >
            {@error}
          </div>
        <% end %>

        <%= if @generation_failed do %>
          <div
            id="generation-failed"
            class="mb-5 rounded-2xl border border-red-100 bg-red-50 px-4 py-4"
          >
            <p class="text-sm font-black text-red-800">We couldn't finish your itinerary</p>

            <p class="mt-1 text-xs font-bold leading-relaxed text-red-700">
              Your details are safe. This is usually a temporary network or AI hiccup — try again,
              or go back and adjust your preferences.
            </p>

            <div class="mt-3 flex flex-wrap gap-2">
              <button
                type="button"
                id="retry-generation"
                phx-click="retry_generation"
                class="rounded-xl bg-red-600 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-red-700"
              >
                Try again
              </button>

              <button
                type="button"
                id="edit-preferences-after-failure"
                phx-click="back"
                class="rounded-xl border border-red-200 bg-white px-4 py-2 text-[10px] font-black uppercase tracking-widest text-red-700"
              >
                Edit preferences
              </button>
            </div>
          </div>
        <% end %>

        <%= if @step == 1 do %>
          <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1fr)_360px]">
            <div class="min-w-0">
              <p class="flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.24em] text-[#FF4C00]">
                <.ui_icon name={:sparkles} class="h-4 w-4" /> Where do you want to go?
              </p>

              <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-900 md:text-4xl">
                Find your dream destination
              </h1>

              <p class="mt-2 max-w-md text-sm font-bold leading-relaxed text-slate-400">
                Search any city, country, or landmark. Every match is a real place, and landmarks or
                vibes are looked up when you press search. Or start from a trending destination.
              </p>

              <form
                id="destination-search-form"
                phx-submit="search_destination"
                phx-change="destination_query"
                phx-debounce="250"
                class="mt-5 flex items-center gap-2 rounded-2xl border border-slate-200 bg-white p-1.5 pl-4 shadow-sm focus-within:border-[#FF4C00]"
              >
                <.ui_icon name={:pin} class="h-5 w-5 shrink-0 text-slate-400" />
                <input
                  id="destination-search"
                  type="text"
                  name="query"
                  value={@query}
                  placeholder="Search destination (e.g. Paris, Tokyo, Bali)..."
                  autocomplete="off"
                  class="min-w-0 flex-1 border-0 bg-transparent py-2 text-sm font-bold text-slate-700 outline-none placeholder:text-slate-400"
                />
                <button
                  id="destination-search-submit"
                  type="submit"
                  aria-label="Search destination"
                  class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[#FF4C00] text-white transition hover:bg-[#E64400]"
                >
                  <.ui_icon name={:search} class="h-4 w-4" />
                </button>
              </form>

              <div id="destination-search-results" class="mt-3" aria-live="polite">
                <%= cond do %>
                  <% @searching -> %>
                    <div
                      id="destination-search-loading"
                      class="flex items-center gap-2 rounded-2xl border border-slate-100 bg-white px-4 py-3 text-xs font-bold text-slate-400 shadow-sm"
                    >
                      <span class="h-4 w-4 animate-spin rounded-full border-2 border-slate-200 border-t-[#FF4C00]"></span>
                      Searching real destinations...
                    </div>
                  <% @suggestions != [] -> %>
                    <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-lg">
                      <%= for {place, index} <- Enum.with_index(@suggestions) do %>
                        <button
                          type="button"
                          id={"destination-suggestion-" <> Integer.to_string(index)}
                          phx-click="choose_suggestion"
                          phx-value-name={place.name}
                          phx-value-country={place.country}
                          phx-value-region={place.region || ""}
                          phx-value-latitude={place.latitude || ""}
                          phx-value-longitude={place.longitude || ""}
                          class="flex w-full items-center gap-3 border-b border-slate-50 px-4 py-3 text-left transition hover:bg-orange-50/60 last:border-b-0"
                        >
                          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-orange-50 text-[#FF4C00]">
                            <.ui_icon name={:pin} class="h-4 w-4" />
                          </span>

                          <span class="min-w-0 flex-1">
                            <span class="block truncate text-sm font-black text-slate-800">
                              {place.name}
                            </span>

                            <span class="block truncate text-[10px] font-bold text-slate-500">
                              {place.label}
                            </span>
                          </span>

                          <span class="shrink-0 text-[9px] font-black uppercase tracking-widest text-[#FF4C00]">
                            Select
                          </span>
                        </button>
                      <% end %>
                    </div>

                    <p class="mt-2 px-1 text-[10px] font-bold text-slate-500">
                      Real places matched by live geocoding. For a landmark or a vibe, press search
                      and we'll pinpoint the nearest real place.
                    </p>
                  <% @search_error -> %>
                    <div
                      id="destination-search-error"
                      class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3"
                    >
                      <p class="text-xs font-black text-amber-900">
                        We couldn't reach live destination search
                      </p>

                      <p class="mt-1 text-[11px] font-bold leading-relaxed text-amber-800">
                        Check your connection, then try again. Nothing you've entered has been lost.
                      </p>

                      <button
                        type="button"
                        id="retry-destination-search"
                        phx-click="retry_destination_search"
                        class="mt-3 rounded-lg bg-amber-900 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-white"
                      >
                        Try again
                      </button>
                    </div>
                  <% @search_empty -> %>
                    <div
                      id="destination-search-empty"
                      class="rounded-2xl border border-dashed border-slate-200 bg-white px-4 py-3"
                    >
                      <p class="text-xs font-bold text-slate-500">
                        No real place matches "{@query}". Try a nearby city or country, or describe
                        the vibe and let Chyllz AI pinpoint the nearest real place.
                      </p>

                      <button
                        type="button"
                        id="destination-search-empty-retry"
                        phx-click="retry_destination_search"
                        class="mt-3 rounded-lg border border-slate-200 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-slate-600 hover:border-[#FF4C00] hover:text-[#FF4C00]"
                      >
                        Search again
                      </button>
                    </div>
                  <% true -> %>
                    <p class="px-1 text-[10px] font-bold text-slate-500">
                      Type a city, country or landmark - suggestions come from live geocoding.
                    </p>
                <% end %>
              </div>

              <div class="mt-4 flex flex-wrap gap-2">
                <%= for {icon, label} <- [
                      {:check, "Personalized Day-by-Day Plan"},
                      {:sparkles, "Hidden Gems & Local Tips"},
                      {:route, "Optimized Travel Routes"}
                    ] do %>
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-100 bg-slate-50 px-3 py-1.5 text-[10px] font-black text-slate-600">
                    <.ui_icon name={icon} class="h-3.5 w-3.5 text-[#FF4C00]" /> {label}
                  </span>
                <% end %>
              </div>
            </div>

            <div class="relative hidden overflow-hidden rounded-[24px] lg:block">
              <.trip_art variant={:mountains} tag="ai-builder-hero" class="h-[252px] w-full" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 via-transparent to-transparent">
              </div>

              <p class="absolute bottom-4 left-4 right-4 text-xs font-black text-white">
                Tell Chyllz AI where you dream of going — it builds the rest around you.
              </p>
            </div>
          </div>

          <div class="mt-7">
            <h2 class="flex items-center gap-2 text-base font-black tracking-tight text-slate-900">
              <.ui_icon name={:flame} class="h-4 w-4 text-[#FF4C00]" /> Trending Destinations
            </h2>

            <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-12">
              <%= for {destination, index} <- Enum.with_index(@destinations) do %>
                <button
                  type="button"
                  id={"destination-" <> destination.tag}
                  phx-click="choose_destination"
                  phx-value-destination={destination.name}
                  phx-value-country={destination.country}
                  phx-value-latitude={destination.latitude}
                  phx-value-longitude={destination.longitude}
                  class={[
                    "group relative h-36 overflow-hidden rounded-2xl text-left transition-transform hover:-translate-y-0.5",
                    "md:col-span-3",
                    index >= 4 && "md:col-span-4"
                  ]}
                >
                  <.trip_art
                    variant={destination.art}
                    tag={"builder-" <> destination.tag}
                    class="absolute inset-0 h-full w-full"
                  />
                  <span class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/10 to-transparent"></span>
                  <span class="absolute inset-x-3 bottom-3 text-white">
                    <span class="flex items-center gap-1 text-xs font-black">
                      <.ui_icon name={:pin} class="h-3.5 w-3.5 text-[#FF8A00]" /> {destination.name}
                    </span>

                    <span class="mt-0.5 block text-[9px] font-bold text-white/70">
                      {destination.country}
                    </span>
                  </span>

                  <span class="absolute bottom-3 right-3 grid h-7 w-7 place-items-center rounded-full bg-white/20 text-white backdrop-blur transition group-hover:bg-[#FF4C00]">
                    <.ui_icon name={:chevron_right} class="h-3.5 w-3.5" />
                  </span>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>

        <%= if @step == 2 do %>
          <div id="step-dates" class="mx-auto max-w-3xl">
            <div class="flex justify-center">
              <div class="inline-flex max-w-full items-center gap-2 rounded-full border border-orange-200 bg-orange-50/70 px-3 py-1.5 text-[10px] font-black text-slate-700">
                <.ui_icon name={:pin} class="h-3.5 w-3.5 shrink-0 text-[#FF4C00]" />
                <span class="max-w-[170px] truncate">{@trip.destination}</span>
                <%= if @trip.country not in [nil, ""] do %>
                  <span class="hidden max-w-[110px] truncate text-[9px] font-bold text-slate-400 sm:block">
                    {@trip.country}
                  </span>
                <% end %>

                <button
                  id="change-destination"
                  type="button"
                  phx-click="change_destination"
                  class="inline-flex shrink-0 items-center gap-1 rounded-full bg-white px-2 py-1 text-[9px] font-black uppercase tracking-widest text-[#FF4C00] shadow-sm"
                >
                  <.ui_icon name={:search} class="h-3 w-3" /> Change
                </button>
              </div>
            </div>

            <h1 class="mt-4 flex items-center justify-center gap-2 text-center text-2xl font-black tracking-tight text-slate-900 md:text-3xl">
              When will you want to go?
              <.ui_icon name={:calendar} class="h-6 w-6 text-[#FF4C00]" />
            </h1>

            <p class="mt-1 text-center text-sm font-bold leading-relaxed text-slate-400">
              Select your start and end dates to construct a well-timed daily itinerary.
            </p>

            <div class="mt-4 flex justify-center">
              <span
                id="date-range-label"
                class="rounded-full border border-orange-200 bg-orange-50 px-4 py-1.5 text-[10px] font-black text-[#FF4C00]"
              >
                {range_label(@trip)}
              </span>
            </div>

            <div class="mt-5">
              <div class="flex items-center justify-between px-2">
                <button
                  id="calendar-prev"
                  type="button"
                  phx-click="calendar_shift"
                  phx-value-shift="-2"
                  aria-label="Previous months"
                  class="grid h-9 w-9 place-items-center rounded-full border border-slate-200 bg-white text-slate-500 transition hover:border-[#FF4C00] hover:text-[#FF4C00]"
                >
                  <.ui_icon name={:chevron_right} class="h-4 w-4 rotate-180" />
                </button>

                <span class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-300">
                  Two-month view
                </span>

                <button
                  id="calendar-next"
                  type="button"
                  phx-click="calendar_shift"
                  phx-value-shift="2"
                  aria-label="Next months"
                  class="grid h-9 w-9 place-items-center rounded-full border border-slate-200 bg-white text-slate-500 transition hover:border-[#FF4C00] hover:text-[#FF4C00]"
                >
                  <.ui_icon name={:chevron_right} class="h-4 w-4" />
                </button>
              </div>

              <div class="mt-2 grid grid-cols-1 gap-6 md:grid-cols-2">
                <%= for month <- calendar_months(@calendar_month) do %>
                  <div>
                    <p class="text-center text-sm font-black text-slate-800">{month.label}</p>

                    <div class="mt-3 grid grid-cols-7 gap-y-1 text-center">
                      <%= for weekday <- ~w(SU MO TU WE TH FR SA) do %>
                        <span class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                          {weekday}
                        </span>
                      <% end %>

                      <%= for day <- List.flatten(month.weeks) do %>
                        <%= if day do %>
                          <button
                            type="button"
                            id={"calendar-day-" <> Date.to_iso8601(day)}
                            phx-click="pick_date"
                            phx-value-date={Date.to_iso8601(day)}
                            aria-label={"Select " <> Date.to_iso8601(day)}
                            class={[
                              "mx-auto grid h-8 w-8 place-items-center text-[11px] font-bold transition",
                              calendar_day_class(day, @trip, @today)
                            ]}
                          >
                            {day.day}
                          </button>
                        <% else %>
                          <span class="h-8 w-8"></span>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>

              <%= if @trip.start_date && @trip.end_date do %>
                <% days = duration_days(@trip.start_date, @trip.end_date) %>
                <div
                  id="date-range-summary"
                  class="mt-5 grid grid-cols-1 divide-y divide-slate-100 overflow-hidden rounded-2xl border border-slate-100 bg-white text-left shadow-sm sm:grid-cols-3 sm:divide-x sm:divide-y-0"
                >
                  <div class="flex items-center gap-3 px-4 py-3">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-orange-50 text-[#FF4C00]">
                      <.ui_icon name={:clock} class="h-4 w-4" />
                    </span>

                    <span>
                      <span class="block text-[8px] font-black uppercase tracking-[0.18em] text-slate-400">
                        Duration
                      </span>
                      <span class="block text-sm font-black text-slate-900">{days} Days</span>
                    </span>
                  </div>

                  <div class="flex items-center gap-3 px-4 py-3">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-orange-50 text-[#FF4C00]">
                      <.ui_icon name={:sparkles} class="h-4 w-4" />
                    </span>

                    <span>
                      <span class="block text-[8px] font-black uppercase tracking-[0.18em] text-slate-400">
                        Estimated cost
                      </span>

                      <span id="estimated-credits" class="block text-sm font-black text-slate-900">
                        {estimated_credits(@trip.start_date, @trip.end_date)} Credits
                      </span>
                    </span>
                  </div>

                  <div class="flex items-center gap-3 px-4 py-3">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-orange-50 text-[#FF4C00]">
                      <.ui_icon name={:wallet} class="h-4 w-4" />
                    </span>

                    <span>
                      <span class="block text-[8px] font-black uppercase tracking-[0.18em] text-slate-400">
                        Your balance
                      </span>

                      <span id="credit-balance" class="block text-sm font-black text-slate-900">
                        {credit_balance()} Credits
                      </span>
                    </span>
                  </div>
                </div>
              <% end %>
            </div>

            <div class="mt-7 flex items-center justify-between border-t border-slate-100 pt-4">
              <button
                type="button"
                phx-click="back"
                class="inline-flex items-center gap-1 rounded-xl border border-slate-200 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-600 transition hover:border-slate-300"
              >
                <.ui_icon name={:chevron_right} class="h-3.5 w-3.5 rotate-180" /> Previous
              </button>
              <span class="text-[10px] font-bold text-slate-400">Step 2 of 5</span>
              <button
                id="dates-next"
                type="button"
                phx-click="dates_next"
                disabled={is_nil(@trip.start_date) or is_nil(@trip.end_date)}
                class={[
                  "inline-flex items-center gap-1 rounded-xl px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-white transition",
                  !is_nil(@trip.start_date) && !is_nil(@trip.end_date) &&
                    "bg-[#FF4C00] shadow-lg shadow-orange-500/25 hover:bg-[#E64400]",
                  (is_nil(@trip.start_date) || is_nil(@trip.end_date)) &&
                    "cursor-not-allowed bg-slate-200 text-slate-400"
                ]}
              >
                Next <.ui_icon name={:arrow_right} class="h-3.5 w-3.5" />
              </button>
            </div>
          </div>
        <% end %>

        <%= if @step == 3 do %>
          <div id="step-companions" class="mx-auto max-w-4xl">
            <div class="flex justify-center">
              <div class="inline-flex max-w-full items-center gap-2 rounded-full border border-orange-200 bg-orange-50/70 px-3 py-1.5 text-[10px] font-black text-slate-700">
                <.ui_icon name={:pin} class="h-3.5 w-3.5 shrink-0 text-[#FF4C00]" />
                <span class="max-w-[170px] truncate">{@trip.destination}</span>
                <%= if @trip.country not in [nil, ""] do %>
                  <span class="hidden max-w-[110px] truncate text-[9px] font-bold text-slate-400 sm:block">
                    {@trip.country}
                  </span>
                <% end %>

                <button
                  id="change-destination"
                  type="button"
                  phx-click="change_destination"
                  class="inline-flex shrink-0 items-center gap-1 rounded-full bg-white px-2 py-1 text-[9px] font-black uppercase tracking-widest text-[#FF4C00] shadow-sm"
                >
                  <.ui_icon name={:search} class="h-3 w-3" /> Change
                </button>
              </div>
            </div>

            <h1 class="mt-4 flex items-center justify-center gap-2 text-center text-2xl font-black tracking-tight text-slate-900 md:text-3xl">
              Who is traveling with you? <.ui_icon name={:users} class="h-6 w-6 text-[#FF4C00]" />
            </h1>

            <p class="mt-1 text-center text-sm font-bold leading-relaxed text-slate-400">
              Select your travel companions to customize recommendations for your group.
            </p>

            <div class="mt-6 flex flex-wrap justify-center gap-3">
              <%= for party <- @parties do %>
                <% selected = @trip.travel_party == party.key %>
                <button
                  type="button"
                  id={"companion-" <> party.key}
                  phx-click="select_companions"
                  phx-value-party={party.key}
                  aria-pressed={to_string(selected)}
                  class={[
                    "flex w-full max-w-[320px] items-start gap-3 rounded-2xl border-2 bg-white px-4 py-4 text-left shadow-sm transition sm:w-[260px]",
                    selected && "border-[#FF4C00] bg-orange-50/60 shadow-orange-100",
                    !selected && "border-slate-100 hover:border-orange-200 hover:bg-orange-50/30"
                  ]}
                >
                  <span class={[
                    "grid h-9 w-9 shrink-0 place-items-center rounded-xl",
                    selected && "bg-[#FF4C00] text-white",
                    !selected && "bg-orange-50 text-[#FF4C00]"
                  ]}>
                    <.ui_icon name={party.icon} class="h-4.5 w-4.5" />
                  </span>

                  <span class="min-w-0">
                    <span class="block text-sm font-black text-slate-900">{party.title}</span>
                    <span class="mt-1 block text-[11px] font-bold leading-snug text-slate-400">
                      {party.description}
                    </span>
                  </span>
                </button>
              <% end %>
            </div>

            <div class="mt-6 flex flex-col gap-4 rounded-2xl border border-slate-100 bg-slate-50/60 p-4 sm:flex-row sm:items-center">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-amber-50 text-amber-500">
                <.ui_icon name={:paw} class="h-5 w-5" />
              </span>

              <div class="min-w-0 flex-1">
                <p class="text-xs font-black text-slate-900">Are you traveling with pets?</p>

                <p class="mt-1 text-[11px] font-bold leading-relaxed text-slate-400">
                  We'll scan reviews and recommendations of travelers with pets to highlight pet-friendly
                  options, though some recommendations may not be entirely accommodating for pets.
                </p>
              </div>

              <div class="flex shrink-0 gap-2">
                <button
                  type="button"
                  id="pets-yes"
                  phx-click="toggle_pets"
                  phx-value-value="yes"
                  aria-pressed={to_string(@trip.pets)}
                  class={[
                    "rounded-full border px-4 py-2 text-[10px] font-black uppercase tracking-widest transition",
                    @trip.pets && "border-[#FF4C00] bg-[#FF4C00] text-white",
                    !@trip.pets &&
                      "border-slate-200 bg-white text-slate-600 hover:border-[#FF4C00] hover:text-[#FF4C00]"
                  ]}
                >
                  Yes
                </button>

                <button
                  type="button"
                  id="pets-no"
                  phx-click="toggle_pets"
                  phx-value-value="no"
                  aria-pressed={to_string(!@trip.pets)}
                  class={[
                    "rounded-full border px-4 py-2 text-[10px] font-black uppercase tracking-widest transition",
                    !@trip.pets && "border-[#FF4C00] bg-[#FF4C00] text-white",
                    @trip.pets &&
                      "border-slate-200 bg-white text-slate-600 hover:border-[#FF4C00] hover:text-[#FF4C00]"
                  ]}
                >
                  No
                </button>
              </div>
            </div>

            <div class="mt-7 flex items-center justify-between border-t border-slate-100 pt-4">
              <button
                type="button"
                phx-click="back"
                class="inline-flex items-center gap-1 rounded-xl border border-slate-200 bg-slate-100 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-600 transition hover:border-slate-300"
              >
                <.ui_icon name={:chevron_right} class="h-3.5 w-3.5 rotate-180" /> Previous
              </button>
              <span class="text-[10px] font-bold text-slate-400">Step 3 of 5</span>
              <button
                id="companions-next"
                type="button"
                phx-click="companions_next"
                disabled={is_nil(@trip.travel_party)}
                class={[
                  "inline-flex items-center gap-1 rounded-xl px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-white transition",
                  !is_nil(@trip.travel_party) &&
                    "bg-[#FF4C00] shadow-lg shadow-orange-500/25 hover:bg-[#E64400]",
                  is_nil(@trip.travel_party) && "cursor-not-allowed bg-slate-200 text-slate-400"
                ]}
              >
                Next <.ui_icon name={:arrow_right} class="h-3.5 w-3.5" />
              </button>
            </div>
          </div>
        <% end %>

        <%= if @step == 4 do %>
          <div id="step-budget" class="mx-auto max-w-4xl">
            <div class="flex justify-center">
              <div class="inline-flex max-w-full items-center gap-2 rounded-full border border-orange-200 bg-orange-50/70 px-3 py-1.5 text-[10px] font-black text-slate-700">
                <.ui_icon name={:pin} class="h-3.5 w-3.5 shrink-0 text-[#FF4C00]" />
                <span class="max-w-[170px] truncate">{@trip.destination}</span>
                <%= if @trip.country not in [nil, ""] do %>
                  <span class="hidden max-w-[110px] truncate text-[9px] font-bold text-slate-400 sm:block">
                    {@trip.country}
                  </span>
                <% end %>

                <button
                  id="change-destination"
                  type="button"
                  phx-click="change_destination"
                  class="inline-flex shrink-0 items-center gap-1 rounded-full bg-white px-2 py-1 text-[9px] font-black uppercase tracking-widest text-[#FF4C00] shadow-sm"
                >
                  <.ui_icon name={:search} class="h-3 w-3" /> Change
                </button>
              </div>
            </div>

            <h1 class="mt-4 flex items-center justify-center gap-2 text-center text-2xl font-black tracking-tight text-slate-900 md:text-3xl">
              Set your trip budget <.ui_icon name={:money} class="h-6 w-6 text-[#FF4C00]" />
            </h1>

            <p class="mt-1 text-center text-sm font-bold leading-relaxed text-slate-400">
              Select your spending style to get appropriately matched lodging and dining recommendations.
            </p>

            <div class="mt-6 flex flex-wrap justify-center gap-3">
              <%= for budget <- @budgets do %>
                <% selected = @trip.budget == budget.key %>
                <button
                  type="button"
                  id={"budget-" <> budget.key}
                  phx-click="select_budget"
                  phx-value-budget={budget.key}
                  aria-pressed={to_string(selected)}
                  class={[
                    "flex w-full max-w-[260px] items-start gap-2.5 rounded-2xl border-2 bg-white px-3.5 py-3 text-left shadow-sm transition sm:w-[200px]",
                    selected && "border-[#FF4C00] bg-orange-50/60 shadow-orange-100",
                    !selected && "border-slate-100 hover:border-orange-200 hover:bg-orange-50/30"
                  ]}
                >
                  <span class={[
                    "grid h-7 w-7 shrink-0 place-items-center rounded-lg text-sm",
                    selected && "bg-[#FF4C00] text-white",
                    !selected && "bg-orange-50 text-[#FF4C00]"
                  ]}>
                    <.ui_icon name={budget.icon} class="h-3.5 w-3.5" />
                  </span>

                  <span class="min-w-0">
                    <span class="block text-[11px] font-black text-slate-900">{budget.title}</span>
                    <span class="mt-1 block text-[9px] font-bold leading-snug text-slate-400">
                      {budget.description}
                    </span>
                  </span>
                </button>
              <% end %>
            </div>

            <div class="mt-7 flex items-center justify-between border-t border-slate-100 pt-4">
              <button
                type="button"
                phx-click="back"
                class="inline-flex items-center gap-1 rounded-xl border border-slate-200 bg-slate-100 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-600 transition hover:border-slate-300"
              >
                <.ui_icon name={:chevron_right} class="h-3.5 w-3.5 rotate-180" /> Previous
              </button>
              <span class="text-[10px] font-bold text-slate-400">Step 4 of 5</span>
              <button
                id="budget-next"
                type="button"
                phx-click="budget_next"
                disabled={is_nil(@trip.budget)}
                class={[
                  "inline-flex items-center gap-1 rounded-xl px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-white transition",
                  !is_nil(@trip.budget) &&
                    "bg-[#FF4C00] shadow-lg shadow-orange-500/25 hover:bg-[#E64400]",
                  is_nil(@trip.budget) && "cursor-not-allowed bg-slate-200 text-slate-400"
                ]}
              >
                Next <.ui_icon name={:arrow_right} class="h-3.5 w-3.5" />
              </button>
            </div>
          </div>
        <% end %>

        <%= if @step == 5 do %>
          <div id="step-preferences" class="mx-auto max-w-3xl">
            <div class="flex justify-center">
              <div class="inline-flex max-w-full items-center gap-2 rounded-full border border-orange-200 bg-orange-50/70 px-3 py-1.5 text-[10px] font-black text-slate-700">
                <.ui_icon name={:pin} class="h-3.5 w-3.5 shrink-0 text-[#FF4C00]" />
                <span class="max-w-[170px] truncate">{@trip.destination}</span>
                <%= if @trip.country not in [nil, ""] do %>
                  <span class="hidden max-w-[110px] truncate text-[9px] font-bold text-slate-400 sm:block">
                    {@trip.country}
                  </span>
                <% end %>

                <button
                  id="change-destination"
                  type="button"
                  phx-click="change_destination"
                  class="inline-flex shrink-0 items-center gap-1 rounded-full bg-white px-2 py-1 text-[9px] font-black uppercase tracking-widest text-[#FF4C00] shadow-sm"
                >
                  <.ui_icon name={:search} class="h-3 w-3" /> Change
                </button>
              </div>
            </div>

            <h1 class="mt-4 flex items-center justify-center gap-2 text-center text-2xl font-black tracking-tight text-slate-900 md:text-3xl">
              Select your travel preferences
              <.ui_icon name={:compass} class="h-6 w-6 text-[#FF4C00]" />
            </h1>

            <p class="mt-1 text-center text-sm font-bold leading-relaxed text-slate-400">
              Choose activities and styles you enjoy most to enrich your personalized itinerary.
            </p>

            <div
              id="preference-chips"
              class="mx-auto mt-5 flex max-w-2xl flex-wrap justify-center gap-2"
            >
              <%= for preference <- @preferences do %>
                <% selected = preference.label in @trip.preferences %>
                <button
                  type="button"
                  id={"preference-" <> preference.key}
                  phx-click="toggle_preference"
                  phx-value-preference={preference.label}
                  class={[
                    "inline-flex items-center gap-1.5 rounded-xl border-2 bg-white px-3.5 py-2 text-[11px] font-bold text-slate-700 shadow-sm transition",
                    selected && "border-[#FF4C00] bg-orange-50 text-[#FF4C00]",
                    !selected &&
                      "border-slate-100 hover:border-orange-200 hover:bg-orange-50/40 hover:text-[#FF4C00]"
                  ]}
                  aria-pressed={to_string(selected)}
                >
                  <span aria-hidden="true">{preference.emoji}</span> {preference.label}
                </button>
              <% end %>
            </div>

            <div class="mt-7 flex items-center justify-between border-t border-slate-100 pt-4">
              <button
                type="button"
                phx-click="back"
                class="inline-flex items-center gap-1 rounded-xl border border-slate-200 bg-slate-100 px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-600 transition hover:border-slate-300"
              >
                <.ui_icon name={:chevron_right} class="h-3.5 w-3.5 rotate-180" /> Previous
              </button>
              <span class="text-[10px] font-bold text-slate-400">Step 5 of 5</span>
              <button
                id="build-itinerary"
                type="button"
                phx-click="finish"
                phx-hook=".OfflineGuard"
                class="inline-flex items-center gap-1.5 rounded-xl bg-[#FF4C00] px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-white shadow-lg shadow-orange-500/25 transition hover:bg-[#E64400]"
              >
                Generate Trip with AI <.ui_icon name={:arrow_right} class="h-3.5 w-3.5" />
              </button>
            </div>
          </div>
        <% end %>

        <%= if @step >= 6 && @itinerary do %>
          <div id="step-summary" class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_46%]">
            <article id="trip-itinerary" class="min-w-0 p-5 md:p-8">
              <p class="flex items-center gap-2 text-[11px] font-bold text-slate-500">
                <.ui_icon name={:sparkles} class="h-4 w-4 text-[#FF4C00]" /> Powered by AI
              </p>

              <p class="mt-8 text-xs font-bold text-slate-500">
                Review our recommendations for your trip
              </p>

              <h1
                id="itinerary-title"
                class="mt-2 text-2xl font-black tracking-tight text-slate-900"
              >
                {@itinerary.title}
              </h1>

              <p class="mt-4 text-sm font-bold leading-relaxed text-slate-500">
                {@itinerary.overview}
              </p>

              <%= if @recommendations_error || @itinerary.hotel_source != :google_maps || @itinerary.restaurant_source != :google_maps do %>
                <div
                  id="recommendations-fallback"
                  class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3"
                >
                  <p class="text-xs font-black text-amber-900">
                    Showing curated picks
                  </p>

                  <p
                    id="recommendations-status"
                    class="mt-1 text-[11px] font-bold leading-relaxed text-amber-800"
                  >
                    {@recommendations_error ||
                      "Live Google ratings couldn't load. Your itinerary is ready with curated stays and restaurants — retry live results without regenerating anything."}
                  </p>

                  <button
                    type="button"
                    id="retry-recommendations"
                    phx-click="retry_recommendations"
                    disabled={@recommendations_retrying}
                    class="mt-3 inline-flex items-center gap-2 rounded-lg bg-amber-900 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-white disabled:cursor-wait disabled:opacity-70"
                  >
                    <span
                      :if={@recommendations_retrying}
                      class="h-3 w-3 animate-spin rounded-full border-2 border-white/40 border-t-white"
                    ></span> {if @recommendations_retrying,
                      do: "Refreshing…",
                      else: "Retry live results"}
                  </button>
                </div>
              <% else %>
                <p
                  id="recommendations-live"
                  class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-[9px] font-black uppercase tracking-widest text-emerald-700"
                >
                  <.ui_icon name={:check} class="h-3 w-3" /> Live Google ratings loaded
                </p>
              <% end %>

              <section class="mt-7 border-t border-slate-100 pt-5">
                <h2 class="text-lg font-black tracking-tight text-slate-900">
                  Hotel Recommendation
                </h2>

                <p class="mt-2 text-sm font-bold leading-relaxed text-slate-500">
                  {@itinerary.hotel}
                </p>

                <div id="itinerary-hotels" class="mt-6 border-t border-slate-100 pt-5">
                  <div class="flex flex-wrap items-end justify-between gap-2">
                    <div>
                      <h3 class="text-base font-black tracking-tight text-slate-900">
                        Hotels &amp; Stays
                      </h3>

                      <p class="mt-1 text-[10px] font-bold text-slate-400">
                        <%= if @itinerary.hotel_source == :google_maps do %>
                          Top-rated accommodation from Google Maps reviews
                        <% else %>
                          Popular stays — open Google Maps for live ratings and reviews
                        <% end %>
                      </p>
                    </div>
                  </div>

                  <%= if @itinerary.hotels == [] do %>
                    <div
                      id="itinerary-hotels-empty"
                      class="mt-4 rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-4 py-5"
                    >
                      <p class="text-xs font-black text-slate-700">No live stays found yet</p>

                      <p class="mt-1 text-[11px] font-bold leading-relaxed text-slate-500">
                        We couldn't load hotel recommendations for this destination. Try again, or
                        open Google Maps to browse stays directly.
                      </p>

                      <div class="mt-3 flex flex-wrap gap-2">
                        <button
                          type="button"
                          id="retry-hotels"
                          phx-click="retry_recommendations"
                          disabled={@recommendations_retrying}
                          class="rounded-lg bg-slate-900 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-white disabled:opacity-60"
                        >
                          Try again
                        </button>

                        <a
                          href={@itinerary.hotels_search_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="rounded-lg border border-slate-200 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-slate-600"
                        >
                          Open Google Maps
                        </a>
                      </div>
                    </div>
                  <% end %>

                  <div
                    :if={@itinerary.hotels != []}
                    class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-4"
                  >
                    <%= for hotel <- @itinerary.hotels do %>
                      <div class="min-w-0">
                        <img
                          src={hotel.image}
                          alt={hotel.name}
                          loading="lazy"
                          decoding="async"
                          class="h-24 w-full rounded-xl object-cover md:h-28"
                        />
                        <p class="mt-2 line-clamp-2 text-xs font-black leading-snug text-slate-900">
                          {hotel.name}
                        </p>

                        <p class="mt-1 line-clamp-1 text-[9px] font-bold text-slate-400">
                          {hotel.address}
                        </p>

                        <%= if hotel.rating do %>
                          <p
                            class="mt-1 flex items-center gap-1.5 text-[10px] font-bold text-slate-500"
                            aria-label={"Rated #{hotel.rating} out of 5 from #{hotel.reviews} reviews"}
                          >
                            <span class="text-amber-400"><.ui_icon
                              name={:star}
                              class="h-3.5 w-3.5"
                            /></span> <span>{hotel.rating}</span>
                            <span class="text-slate-400">
                              ({hotel.reviews} reviews)
                            </span>
                          </p>
                        <% else %>
                          <p class="mt-1 text-[9px] font-bold text-slate-400">
                            Live ratings on Google Maps
                          </p>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </section>

              <section class="mt-7 border-t border-slate-100 pt-5">
                <h2 class="text-lg font-black tracking-tight text-slate-900">Food</h2>

                <p class="mt-2 text-sm font-bold leading-relaxed text-slate-500">
                  {@itinerary.food}
                </p>

                <div id="itinerary-restaurants" class="mt-6 border-t border-slate-100 pt-5">
                  <div class="flex flex-wrap items-end justify-between gap-2">
                    <div>
                      <h3 class="text-base font-black tracking-tight text-slate-900">
                        Recommended Restaurants
                      </h3>
                    </div>
                  </div>

                  <%= if @itinerary.restaurants == [] do %>
                    <div
                      id="itinerary-restaurants-empty"
                      class="mt-4 rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-4 py-5"
                    >
                      <p class="text-xs font-black text-slate-700">
                        No live restaurants found yet
                      </p>

                      <p class="mt-1 text-[11px] font-bold leading-relaxed text-slate-500">
                        We couldn't load restaurant recommendations for this destination. Try again,
                        or open Google Maps to browse places to eat.
                      </p>

                      <div class="mt-3 flex flex-wrap gap-2">
                        <button
                          type="button"
                          id="retry-restaurants"
                          phx-click="retry_recommendations"
                          disabled={@recommendations_retrying}
                          class="rounded-lg bg-slate-900 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-white disabled:opacity-60"
                        >
                          Try again
                        </button>

                        <a
                          href={@itinerary.restaurants_search_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="rounded-lg border border-slate-200 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-slate-600"
                        >
                          Open Google Maps
                        </a>
                      </div>
                    </div>
                  <% end %>

                  <div
                    :if={@itinerary.restaurants != []}
                    class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-4"
                  >
                    <%= for restaurant <- @itinerary.restaurants do %>
                      <div class="min-w-0">
                        <img
                          src={restaurant.image}
                          alt={restaurant.name}
                          loading="lazy"
                          decoding="async"
                          class="h-24 w-full rounded-xl object-cover md:h-28"
                        />
                        <p class="mt-2 line-clamp-2 text-xs font-black leading-snug text-slate-900">
                          {restaurant.name}
                        </p>

                        <p class="mt-1 line-clamp-1 text-[9px] font-bold text-slate-400">
                          {restaurant.address}
                        </p>

                        <%= if restaurant.rating do %>
                          <p
                            class="mt-1 flex items-center gap-1.5 text-[10px] font-bold text-slate-500"
                            aria-label={"Rated #{restaurant.rating} out of 5 from #{restaurant.reviews} reviews"}
                          >
                            <span class="text-amber-400"><.ui_icon
                              name={:star}
                              class="h-3.5 w-3.5"
                            /></span> <span>{restaurant.rating}</span>
                            <span class="text-slate-400">
                              ({restaurant.reviews} reviews)
                            </span>
                          </p>
                        <% else %>
                          <p class="mt-1 text-[9px] font-bold text-slate-400">
                            Live ratings on Google Maps
                          </p>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </section>

              <section id="itinerary-days" class="mt-7 border-t border-slate-100 pt-5">
                <%= for day <- @itinerary.days do %>
                  <div class="mt-5 first:mt-0">
                    <h3 class="text-base font-black tracking-tight text-slate-900">
                      {day.date}: {day.title}
                    </h3>

                    <dl class="mt-3 space-y-3">
                      <%= for {label, text} <- [
                            {"Morning activity", day.morning},
                            {"Afternoon lunch short description", day.lunch},
                            {"Afternoon activity", day.afternoon},
                            {"Evening activity", day.evening},
                            {"Dinner short description", day.dinner}
                          ] do %>
                        <div>
                          <dt class="text-[10px] font-black uppercase tracking-[0.16em] text-slate-400">
                            {label}
                          </dt>

                          <dd class="mt-1 text-sm font-bold leading-relaxed text-slate-500">
                            {text}
                          </dd>
                        </div>
                      <% end %>
                    </dl>
                  </div>
                <% end %>
              </section>

              <section class="mt-7 border-t border-slate-100 pt-5">
                <h2 class="text-lg font-black tracking-tight text-slate-900">Important Notes</h2>

                <ul class="mt-3 space-y-3">
                  <%= for note <- @itinerary.notes do %>
                    <li>
                      <p class="text-xs font-black text-slate-900">{note.title}:</p>

                      <p class="mt-1 text-sm font-bold leading-relaxed text-slate-500">
                        {note.text}
                      </p>
                    </li>
                  <% end %>
                </ul>
              </section>

              <div class="mt-7 flex flex-col gap-2 border-t border-slate-100 pt-5 sm:flex-row">
                <a
                  id="open-chyllz-ai"
                  href="/tour-packages?assistant=1"
                  class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-[#FF4C00] px-5 py-3 text-[10px] font-black uppercase tracking-widest text-white hover:bg-[#E64400]"
                >
                  <.ui_icon name={:sparkles} class="h-4 w-4" /> Build with Chyllz AI
                </a>

                <a
                  id="browse-chyllz"
                  href="/tour-packages"
                  class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl border border-slate-200 px-5 py-3 text-[10px] font-black uppercase tracking-widest text-slate-700 hover:border-[#FF4C00] hover:text-[#FF4C00]"
                >
                  Browse Chyllz
                </a>

                <button
                  type="button"
                  phx-click="restart"
                  data-confirm={if @dirty, do: "Discard unsaved changes and start over?"}
                  data-track="ai_trip_restart"
                  class="rounded-xl px-4 py-3 text-[10px] font-black uppercase tracking-widest text-slate-400 hover:text-[#FF4C00]"
                >
                  Start over
                </button>
              </div>

              <div id="itinerary-save-bar" class="sticky bottom-4 z-20 mt-8">
                <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-100 bg-white/90 px-4 py-2 shadow-xl backdrop-blur">
                  <div class="flex min-w-0 items-center gap-2">
                    <span class="flex min-w-0 items-center gap-2 text-[11px] font-black text-slate-700">
                      <.ui_icon name={:pin} class="h-4 w-4 shrink-0 text-[#FF4C00]" />
                      <span class="truncate">{@itinerary.city}</span>
                    </span>

                    <%= if @dirty && @save_state != :saving do %>
                      <span class="rounded-full bg-amber-50 px-2 py-1 text-[8px] font-black uppercase tracking-widest text-amber-700">
                        Unsaved changes
                      </span>
                    <% end %>
                  </div>

                  <div class="flex flex-wrap items-center gap-2">
                    <button
                      type="button"
                      id="refine-itinerary"
                      phx-click="refine"
                      data-track="ai_refine_clicked"
                      class="inline-flex items-center gap-1.5 rounded-full border border-orange-200 bg-orange-50 px-3.5 py-2 text-[10px] font-black uppercase tracking-widest text-[#FF4C00] transition hover:bg-orange-100"
                    >
                      <.ui_icon name={:edit} class="h-3.5 w-3.5" /> Refine
                    </button>

                    <%= if @save_state == :saved && !@dirty do %>
                      <a
                        href="/dashboard?tab=chyllz"
                        data-track="ai_itinerary_open_chyllz"
                        class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3.5 py-2 text-[10px] font-black uppercase tracking-widest text-slate-600 transition hover:border-slate-300"
                      >
                        Open My Chyllz
                      </a>
                    <% end %>

                    <button
                      id="save-itinerary"
                      type="button"
                      phx-click="save_itinerary"
                      data-track="ai_itinerary_saved"
                      disabled={@save_state == :saving || (@save_state == :saved && !@dirty)}
                      class={[
                        "inline-flex shrink-0 items-center gap-1.5 rounded-full px-5 py-2 text-[10px] font-black uppercase tracking-widest transition",
                        @save_state == :saving && "cursor-wait bg-slate-300 text-white",
                        @save_state == :saved && !@dirty && "bg-emerald-500 text-white",
                        @save_state == :saved && @dirty &&
                          "bg-[#FF4C00] text-white hover:bg-[#E64400]",
                        @save_state == :error && "bg-red-500 text-white hover:bg-red-600",
                        @save_state == :unsaved && "bg-[#FF4C00] text-white hover:bg-[#E64400]"
                      ]}
                    >
                      <.ui_icon name={:check} class="h-3.5 w-3.5" />
                      <%= cond do %>
                        <% @save_state == :saving -> %>
                          Saving…
                        <% @save_state == :saved && !@dirty -> %>
                          Saved
                        <% !is_nil(@saved_itinerary) && @dirty -> %>
                          Update saved
                        <% @save_state == :error -> %>
                          Retry save
                        <% true -> %>
                          Save itinerary
                      <% end %>
                    </button>
                  </div>
                </div>
              </div>
            </article>

            <aside class="relative h-[420px] border-t border-slate-100 lg:sticky lg:top-0 lg:h-screen lg:self-start lg:border-l lg:border-t-0">
              <div
                id="itinerary-map"
                phx-hook=".ItineraryMap"
                class="relative h-[420px] w-full overflow-hidden bg-[#e8efe6] lg:h-full"
              >
                <iframe
                  id="itinerary-map-frame"
                  src={@itinerary.map_embed_url}
                  title={"Google Map of " <> @itinerary.city}
                  loading="eager"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                  class="absolute inset-0 h-full w-full border-0"
                ></iframe>
                <a
                  href={@itinerary.map_link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="absolute right-3 top-3 rounded-full bg-white/95 px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-[#FF4C00] shadow"
                >
                  Open map
                </a>

                <div class="absolute bottom-3 left-3 right-3 flex flex-wrap items-center justify-between gap-2 rounded-xl bg-white/95 px-3 py-2 shadow">
                  <p id="map-status" class="text-[10px] font-bold text-slate-500">
                    Map not loading? Reload it without leaving the page.
                  </p>

                  <button
                    type="button"
                    id="retry-map"
                    class="shrink-0 rounded-lg bg-[#FF4C00] px-3 py-1.5 text-[9px] font-black uppercase tracking-widest text-white"
                  >
                    Reload map
                  </button>
                </div>
              </div>
            </aside>
          </div>
        <% end %>
      </section>
    </main>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".NetworkStatus">
    export default {
      mounted() {
        this.status = this.querySelector("[data-network-status]")
        this.retry = this.querySelector("[data-network-retry]")

        const setVisible = (visible, message) => {
          this.hidden = !visible
          if (this.status && message) this.status.textContent = message
        }

        this.onOnline = () => setVisible(false)
        this.onOffline = () => setVisible(true, "You're offline. Check your connection and try again.")
        this.onDisconnected = () => setVisible(true, "Connection lost. We'll reconnect automatically — your trip is safe.")
        this.onConnected = () => setVisible(false)

        window.addEventListener("online", this.onOnline)
        window.addEventListener("offline", this.onOffline)
        document.addEventListener("phx:disconnected", this.onDisconnected)
        document.addEventListener("phx:connected", this.onConnected)

        if (!navigator.onLine) this.onOffline()

        this.onClick = (event) => {
          if (!event.target.closest("[data-network-retry]")) return
          if (this.status) this.status.textContent = "Reconnecting…"
          if (window.liveSocket) {
            window.liveSocket.disconnect()
            window.liveSocket.connect()
          } else {
            window.location.reload()
          }
        }
        this.addEventListener("click", this.onClick)
      },
      destroyed() {
        window.removeEventListener("online", this.onOnline)
        window.removeEventListener("offline", this.onOffline)
        document.removeEventListener("phx:disconnected", this.onDisconnected)
        document.removeEventListener("phx:connected", this.onConnected)
        if (this.onClick) this.removeEventListener("click", this.onClick)
      }
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".GenerationSlow">
    export default {
      mounted() {
        this.hidden = true
        this.timer = window.setTimeout(() => {
          this.hidden = false
        }, 12000)
      },
      destroyed() {
        if (this.timer) window.clearTimeout(this.timer)
      }
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".OfflineGuard">
    export default {
      mounted() {
        this.onClick = (event) => {
          if (navigator.onLine) return
          event.preventDefault()
          event.stopImmediatePropagation()
          const banner = document.querySelector("#builder-network-banner")
          if (banner) {
            banner.hidden = false
            banner.scrollIntoView({behavior: "smooth", block: "center"})
          }
        }
        this.el.addEventListener("click", this.onClick, true)
      },
      destroyed() {
        if (this.onClick) this.el.removeEventListener("click", this.onClick, true)
      }
    }
  </script>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".ItineraryMap">
    export default {
      mounted() {
        this.frame = this.querySelector("#itinerary-map-frame")
        this.status = this.querySelector("#map-status")
        this.retry = this.querySelector("#retry-map")
        if (!this.retry) return

        this.onClick = () => {
          if (!this.frame) return
          if (this.status) this.status.textContent = "Reloading map…"
          this.frame.src = this.frame.src
          window.setTimeout(() => {
            if (this.status) this.status.textContent = "Still blank? Open the map in Google Maps."
          }, 4000)
        }
        this.retry.addEventListener("click", this.onClick)
      },
      destroyed() {
        if (this.retry && this.onClick) this.retry.removeEventListener("click", this.onClick)
      }
    }
  </script>
</Layouts.app>
