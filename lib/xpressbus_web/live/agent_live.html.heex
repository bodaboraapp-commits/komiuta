<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-[#f8fafc] font-sans text-slate-900">
    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="/agent" class="flex items-center gap-3">
          <img
            src="/images/logo_brand.png"
            alt="KOMIUTA"
            width="146"
            height="40"
            class="h-9 w-auto"
          /> <span class="hidden h-8 w-px bg-slate-200 sm:block"></span>
          <span class="hidden text-[10px] font-black uppercase tracking-[0.3em] text-[#FF4C00] sm:block">
            Agent App
          </span>
        </a>

        <div class="flex items-center gap-2">
          <a
            href="/agent/login"
            class="rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-700 shadow-sm transition hover:border-[#FF4C00] hover:text-[#FF4C00]"
          >
            Log in
          </a>

          <button
            id="agent-install-button"
            type="button"
            phx-hook=".AgentInstall"
            class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-[10px] font-black uppercase tracking-widest text-slate-700 shadow-sm transition hover:border-[#FF4C00] hover:text-[#FF4C00]"
          >
            <span class="material-symbols-outlined !text-base">download</span> Install app
          </button>
        </div>
      </div>
    </header>

    <main>
      <%= if @submitted do %>
        <section class="mx-auto max-w-3xl px-5 py-16 md:py-24">
          <div class="rounded-[2.5rem] border border-emerald-100 bg-white p-8 text-center shadow-xl shadow-emerald-900/5 md:p-12">
            <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-[2rem] bg-emerald-50 text-emerald-600">
              <span class="material-symbols-outlined !text-5xl">check_circle</span>
            </div>

            <p class="mt-6 text-[10px] font-black uppercase tracking-[0.3em] text-[#FF4C00]">
              Application received
            </p>

            <h1 class="mt-3 text-3xl font-black tracking-tight md:text-4xl">
              Thanks, {@submitted.full_name |> String.split() |> List.first()}!
            </h1>

            <p class="mx-auto mt-4 max-w-xl text-sm font-bold leading-relaxed text-slate-500">
              Our partnerships team will review your application and contact you on
              <strong>{@submitted.phone}</strong>
              or <strong>{@submitted.email}</strong>.
            </p>

            <div class="mx-auto mt-8 max-w-sm rounded-2xl border border-slate-100 bg-slate-50 p-5">
              <p class="text-[9px] font-black uppercase tracking-[0.25em] text-slate-400">
                Your reference
              </p>

              <p class="mt-2 text-2xl font-black tracking-wide text-slate-900">
                {@submitted.reference}
              </p>

              <p class="mt-1 text-[11px] font-bold text-slate-400">
                Keep this reference for follow-up.
              </p>

              <p class="mt-3 text-[11px] font-bold text-slate-500">
                {@submitted.business_name} · {@submitted.city}
              </p>
            </div>

            <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
              <button
                type="button"
                phx-click="new_application"
                class="rounded-xl bg-slate-900 px-6 py-3 text-[10px] font-black uppercase tracking-widest text-white transition hover:bg-black"
              >
                Submit another application
              </button>

              <a
                href="/agent/login"
                class="rounded-xl border border-slate-200 px-6 py-3 text-[10px] font-black uppercase tracking-widest text-slate-600 transition hover:border-slate-300"
              >
                Log in to track status
              </a>
            </div>
          </div>

          <div class="mt-6 flex flex-col items-center gap-2 text-center">
            <p class="text-xs font-bold text-slate-400">
              Install the Agent app to get updates and manage your account.
            </p>

            <div class="rounded-2xl bg-white p-3 shadow-sm ring-1 ring-slate-100">
              <%= if @agent_qr do %>
                {@agent_qr}
              <% end %>
            </div>
          </div>
        </section>
      <% else %>
        <section class="relative overflow-hidden bg-gradient-to-br from-[#0f172a] via-[#1e293b] to-[#0f172a] px-5 pb-16 pt-12 text-white md:pb-24 md:pt-16">
          <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-[#FF4C00]/20 blur-3xl">
          </div>

          <div class="relative mx-auto grid max-w-6xl items-start gap-10 lg:grid-cols-[0.9fr_1.1fr]">
            <div class="pt-4">
              <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-[10px] font-black uppercase tracking-[0.25em] text-orange-300">
                <span class="material-symbols-outlined !text-base">handshake</span> KOMIUTA Agent
              </div>

              <h1 class="mt-5 text-4xl font-black leading-[1.05] tracking-tighter md:text-5xl">
                Sell more tickets.<br /> <span class="text-[#FF4C00]">Grow with KOMIUTA.</span>
              </h1>

              <p class="mt-5 max-w-md text-sm font-bold leading-relaxed text-slate-300">
                Join the KOMIUTA Agent network. Sign up to sell intercity bus tickets, manage
                bookings and serve travellers from one dedicated app.
              </p>

              <div class="mt-7 space-y-4">
                <%= for {icon, text} <- [
                  {"verified", "Get access to live routes and fares"},
                  {"payments", "Track your bookings and payouts"},
                  {"support_agent", "Dedicated support for approved agents"}
                ] do %>
                  <div class="flex items-center gap-3 text-sm font-bold text-slate-200">
                    <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-white/10 text-orange-300">
                      <span class="material-symbols-outlined !text-base">{icon}</span>
                    </span>
                    {text}
                  </div>
                <% end %>
              </div>

              <div class="mt-8 rounded-2xl border border-white/10 bg-white/5 p-4">
                <p class="text-[9px] font-black uppercase tracking-[0.25em] text-slate-400">
                  Scan to open on your phone
                </p>

                <div class="mt-3 w-fit rounded-xl bg-white p-2">
                  <%= if @agent_qr do %>
                    {@agent_qr}
                  <% else %>
                    <span class="material-symbols-outlined !text-5xl text-slate-300">qr_code_2</span>
                  <% end %>
                </div>
              </div>
            </div>

            <div class="rounded-[2rem] bg-white p-5 text-slate-900 shadow-2xl md:p-7">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h2 class="text-xl font-black tracking-tight">Create your agent account</h2>

                  <p class="mt-1 text-[11px] font-bold text-slate-400">
                    Tell us about you and your business. Takes about 2 minutes.
                  </p>
                </div>

                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-orange-50 text-[#FF4C00]">
                  <span class="material-symbols-outlined !text-xl">badge</span>
                </span>
              </div>

              <.form
                for={@form}
                id="agent-application-form"
                phx-change="validate"
                phx-submit="submit"
                class="mt-6 space-y-4"
              >
                <div class="grid gap-4 sm:grid-cols-2">
                  <.input
                    field={@form[:full_name]}
                    label="Full name"
                    type="text"
                    autocomplete="name"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-sm font-bold outline-none transition focus:border-[#FF4C00] focus:bg-white"
                  />
                  <.input
                    field={@form[:business_name]}
                    label="Business / agency name"
                    type="text"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-sm font-bold outline-none transition focus:border-[#FF4C00] focus:bg-white"
                  />
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                  <.input
                    field={@form[:email]}
                    label="Email address"
                    type="email"
                    autocomplete="email"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-sm font-bold outline-none transition focus:border-[#FF4C00] focus:bg-white"
                  />
                  <.input
                    field={@form[:phone]}
                    label="Phone number"
                    type="tel"
                    autocomplete="tel"
                    placeholder="07XX XXX XXX"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-sm font-bold outline-none transition focus:border-[#FF4C00] focus:bg-white"
                  />
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                  <.input
                    field={@form[:city]}
                    label="Town / county"
                    type="text"
                    placeholder="e.g. Nairobi"
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-sm font-bold outline-none transition focus:border-[#FF4C00] focus:bg-white"
                  />
                  <.input
                    field={@form[:payout_method]}
                    label="Payout preference"
                    type="select"
                    options={[{"M-PESA", "mpesa"}, {"Bank transfer", "bank"}, {"Card", "card"}]}
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-sm font-bold outline-none transition focus:border-[#FF4C00] focus:bg-white"
                  />
                </div>

                <%= if @bus_operator_options != [] do %>
                  <.input
                    field={@form[:bus_operator_id]}
                    label="Bus operator / partner you represent"
                    type="select"
                    prompt="Select a bus operator"
                    options={@bus_operator_options}
                    required
                    class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-sm font-bold outline-none transition focus:border-[#FF4C00] focus:bg-white"
                  />
                <% else %>
                  <p class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-3 text-[10px] font-bold leading-relaxed text-slate-400">
                    The bus operator list is being set up. Submit your application and our team will
                    assign you to the right partner.
                  </p>
                <% end %>

                <.input
                  field={@form[:routes]}
                  label="Routes or region you mainly serve (optional)"
                  type="text"
                  placeholder="e.g. Nairobi - Mombasa"
                  class="w-full rounded-xl border border-slate-200 bg-slate-50 p-3.5 text-sm font-bold outline-none transition focus:border-[#FF4C00] focus:bg-white"
                />
                <button
                  type="submit"
                  class="w-full rounded-xl bg-[#FF4C00] px-6 py-4 text-xs font-black uppercase tracking-[0.2em] text-white shadow-xl shadow-orange-200 transition hover:bg-[#E64400] active:scale-[0.99]"
                >
                  Submit Agent Application
                </button>

                <p class="text-center text-[10px] font-bold leading-relaxed text-slate-400">
                  By applying you agree to be contacted by KOMIUTA about your agent account.
                  Approval is subject to verification.
                </p>

                <p class="text-center text-[11px] font-bold text-slate-400">
                  Already an agent?
                  <a href="/agent/login" class="font-black text-[#FF4C00] hover:underline">Log in</a>
                </p>
              </.form>
            </div>
          </div>
        </section>

        <section class="px-5 py-14 md:py-20">
          <div class="mx-auto max-w-6xl">
            <div class="grid gap-5 md:grid-cols-3">
              <%= for {icon, title, copy} <- [
                {"looks_one", "Apply online", "Complete the short application above from your phone or computer."},
                {"verified", "Get verified", "Our team reviews your details and confirms your business."},
                {"rocket_launch", "Start selling", "Get approved, install the app and start serving travellers."}
              ] do %>
                <div class="rounded-[1.5rem] border border-slate-100 bg-white p-6 shadow-sm">
                  <span class="material-symbols-outlined !text-2xl text-[#FF4C00]">{icon}</span>
                  <h3 class="mt-4 text-sm font-black">{title}</h3>

                  <p class="mt-2 text-xs font-bold leading-relaxed text-slate-500">{copy}</p>
                </div>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>
    </main>

    <footer class="border-t border-slate-100 bg-white px-5 py-6">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 text-center text-[10px] font-black uppercase tracking-widest text-slate-400 sm:flex-row sm:text-left">
        <p>© {DateTime.utc_now().year} KOMIUTA Agent</p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href="mailto:hello@komiuta.com" class="transition hover:text-[#FF4C00]">Support</a>
          <a href="/" class="transition hover:text-[#FF4C00]">KOMIUTA.com</a>
          <span class="text-slate-300">Agent app</span>
        </div>
      </div>
    </footer>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".AgentInstall">
      export default {
        mounted() {
          this.hintId = "agent-install-hint"

          this.el.addEventListener("click", async () => {
            const prompt = window.__komiutaInstallPrompt

            if (prompt) {
              prompt.prompt()
              try {
                await prompt.userChoice
              } catch (_error) {}
              window.__komiutaInstallPrompt = null
              return
            }

            if (/iphone|ipad|ipod/i.test(window.navigator.userAgent)) {
              this.showHint()
              return
            }

            const help = document.getElementById("agent-install-help")
            if (help) help.scrollIntoView({behavior: "smooth", block: "center"})
          })
        },

        showHint() {
          const existing = document.getElementById(this.hintId)
          if (existing) {
            existing.hidden = false
            return
          }

          const hint = document.createElement("div")
          hint.id = this.hintId
          hint.className = "fixed left-1/2 bottom-6 z-[100] w-[calc(100%-2rem)] max-w-md -translate-x-1/2 rounded-2xl bg-slate-900 px-5 py-4 text-white shadow-2xl cursor-pointer"
          hint.innerHTML = '<p class="text-[10px] font-black uppercase tracking-widest text-orange-400 mb-1">Install KOMIUTA Agent</p><p class="text-sm font-bold leading-snug">Tap the browser Share button, then choose <span class="text-[#FF4C00]">Add to Home Screen</span>.</p>'
          hint.addEventListener("click", () => hint.remove())
          document.body.appendChild(hint)
          setTimeout(() => hint.remove(), 9000)
        }
      }
    </script>
  </div>
</Layouts.app>
