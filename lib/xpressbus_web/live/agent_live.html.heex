<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-[#f8fafc] font-sans">
    <.main_header step={:agent} current_user={@current_user} />

    <main>
      <section class="relative overflow-hidden bg-gradient-to-br from-[#0f172a] via-[#1e293b] to-[#0f172a] px-6 pb-20 pt-16 text-white md:pt-24">
        <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-[#FF4C00]/20 blur-3xl">
        </div>
        <div class="absolute -bottom-32 -left-24 h-80 w-80 rounded-full bg-orange-400/10 blur-3xl">
        </div>

        <div class="relative mx-auto grid max-w-[1350px] items-center gap-12 lg:grid-cols-2">
          <div>
            <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-[10px] font-black uppercase tracking-[0.25em] text-orange-300">
              <span class="material-symbols-outlined !text-base">verified</span> Komiuta Agent PWA
            </div>

            <h1 class="text-4xl font-black leading-tight tracking-tighter md:text-6xl">
              The Agent app.<br />
              <span class="text-[#FF4C00]">Built for the road.</span>
            </h1>

            <p class="mt-6 max-w-xl text-sm font-bold leading-relaxed text-slate-300 md:text-base">
              Install the Komiuta Agent app on your phone or desktop. Serve travellers, keep bookings
              moving and stay connected to the Komiuta network — without an app store.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-4">
              <button
                id="agent-install-button"
                type="button"
                phx-hook=".AgentInstall"
                class="inline-flex items-center gap-3 rounded-2xl bg-[#FF4C00] px-7 py-4 text-sm font-black uppercase tracking-widest text-white shadow-xl shadow-orange-900/30 transition hover:bg-[#E64400] active:scale-95"
              >
                <span class="material-symbols-outlined">download</span> Install Agent App
              </button>
              <a
                href="#agent-install-help"
                class="inline-flex items-center gap-2 rounded-2xl border border-white/15 bg-white/5 px-6 py-4 text-xs font-black uppercase tracking-widest text-slate-200 transition hover:border-white/30 hover:bg-white/10"
              >
                How to install
              </a>
            </div>

            <p
              id="agent-install-status"
              class="mt-4 min-h-[18px] text-xs font-bold text-slate-400"
            >
            </p>

            <p class="mt-4 text-[11px] font-bold text-slate-500">
              Works on Android, iPhone, iPad and desktop Chrome / Edge.
            </p>
          </div>

          <div class="relative mx-auto w-full max-w-md">
            <div class="rounded-[2.5rem] border border-white/10 bg-white/5 p-6 shadow-2xl backdrop-blur">
              <div class="rounded-[2rem] bg-white p-6 text-slate-900 shadow-2xl">
                <div class="flex items-center gap-4">
                  <img
                    src="/images/icon-192.png"
                    alt="Komiuta Agent"
                    width="64"
                    height="64"
                    class="h-16 w-16 rounded-2xl shadow-lg"
                  />
                  <div>
                    <p class="text-lg font-black leading-none">Komiuta Agent</p>
                    <p class="mt-1 text-[10px] font-bold uppercase tracking-widest text-slate-400">
                      Agent PWA · installable
                    </p>
                  </div>
                </div>

                <div class="my-6 h-px bg-slate-100"></div>

                <div class="flex items-center justify-center rounded-2xl border border-slate-100 bg-slate-50 p-4">
                  <%= if @agent_qr do %>
                    {@agent_qr}
                  <% else %>
                    <span class="material-symbols-outlined !text-6xl text-slate-300">qr_code_2</span>
                  <% end %>
                </div>

                <p class="mt-4 text-center text-[10px] font-bold leading-relaxed text-slate-400">
                  Scan with your phone camera to open the Agent app page.
                </p>
              </div>

              <div class="mt-4 flex items-center justify-center gap-2 text-[10px] font-black uppercase tracking-widest text-slate-400">
                <span class="material-symbols-outlined !text-sm text-emerald-400">lock</span>
                Secure install · no app store needed
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="px-6 py-16 md:py-20">
        <div class="mx-auto max-w-[1350px]">
          <div class="grid gap-6 md:grid-cols-3">
            <%= for {icon, title, copy} <- [
              {"confirmation_number", "Sell with confidence", "Create and manage bus ticket bookings for travellers from one focused workspace."},
              {"groups", "Serve travellers", "Keep passenger details, routes and trip information close at hand while you're on the move."},
              {"payments", "Stay on top of payouts", "Track your agent activity and stay connected to Komiuta support when you need it."}
            ] do %>
              <div class="rounded-[2rem] border border-slate-100 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-50 text-[#FF4C00]">
                  <span class="material-symbols-outlined !text-2xl">{icon}</span>
                </div>
                <h2 class="mt-5 text-base font-black text-slate-900">{title}</h2>
                <p class="mt-2 text-xs font-bold leading-relaxed text-slate-500">{copy}</p>
              </div>
            <% end %>
          </div>
        </div>
      </section>

      <section
        id="agent-install-help"
        class="scroll-mt-24 border-t border-slate-100 bg-white px-6 py-16 md:py-20"
      >
        <div class="mx-auto max-w-[1000px]">
          <div class="text-center">
            <p class="text-[10px] font-black uppercase tracking-[0.3em] text-[#FF4C00]">
              Install in under a minute
            </p>
            <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-900 md:text-4xl">
              Add Komiuta Agent to your home screen
            </h2>
            <p class="mx-auto mt-3 max-w-2xl text-sm font-bold leading-relaxed text-slate-500">
              The Agent app is a Progressive Web App. Use your browser's install option and it will
              open like a native app, with its own icon on your device.
            </p>
          </div>

          <div class="mt-10 grid gap-5 md:grid-cols-3">
            <div class="rounded-[1.75rem] border border-slate-100 bg-slate-50/70 p-6">
              <span class="material-symbols-outlined !text-2xl text-[#FF4C00]">android</span>
              <h3 class="mt-4 text-sm font-black text-slate-900">Android</h3>
              <p class="mt-2 text-xs font-bold leading-relaxed text-slate-500">
                Tap <strong>Install Agent App</strong>, or open Chrome's menu and choose <strong>Install app / Add to Home screen</strong>.
              </p>
            </div>

            <div class="rounded-[1.75rem] border border-slate-100 bg-slate-50/70 p-6">
              <span class="material-symbols-outlined !text-2xl text-[#FF4C00]">phone_iphone</span>
              <h3 class="mt-4 text-sm font-black text-slate-900">iPhone / iPad</h3>
              <p class="mt-2 text-xs font-bold leading-relaxed text-slate-500">
                Open this page in <strong>Safari</strong>, tap the <strong>Share</strong> button,
                then choose <strong>Add to Home Screen</strong>.
              </p>
            </div>

            <div class="rounded-[1.75rem] border border-slate-100 bg-slate-50/70 p-6">
              <span class="material-symbols-outlined !text-2xl text-[#FF4C00]">computer</span>
              <h3 class="mt-4 text-sm font-black text-slate-900">Desktop</h3>
              <p class="mt-2 text-xs font-bold leading-relaxed text-slate-500">
                In Chrome or Edge, use the install icon in the address bar, or choose
                <strong>Install Komiuta Agent</strong>
                from the browser menu.
              </p>
            </div>
          </div>

          <div class="mt-8 rounded-[1.75rem] border border-orange-100 bg-orange-50 p-6 text-center">
            <p class="text-xs font-bold text-slate-700">
              Already an approved Komiuta agent?
              <a href="/user/login" class="font-black text-[#FF4C00] hover:underline">Sign in here</a>
              to continue. Need agent access? <a
                href={"mailto:" <> Xpressbus.Brand.email()}
                class="font-black text-[#FF4C00] hover:underline"
              >
                Contact Komiuta
              </a>.
            </p>
          </div>
        </div>
      </section>
    </main>

    <.main_footer footer_tab={@footer_tab} />

    <script :type={Phoenix.LiveView.ColocatedHook} name=".AgentInstall">
      export default {
        mounted() {
          this.hintId = "agent-install-hint"

          this.el.addEventListener("click", async () => {
            const prompt = window.__komiutaInstallPrompt

            if (prompt) {
              prompt.prompt()
              try {
                await prompt.userChoice
              } catch (_error) {}
              window.__komiutaInstallPrompt = null
              this.setStatus("Install prompt opened.")
              return
            }

            if (/iphone|ipad|ipod/i.test(window.navigator.userAgent)) {
              this.showHint()
              return
            }

            document.getElementById("agent-install-help")?.scrollIntoView({behavior: "smooth", block: "center"})
            this.setStatus("Choose your browser's Install option — see the steps below.")
          })
        },

        setStatus(message) {
          const el = document.getElementById("agent-install-status")
          if (el) el.textContent = message
        },

        showHint() {
          const existing = document.getElementById(this.hintId)
          if (existing) {
            existing.hidden = false
            return
          }

          const hint = document.createElement("div")
          hint.id = this.hintId
          hint.className = "fixed left-1/2 bottom-6 z-[100] w-[calc(100%-2rem)] max-w-md -translate-x-1/2 rounded-2xl bg-slate-900 px-5 py-4 text-white shadow-2xl cursor-pointer"
          hint.innerHTML = '<p class="text-[10px] font-black uppercase tracking-widest text-orange-400 mb-1">Install Komiuta Agent</p><p class="text-sm font-bold leading-snug">Tap the browser Share button, then choose <span class="text-[#FF4C00]">Add to Home Screen</span>.</p>'
          hint.addEventListener("click", () => hint.remove())
          document.body.appendChild(hint)
          setTimeout(() => hint.remove(), 9000)
        }
      }
    </script>
  </div>
</Layouts.app>
