<Layouts.app flash={@flash}>
  <div class="min-h-screen bg-slate-50 text-slate-900">
    <.main_header step={@step} current_user={@current_user} />

    <main class="pt-[72px] md:pt-[80px]">
      <section class="bg-slate-950 text-white pt-12 pb-14 px-6">
        <div class="max-w-[1100px] mx-auto">
          <nav
            class="mb-5 flex flex-wrap items-center gap-2 text-[10px] font-black uppercase tracking-widest text-slate-500"
            aria-label="Breadcrumb"
          >
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span>/</span>
            <%= if @operator do %>
              <a href="/operators" class="hover:text-white transition-colors">Operators</a>
              <span>/</span>
              <span class="text-slate-300">{@operator.name}</span>
            <% else %>
              <span class="text-slate-300">Bus operators</span>
            <% end %>
          </nav>

          <%= if @operator do %>
            <p class="mb-3 text-[10px] font-black uppercase tracking-[0.4em] text-[#FF4C00]">
              Bus operator
            </p>
            <h1 class="text-4xl md:text-6xl font-black tracking-tighter leading-none mb-4">
              {@operator.name} bus tickets
            </h1>
            <p class="max-w-3xl text-sm md:text-base font-bold leading-relaxed text-slate-400">
              Book {@operator.name} bus tickets on Komiuta. Compare routes, departure times and live fares, choose your seat and pay with M-PESA or card. Tickets arrive instantly by SMS and email.
            </p>
          <% else %>
            <p class="mb-3 text-[10px] font-black uppercase tracking-[0.4em] text-[#FF4C00]">
              Operators
            </p>
            <h1 class="text-4xl md:text-6xl font-black tracking-tighter leading-none mb-4">
              Bus operators in Kenya
            </h1>
            <p class="max-w-2xl text-sm md:text-base font-bold leading-relaxed text-slate-400">
              Compare the bus companies operating on Komiuta — routes, fares and live seat availability across Kenya and East Africa.
            </p>
          <% end %>
        </div>
      </section>

      <%= if @operator do %>
        <section class="px-6 py-10 md:py-14">
          <div class="max-w-[1100px] mx-auto">
            <div class="mb-8 grid gap-3 sm:grid-cols-3">
              <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                <div class="mb-1 text-[9px] font-black uppercase tracking-widest text-slate-400">
                  Routes
                </div>
                <div class="text-2xl font-black text-[#FF4C00]">{length(@routes)}</div>
              </div>
              <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                <div class="mb-1 text-[9px] font-black uppercase tracking-widest text-slate-400">
                  Cities served
                </div>
                <div class="text-2xl font-black text-[#FF4C00]">{length(@cities)}</div>
              </div>
              <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                <div class="mb-1 text-[9px] font-black uppercase tracking-widest text-slate-400">
                  Payment
                </div>
                <div class="text-sm font-black text-slate-900">M-PESA · Card · Mobile money</div>
              </div>
            </div>

            <div class="rounded-[2rem] border border-slate-100 bg-white p-6 md:p-9 shadow-sm">
              <h2 class="text-xl md:text-2xl font-black tracking-tight mb-1">
                Routes operated by {@operator.name}
              </h2>
              <p class="mb-5 text-[11px] font-bold text-slate-400">
                Live schedules and fares are shown when you search.
              </p>

              <%= if @routes == [] do %>
                <div class="rounded-2xl bg-slate-50 p-6 text-center">
                  <p class="text-sm font-bold text-slate-500">
                    We're updating schedules for {@operator.name}. Search your route to see live buses.
                  </p>
                  <a
                    href="/"
                    class="mt-3 inline-flex rounded-full bg-[#FF4C00] px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-white"
                  >Search buses</a>
                </div>
              <% else %>
                <div class="hidden md:block overflow-hidden rounded-xl border border-slate-100">
                  <table class="w-full text-left">
                    <thead class="bg-slate-50">
                      <tr class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                        <th class="px-4 py-3">Route</th>
                        <th class="px-4 py-3">Departures</th>
                        <th class="px-4 py-3">Fare from</th>
                        <th class="px-4 py-3">Rating</th>
                        <th class="px-4 py-3"></th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                      <%= for route <- @routes do %>
                        <tr class="text-xs font-bold text-slate-600">
                          <td class="px-4 py-3 text-sm font-black text-slate-900">
                            {route.from} → {route.to}
                          </td>
                          <td class="px-4 py-3">{route.count} scheduled</td>
                          <td class="px-4 py-3 font-black text-[#FF4C00]">
                            {if route.min_price, do: "KES #{route.min_price}", else: "Check live"}
                          </td>
                          <td class="px-4 py-3">★ {route.rating || "—"}</td>
                          <td class="px-4 py-3 text-right">
                            <a
                              href={XpressbusWeb.SEO.route_path(route.from, route.to)}
                              class="inline-flex rounded-full bg-[#FF4C00] px-4 py-2 text-[9px] font-black uppercase tracking-widest text-white transition-colors hover:bg-[#E64400]"
                            >Book</a>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>

                <div class="grid gap-2 md:hidden">
                  <%= for route <- @routes do %>
                    <a
                      href={XpressbusWeb.SEO.route_path(route.from, route.to)}
                      class="flex items-center justify-between gap-3 rounded-xl border border-slate-100 bg-slate-50/50 p-3"
                    >
                      <div>
                        <div class="text-sm font-black text-slate-900">
                          {route.from} → {route.to}
                        </div>
                        <div class="text-[10px] font-bold text-slate-400">
                          {route.count} scheduled · ★ {route.rating || "—"}
                        </div>
                      </div>
                      <div class="text-right">
                        <div class="text-xs font-black text-[#FF4C00]">
                          {if route.min_price, do: "KES #{route.min_price}", else: "Live"}
                        </div>
                        <div class="text-[9px] font-black uppercase tracking-widest text-slate-400">
                          Book
                        </div>
                      </div>
                    </a>
                  <% end %>
                </div>
              <% end %>
            </div>

            <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_320px] items-start">
              <div class="rounded-[2rem] border border-slate-100 bg-white p-6 md:p-9 shadow-sm">
                <h2 class="mb-3 text-xl md:text-2xl font-black tracking-tight">
                  Cities served by {@operator.name}
                </h2>
                <div class="flex flex-wrap gap-2">
                  <%= for city <- @cities do %>
                    <a
                      href={"/cities/" <> String.downcase(city)}
                      class="rounded-full border border-slate-100 bg-slate-50 px-3 py-1.5 text-[10px] font-black text-slate-700 transition-colors hover:border-[#FF4C00]/40 hover:text-[#FF4C00]"
                    >{city}</a>
                  <% end %>
                </div>
              </div>

              <aside class="space-y-4">
                <a
                  href="/"
                  class="block rounded-2xl bg-[#FF4C00] p-5 text-center text-[11px] font-black uppercase tracking-widest text-white shadow-lg shadow-orange-200 transition-colors hover:bg-[#E64400]"
                >Search buses</a>
                <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
                  <h2 class="mb-3 text-[10px] font-black uppercase tracking-widest text-slate-400">
                    Popular routes
                  </h2>
                  <div class="grid grid-cols-1 gap-1.5">
                    <%= for {from, to} <- [{"Nairobi", "Kisumu"}, {"Nairobi", "Mombasa"}, {"Mombasa", "Nairobi"}, {"Nairobi", "Eldoret"}] do %>
                      <a
                        href={XpressbusWeb.SEO.route_path(from, to)}
                        class="flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 text-[11px] font-black text-slate-700 transition-colors hover:bg-slate-50 hover:text-[#FF4C00]"
                      >
                        <span>{from} → {to}</span>
                        <span class="material-symbols-outlined !text-sm text-slate-300">arrow_forward</span>
                      </a>
                    <% end %>
                  </div>
                </div>
              </aside>
            </div>
          </div>
        </section>
      <% else %>
        <section class="px-6 py-10 md:py-14">
          <div class="max-w-[1100px] mx-auto">
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              <%= for operator <- @operators do %>
                <a
                  href={"/operators/" <> XpressbusWeb.Operators.slug(operator.name)}
                  class="group rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-[#FF4C00]/40 hover:shadow-xl hover:shadow-slate-200/60"
                >
                  <div class="mb-2 flex items-center justify-between gap-2">
                    <h2 class="text-sm font-black text-slate-900 group-hover:text-[#FF4C00]">
                      {operator.name}
                    </h2>
                    <span class="material-symbols-outlined !text-base text-slate-300">arrow_forward</span>
                  </div>
                  <p class="text-[10px] font-bold text-slate-400">
                    {operator.buses} scheduled departures
                  </p>
                </a>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>

      <.main_footer footer_tab={@footer_tab} />
    </main>
  </div>
</Layouts.app>
